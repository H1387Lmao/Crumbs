import std.io;
import std.rand;

enum BlockType {
  EMPTY,
  BOX,
  GOAL,
  WALL,
  LOCKED
}

struct Player {
  x: i8,
  y: i8
}

impl Player {
  fn cascade(self, level: *Level, nx: i8, ny: i8) -> BlockType {
    let dx = nx - self.x;
    let dy = ny - self.y;
    let block = (*level).get_block(nx as u8, ny as u8);
    match block {
      BlockType.WALL => {
        return block;
      }
      BlockType.LOCKED => {
        return BlockType.WALL;
      }
      BlockType.BOX => {
        let res = self.cascade(level, nx + dx, ny + dy);
        if res == BlockType.WALL {
          return block;
        }
        (*level).set_block(nx as u8, ny as u8, BlockType.EMPTY);
        if res == BlockType.GOAL {
          (*level).set_block((nx + dx) as u8, (ny + dy) as u8, BlockType.LOCKED);
          (*level).goal_count--;
        } else {
          (*level).set_block((nx + dx) as u8, (ny + dy) as u8, BlockType.BOX);
        }
        return block;
      }
      _ => {
        return block;
      }
    }
  }

  fn move(mut self, level: *Level, dx: i8, dy: i8) {
    let nx = self.x + dx;
    let ny = self.y + dy;
    if (*level).get_block(nx as u8, ny as u8) != BlockType.EMPTY {
      if self.cascade(level, nx, ny) == BlockType.WALL {
        return;
      }
    }
    self.x += dx;
    self.y += dy;
  }
}

struct Level {
  level: [160]BlockType,
  player: Player,
  goal_count: u8,
  seed: u64,
  random: rand.Rng
}

impl Level {
  fn get_block(self, x: u8, y: u8) -> BlockType {
    return self.level[15 * y + x];
  }

  fn set_block(mut self, x: u8, y: u8, block: BlockType) {
    self.level[15 * y + x] = block;
  }

  fn display_board(self) {
    for y in 0..10 {
      for x in 0..15 {
        if self.player.x == x as i8 && self.player.y == y as i8 {
          print(" ☃︎ ");
          continue;
        }
        match self.get_block(x as u8, y as u8) {
          BlockType.EMPTY => {
            print("   ");
          }
          BlockType.WALL => {
            print(" # ");
          }
          BlockType.BOX => {
            print(" ☐ ");
          }
          BlockType.GOAL => {
            print(" • ");
          }
          BlockType.LOCKED => {
            print(" X ");
          }
        }
      }
      print("\n");
    }
  }

  fn generate_random_level(mut self) {
    // clear board
    for y in 0..10{
      for x in 0..15{
        if x == 0 || x == 14{
          self.level[y*15+x]=BlockType.WALL;
          continue;
        }else if y == 0 || y == 9{
          self.level[y*15+x]=BlockType.WALL;
          continue;
        }
        self.level[y*15+x]=BlockType.EMPTY;
      }
    }

    self.random = rand.Rng.new();
    let mut box_count: u8 = self.random.between(1, 3) as u8;

    self.goal_count = box_count;

    let mut done: u8 = 0;

    while done!=box_count {
      let x = self.random.between(2, 13) as u8;
      let y = self.random.between(2, 7) as u8;
      let goal_x = self.random.between(2, 13) as u8;
      let goal_y = self.random.between(2, 7) as u8;

      if self.get_block(x, y) == BlockType.EMPTY &&
         self.get_block(goal_x, goal_y) == BlockType.EMPTY {
        self.set_block(x, y, BlockType.BOX);
        self.set_block(goal_x, goal_y, BlockType.GOAL);
        done++;
      }
    }
  }
}

fn print_prompt(level: *Level){
  print("Level: ", level.seed+1, " (wasdqr) ");
}

fn main() -> void {
  let mut level = alloc(Level, 1)[0];
  level.seed = 0;
  
  reset(&level);

  level.display_board(); // needed for overwriting board later
  loop {
    print("\r\x1b[10A\r");
    if level.goal_count==0{
      level.seed++;
      reset(&level);
    }
    level.display_board();
    print_prompt(&level);
    let line = io.get_line() catch |e| {
      continue;
    };

    print("\x1b[1A\r");
    
    if (line.len==0){ continue; }

    print_prompt(&level);
    for _ in 0..line.len{
      print(" ");
    }

    let c: u8 = line.lower()[line.len-1];
    match c {
      'w' => {
        level.player.move(&level, 0, -1);
      }
      's' => {
        level.player.move(&level, 0, 1);
      }
      'a' => {
        level.player.move(&level, -1, 0);
      }
      'd' => {
        level.player.move(&level, 1, 0);
      }
      'q' => {
        break;
      }
      'r' => {
        reset(&level);
      }
      _ => {
        continue;
      }
    }
  }
  println();
}

fn reset(level: *Level) {
  (*level).player.x = 2;
  (*level).player.y = 4;
  (*level).generate_random_level();
}
