import std.math;
import std.conv;
import std.str as strs;
import std.rand;

struct Vec3 { x: f64, y: f64, z: f64 }
struct Grid { cells: [4]i32, name: str }

enum Op { Add, Sub, Mul }

error Negative;

fn apply(op: Op, a: i32, b: i32) -> i32 {
    match op {
        Op.Add => { return a + b; }
        Op.Sub => { return a - b; }
        Op.Mul => { return a * b; }
    }
}

fn checked_sqrt(x: f64) -> f64! {
    if x < 0.0 { throw Negative; }
    return math.sqrt(x);
}

fn sum_slice(s: []i32) -> i32 {
    let mut t = 0;
    for v in s { t += v; }
    return t;
}

fn bump(p: *i32) { *p += 1; }

fn parse_and_double(s: str) -> i64! {
    let v = try conv.parse_i64(s);
    return v * 2;
}

fn main() -> i32! {
    let v = Vec3 { x: 1.0, y: 2.0, z: 2.0 };
    println("len = ", math.sqrt(v.x * v.x + v.y * v.y + v.z * v.z));
    println("pi = ", math.PI);

    println(apply(Op.Add, 2, 3), " ", apply(Op.Mul, 4, 5));

    // slices and arrays
    let mut a = [1, 2, 3, 4, 5, 6];
    a[2] = 30;
    let s = a[1..4];
    println("slice sum = ", sum_slice(s), " len=", s.len);
    let mut g = Grid { cells: [0; 4], name: "grid" };
    g.cells[3] = 9;
    println(g.name, " ", g.cells[3]);

    // heap
    let buf = alloc(i64, 5);
    for i in 0..buf.len { buf[i] = i * i; }
    println("buf[4] = ", buf[4]);
    free(buf);

    // pointers
    let mut n = 41;
    bump(&n);
    println("n = ", n);

    // strings
    let text = "hello, world";
    println(strs.starts_with(text, "hello"), " ", strs.find(text, "world"), " ", strs.count_byte(text, 'o'));
    println(text[7..]);

    // errors
    println(checked_sqrt(16.0) catch 0.0);
    println(checked_sqrt(-1.0) catch -1.0);
    let r = parse_and_double("21") catch |e| { println("failed: ", e); throw e; };
    println("parsed ", r);
    let bad = parse_and_double("2x1") catch 0;
    println(bad);

    // rng
    let mut rng = rand.new(42);
    let k = rand.below(&rng, 100);
    println("rng ok: ", k < 100);

    // bit ops & wrapping
    let h: u32 = 2166136261;
    let h2 = (h ^ 97) * 16777619;
    println("hash ", h2, " ", 1u8 << 7, " ", 255u8 + 1);
    return 0;
}
