import std.map;

fn main() {
    let n: i64 = 1000000;
    let mut m: map.HashMap<i64> = map.HashMap.new();
    for i in 0..n { m.set(format("key{}", i), i); }
    let mut sum: i64 = 0;
    for i in 0..n { sum += m.get_or(format("key{}", i), -1); }
    let mut missing: i64 = 0;
    for i in 0..n { if !m.has(format("nokey{}", i)) { missing += 1; } }
    println("{} {} {}", m.len(), sum, missing);
}
