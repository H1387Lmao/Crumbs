// The same program with owned memory (std.own): no collector, no free(). Each tree is freed when its owner goes out of scope.
import std.own;

struct Node { left: own.Own<Node>, right: own.Own<Node> }

fn make(d: i32) -> own.Own<Node> {
    if d == 0 { return own.new(Node { left: own.none(), right: own.none() }); }
    return own.new(Node { left: make(d - 1), right: make(d - 1) });
}

fn check(t: *Node) -> i64 {
    if t.left.is_none() { return 1; }
    return 1 + check(t.left.at()) + check(t.right.at());
}

fn main() {
    let max_depth = 16;
    let mut total: i64 = check(make(max_depth + 1).at());
    let long_lived = make(max_depth);
    let mut d = 4;
    while d <= max_depth {
        let iters = 1 << (max_depth - d + 4);
        for _ in 0..iters { total += check(make(d).at()); }
        d += 2;
    }
    total += check(long_lived.at());
    println("{}", total);
}
