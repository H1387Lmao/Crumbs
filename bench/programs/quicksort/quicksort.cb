fn qsort(a: []i64, lo: i64, hi: i64) {
    if lo >= hi { return; }
    let mid = lo + (hi - lo) / 2;
    let t = a[mid]; a[mid] = a[hi]; a[hi] = t;
    let pivot = a[hi];
    let mut i = lo;
    for j in lo..hi {
        if a[j] < pivot {
            let u = a[i]; a[i] = a[j]; a[j] = u;
            i += 1;
        }
    }
    let v = a[i]; a[i] = a[hi]; a[hi] = v;
    qsort(a, lo, i - 1);
    qsort(a, i + 1, hi);
}

fn main() {
    let n: i64 = 3000000;
    let a = alloc(i64, n);
    let mut x: i64 = 12345;
    for i in 0..n {
        x = (x * 1103515245 + 12345) % 2147483648;
        a[i] = x;
    }
    qsort(a, 0, n - 1);
    let mut sum: i64 = 0;
    for i in 0..n { sum += (a[i] % 1000) * (i % 13); }
    let mut ok = true;
    for i in 1..n { if a[i - 1] > a[i] { ok = false; } }
    println("{} {}", sum, ok);
}
