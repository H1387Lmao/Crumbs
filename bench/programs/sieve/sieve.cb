fn main() {
    let n: i64 = 50000000;
    let composite = alloc(bool, n + 1);
    let mut count: i64 = 0;
    for i in 2..=n {
        if !composite[i] {
            count += 1;
            let mut j = i * i;
            while j <= n { composite[j] = true; j += i; }
        }
    }
    println("{}", count);
}
