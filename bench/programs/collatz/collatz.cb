fn main() {
    let limit: i64 = 3000000;
    let mut best: i64 = 0;
    let mut best_n: i64 = 0;
    for n in 1..limit {
        let mut x: i64 = n;
        let mut steps: i64 = 0;
        while x != 1 {
            if x % 2 == 0 { x = x / 2; } else { x = 3 * x + 1; }
            steps += 1;
        }
        if steps > best { best = steps; best_n = n; }
    }
    println("{} {}", best_n, best);
}
