// std.fs: whole-file reading and writing, and a few file-system queries (libc through FFI).
//
//   import std.fs;
//   let text = fs.read_to_string("notes.txt") catch |e| { panic("cannot read"); };
//   fs.write("out.txt", "hello\n") catch |e| { ... };
pub error NotFound;
pub error IoError;

include "stdio.h";
include "unistd.h";
include "dirent.h";
include "sys/stat.h";
extern fn fopen(path: *u8, mode: *u8) -> *void;
extern fn fclose(f: *void) -> i32;
extern fn fread(buf: *u8, size: u64, n: u64, f: *void) -> u64;
extern fn fwrite(buf: *u8, size: u64, n: u64, f: *void) -> u64;
extern fn ferror(f: *void) -> i32;
extern fn fseek(f: *void, off: i64, whence: i32) -> i32;
extern fn ftell(f: *void) -> i64;
extern "remove" fn c_remove(path: *u8) -> i32;
extern fn mkdir(path: *u8, mode: u32) -> i32;
extern fn access(path: *u8, mode: i32) -> i32;
extern fn opendir(path: *u8) -> *void;
extern fn closedir(d: *void) -> i32;
extern const SEEK_END: i32;

// a NUL-terminated copy of a path (owned, freed by its destructor)
fn cpath(p: str) -> String {
    let mut s = string_from(p);
    s += 0 as u8;
    return s;
}

// 0 = missing, 1 = file, 2 = directory
fn kind(path: str) -> i32 {
    let p = cpath(path);
    if access(p.ptr, 0) != 0 { return 0; }
    let d = opendir(p.ptr);
    if d == null { return 1; }
    closedir(d);
    return 2;
}

// 0 = ok, 1 = cannot open, 2 = read/write failed
fn read_into(path: str, out: *String) -> i32 {
    let p = cpath(path);
    let f = fopen(p.ptr, "rb".ptr);
    if f == null { return 1; }
    let buf = alloc(u8, 16384);
    let mut rc = 0;
    loop {
        let n = fread(buf.ptr, 1, 16384, f);
        if n == 0 { break; }
        for i in 0..n as i64 { *out += buf[i]; }
    }
    if ferror(f) != 0 { rc = 2; }
    fclose(f);
    free(buf);
    return rc;
}

fn write_file(path: str, data: str, append: i32) -> i32 {
    let p = cpath(path);
    let mut mode = "wb";
    if append != 0 { mode = "ab"; }
    let f = fopen(p.ptr, cstr(mode));
    if f == null { return 1; }
    let mut rc = 0;
    if data.len > 0 && fwrite(data.ptr, 1, data.len as u64, f) != data.len as u64 { rc = 2; }
    if fclose(f) != 0 { rc = 2; }
    return rc;
}

// the whole file as a String
pub fn read_to_string(path: str) -> String! {
    let mut out = string_new();
    let rc = read_into(path, &out);
    if rc == 1 { throw NotFound; }
    if rc != 0 { throw IoError; }
    return out;
}

// the file split into lines (without the line terminators)
pub fn read_lines(path: str) -> List<String>! {
    let text = try read_to_string(path);
    let mut lines: List<String> = List.new();
    let mut start: i64 = 0;
    let mut i: i64 = 0;
    while i < text.len {
        if text[i] == '\n' {
            let mut end = i;
            if end > start && text[end - 1] == '\r' { end -= 1; }
            lines.push(string_from(text[start..end]));
            start = i + 1;
        }
        i += 1;
    }
    if start < text.len { lines.push(string_from(text[start..])); }
    return lines;
}

// creates or replaces the file
pub fn write(path: str, data: str) -> void! {
    let rc = write_file(path, data, 0);
    if rc == 1 { throw NotFound; }
    if rc != 0 { throw IoError; }
}

// adds to the end of the file (creating it if needed)
pub fn append(path: str, data: str) -> void! {
    let rc = write_file(path, data, 1);
    if rc == 1 { throw NotFound; }
    if rc != 0 { throw IoError; }
}

pub fn exists(path: str) -> bool {
    return kind(path) != 0;
}

pub fn is_file(path: str) -> bool {
    return kind(path) == 1;
}

pub fn is_dir(path: str) -> bool {
    return kind(path) == 2;
}

// size in bytes of a file
pub fn size(path: str) -> i64! {
    let p = cpath(path);
    let f = fopen(p.ptr, "rb".ptr);
    if f == null { throw NotFound; }
    fseek(f, 0, SEEK_END);
    let n = ftell(f);
    fclose(f);
    return n;
}

pub fn remove(path: str) -> void! {
    let p = cpath(path);
    if c_remove(p.ptr) != 0 { throw NotFound; }
}

pub fn make_dir(path: str) -> void! {
    let p = cpath(path);
    if mkdir(p.ptr, 511) != 0 { throw IoError; }
}
