// std.io: character-level input/output on stdin/stdout (libc through FFI).
pub error Eof;

include "stdio.h";
extern "stdin" const stdin_file: *void;
extern fn getchar() -> i32;
extern fn putchar(c: i32) -> i32;
extern fn ungetc(c: i32, f: *void) -> i32;
extern fn fflush(f: *void) -> i32;
extern fn cb_gc_blocking_begin();      // waiting for input is a collector safepoint (see --gc-mode=thread)
extern fn cb_gc_blocking_end();

fn read_byte() -> i32 {
    cb_gc_blocking_begin();
    let c = getchar();
    cb_gc_blocking_end();
    return c;
}

// Read one byte from stdin. Fails with io.Eof at end of input (or Ctrl+D).
pub fn getc() -> u8! {
    let c = read_byte();
    if c < 0 { throw Eof; }
    return c as u8;
}

// Write one byte to stdout.
pub fn putc(c: u8) {
    putchar(c as i32);
}

fn peek() -> i32 {
    let c = read_byte();
    if c >= 0 { ungetc(c, stdin_file); }
    return c;
}

// Read one line from stdin, without its terminator. A line ends at '\n', '\r', "\r\n",
// or at end of input (Ctrl+D). Fails with io.Eof only if input ended before any byte was read.
pub fn get_line() -> String! {
    let mut line = string_new();
    let mut got = false;
    loop {
        let c = read_byte();
        if c < 0 {
            if !got { throw Eof; }
            return line;
        }
        got = true;
        if c == 10 { return line; }
        if c == 13 {
            if peek() == 10 { read_byte(); }
            return line;
        }
        line += c as u8;
    }
}

// Flush buffered output (useful before reading, e.g. after printing a prompt).
pub fn flush() { fflush(null); }
