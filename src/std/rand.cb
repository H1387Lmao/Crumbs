import std.time;

pub struct Rng {
    state: u64
}

impl Rng {
    pub fn new() -> Rng {
        let mut seed = time.unix() as u64;
        if (seed == 0) {
            seed = 6372197439939733838;
        }
        return Rng {
            state: seed
        };
    }

    pub fn from_seed(seed: u64) -> Rng {
        return Rng {
            state: seed
        };
    }

    pub fn below(mut self: *Rng, n: u64) -> u64 {
        return self.next() % n;
    }

    pub fn between(mut self: *Rng, min: u64, max: u64) -> u64 {
        if (min > max) {
            panic("min must be smaller than max");
        }
        return self.below(max - min + 1) + min;
    }

    pub fn float(mut self: *Rng) -> f64 {
        return (self.next() >> 11) as f64 / 9007199254740992.0;
    }

    pub fn next(mut self: *Rng) -> u64 {
        let mut x = self.state;
        x = x ^ (x >> 12);
        x = x ^ (x << 25);
        x = x ^ (x >> 27);
        
        let scrambled = x * 2685821657736338717;
        self.state = scrambled;
        
        return scrambled;
    }
}
