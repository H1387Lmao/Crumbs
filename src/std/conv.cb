// std.conv: string -> number conversion with real error handling.
pub error Empty, InvalidDigit, Overflow;

const I64_MIN: i64 = -9223372036854775808;

pub fn parse_i64(s: str) -> i64! {
    if s.len == 0 { throw Empty; }
    let mut i: i64 = 0;
    let mut neg = false;
    if s[0] == '-' { neg = true; i = 1; }
    else if s[0] == '+' { i = 1; }
    if i == s.len { throw InvalidDigit; }
    // accumulate as a negative number so i64::MIN is representable
    let mut acc: i64 = 0;
    while i < s.len {
        let c = s[i];
        if c < '0' || c > '9' { throw InvalidDigit; }
        let d = (c - '0') as i64;
        if acc < (I64_MIN + d) / 10 { throw Overflow; }
        acc = acc * 10 - d;
        i += 1;
    }
    if !neg {
        if acc == I64_MIN { throw Overflow; }
        acc = -acc;
    }
    return acc;
}

pub fn parse_i32(s: str) -> i32! {
    let v = try parse_i64(s);
    if v < -2147483648 || v > 2147483647 { throw Overflow; }
    return v as i32;
}
