// std.env: command-line arguments and environment variables.
//
//   import std.env;
//   let args = env.args();            // args.get(0) is the program name
//   let home = env.get("HOME") catch "";
pub error NotSet;

extern fn cb_argc() -> i64;
extern fn cb_argv_at(i: i64) -> str;
extern fn cb_env_get(name: str, out: *String) -> i32;

pub fn arg_count() -> i64 { return cb_argc(); }

// argument i (0 is the program name); empty if out of range
pub fn arg(i: i64) -> str {
    if i < 0 || i >= cb_argc() { return ""; }
    return cb_argv_at(i);
}

// every argument, copied into owned strings
pub fn args() -> List<String> {
    let mut out: List<String> = List.new();
    for i in 0..cb_argc() { out.push(string_from(cb_argv_at(i))); }
    return out;
}

// the value of an environment variable
pub fn get(name: str) -> String! {
    let mut out = string_new();
    if cb_env_get(name, &out) == 0 { throw NotSet; }
    return out;
}

pub fn has(name: str) -> bool {
    let mut out = string_new();
    return cb_env_get(name, &out) != 0;
}
