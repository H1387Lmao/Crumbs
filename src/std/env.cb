// std.env: command-line arguments and environment variables (libc through FFI).
//
//   import std.env;
//   let args = env.args();            // args.get(0) is the program name
//   let home = env.get("HOME") catch "";
pub error NotSet;

// the runtime stores main's argc/argv in these two variables at startup
extern "cb_argc_v" const ARGC: i32;
extern "cb_argv_v" const ARGV: **u8;
extern fn getenv(name: *u8) -> *u8;

pub fn arg_count() -> i64 { return ARGC as i64; }

// argument i (0 is the program name); empty if out of range
pub fn arg(i: i64) -> str {
    if i < 0 || i >= ARGC as i64 { return ""; }
    return from_cstr(argv_at(i));
}

// every argument, copied into owned strings
pub fn args() -> List<String> {
    let mut out: List<String> = List.new();
    for i in 0..ARGC as i64 { out.push(string_from(from_cstr(argv_at(i)))); }
    return out;
}

// the value of an environment variable
pub fn get(name: str) -> String! {
    let v = getenv(cstr(name));
    if v == null { throw NotSet; }
    return string_from(from_cstr(v));
}

pub fn has(name: str) -> bool {
    return getenv(cstr(name)) != null;
}

fn argv_at(i: i64) -> *u8 { return slice_of(ARGV, ARGC as i64)[i]; }
