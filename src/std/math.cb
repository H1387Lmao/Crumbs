// std.math: constants, libm bindings and small integer helpers.
pub const PI: f64 = 3.14159265358979323846;
pub const E: f64 = 2.71828182845904523536;

pub extern fn sqrt(x: f64) -> f64;
pub extern fn sin(x: f64) -> f64;
pub extern fn cos(x: f64) -> f64;
pub extern fn tan(x: f64) -> f64;
pub extern fn atan2(y: f64, x: f64) -> f64;
pub extern fn exp(x: f64) -> f64;
pub extern fn log(x: f64) -> f64;
pub extern fn pow(x: f64, y: f64) -> f64;
pub extern fn floor(x: f64) -> f64;
pub extern fn ceil(x: f64) -> f64;
pub extern fn fabs(x: f64) -> f64;

pub fn abs_i32(x: i32) -> i32 { if x < 0 { return -x; } return x; }
pub fn abs_i64(x: i64) -> i64 { if x < 0 { return -x; } return x; }
pub fn min_i32(a: i32, b: i32) -> i32 { if a < b { return a; } return b; }
pub fn max_i32(a: i32, b: i32) -> i32 { if a > b { return a; } return b; }
pub fn min_i64(a: i64, b: i64) -> i64 { if a < b { return a; } return b; }
pub fn max_i64(a: i64, b: i64) -> i64 { if a > b { return a; } return b; }
pub fn min_f64(a: f64, b: f64) -> f64 { if a < b { return a; } return b; }
pub fn max_f64(a: f64, b: f64) -> f64 { if a > b { return a; } return b; }

pub fn gcd(a: i64, b: i64) -> i64 {
    let mut x = abs_i64(a);
    let mut y = abs_i64(b);
    while y != 0 {
        let t = x % y;
        x = y;
        y = t;
    }
    return x;
}
