// Diagnostics for the stages after lexing (mirrors the part of src/crumbsc/diag.py the stages need).
pub struct Diagnostic { level: String, file: String, line: i64, col: i64, len: i64, msg: String, label: String, help: String, note: String }

pub struct Diags { items: List<Diagnostic>, file: String, context: String }

pub fn new_diags() -> Diags { return Diags { items: List.new(), file: String.empty(), context: String.empty() }; }

impl Diags {
    fn dup(self, level: str, line: i64, col: i64, msg: str) -> bool {
        for d in self.items {
            if d.level == level && d.msg == msg && d.line == line && d.col == col && d.file == self.file { return true; }
        }
        return false;
    }
    fn add(mut self, level: str, line: i64, col: i64, len: i64, msg: str, label: str, help: str, note: str) {
        if self.dup(level, line, col, msg) { return; }
        let mut note2 = String.from(note);
        if self.context.len > 0 {
            if note2.len > 0 { note2.append(" ## "); }
            note2.append(self.context);
        }
        self.items.push(Diagnostic { level: String.from(level), file: String.from(self.file), line: line, col: col,
                                     len: len > 1 ? len : 1, msg: String.from(msg), label: String.from(label),
                                     help: String.from(help), note: note2 });
    }
    pub fn add_error(mut self, line: i64, col: i64, len: i64, msg: str, label: str, help: str) {
        self.add("error", line, col, len, msg, label, help, "");
    }
    pub fn add_warn(mut self, line: i64, col: i64, len: i64, msg: str, label: str, help: str) {
        self.add("warning", line, col, len, msg, label, help, "");
    }
    pub fn add_warn_note(mut self, line: i64, col: i64, len: i64, msg: str, label: str, help: str, note: str) {
        self.add("warning", line, col, len, msg, label, help, note);
    }
    pub fn error_count(self) -> i64 {
        let mut n = 0 as i64;
        for d in self.items { if d.level == "error" { n += 1; } }
        return n;
    }
    pub fn add_error_note(mut self, line: i64, col: i64, len: i64, msg: str, label: str, help: str, note: str) {
        self.add("error", line, col, len, msg, label, help, note);
    }
    pub fn has_error_on(self, line: i64) -> bool {
        for d in self.items { if d.level == "error" && d.line == line && d.file == self.file { return true; } }
        return false;
    }
}

pub fn edit_distance(a: str, b: str) -> i64 {
    if a == b { return 0; }
    let mut prev: List<i64> = List.new();
    for j in 0..b.len + 1 { prev.push(j); }
    for i in 0..a.len {
        let mut cur: List<i64> = List.new();
        cur.push(i + 1);
        for j in 0..b.len {
            let del = *prev.at(j + 1) + 1;
            let ins = *cur.at(j) + 1;
            let sub = *prev.at(j) + (a[i] != b[j] ? 1 : 0);
            let mut m = del < ins ? del : ins;
            if sub < m { m = sub; }
            cur.push(m);
        }
        prev = cur;
    }
    return *prev.at(b.len);
}

fn lower(s: str) -> String {
    let mut o = String.empty();
    for i in 0..s.len { o.push(s[i] >= 'A' && s[i] <= 'Z' ? s[i] + 32 : s[i]); }
    return o;
}

// the closest candidate to `name` (empty when none is close enough)
pub fn suggest(name: str, candidates: []str) -> String {
    let mut best = String.empty();
    let mut best_d = 1000000000 as i64;
    let ln = lower(name);
    for c in candidates {
        if c == name { continue; }
        let d = edit_distance(ln, lower(c));
        if d < best_d { best = String.from(c); best_d = d; }
    }
    let mut limit = name.len / 3 + 1;
    if limit > 3 { limit = 3; }
    if limit < 1 { limit = 1; }
    if best.len > 0 && best_d <= limit { return best; }
    return String.empty();
}

// like `suggest`, for a list of names
pub fn suggest_list(name: str, candidates: *List<String>) -> String {
    let mut best = String.empty();
    let mut best_d = 1000000000 as i64;
    let ln = lower(name);
    for i in 0..candidates.len {
        let c: str = *candidates.at(i);
        if c == name { continue; }
        let d = edit_distance(ln, lower(c));
        if d < best_d { best = String.from(c); best_d = d; }
    }
    let mut limit = name.len / 3 + 1;
    if limit > 3 { limit = 3; }
    if limit < 1 { limit = 1; }
    if best.len > 0 && best_d <= limit { return best; }
    return String.empty();
}
