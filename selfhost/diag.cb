// Diagnostics for the stages after lexing (mirrors the part of src/crumbsc/diag.py the stages need).
pub struct Diagnostic { level: String, line: i64, col: i64, len: i64, msg: String, label: String, help: String }

pub struct Diags { items: List<Diagnostic> }

pub fn new_diags() -> Diags { return Diags { items: List.new() }; }

impl Diags {
    fn dup(self, level: str, line: i64, col: i64, msg: str) -> bool {
        for d in self.items {
            if d.level == level && d.msg == msg && d.line == line && d.col == col { return true; }
        }
        return false;
    }
    fn add(mut self, level: str, line: i64, col: i64, len: i64, msg: str, label: str, help: str) {
        if self.dup(level, line, col, msg) { return; }
        self.items.push(Diagnostic { level: String.from(level), line: line, col: col, len: len > 1 ? len : 1,
                                     msg: String.from(msg), label: String.from(label), help: String.from(help) });
    }
    pub fn add_error(mut self, line: i64, col: i64, len: i64, msg: str, label: str, help: str) {
        self.add("error", line, col, len, msg, label, help);
    }
    pub fn add_warn(mut self, line: i64, col: i64, len: i64, msg: str, label: str, help: str) {
        self.add("warning", line, col, len, msg, label, help);
    }
    pub fn has_error_on(self, line: i64) -> bool {
        for d in self.items { if d.level == "error" && d.line == line { return true; } }
        return false;
    }
}

pub fn edit_distance(a: str, b: str) -> i64 {
    if a == b { return 0; }
    let mut prev: List<i64> = List.new();
    for j in 0..b.len + 1 { prev.push(j); }
    for i in 0..a.len {
        let mut cur: List<i64> = List.new();
        cur.push(i + 1);
        for j in 0..b.len {
            let del = *prev.at(j + 1) + 1;
            let ins = *cur.at(j) + 1;
            let sub = *prev.at(j) + (a[i] != b[j] ? 1 : 0);
            let mut m = del < ins ? del : ins;
            if sub < m { m = sub; }
            cur.push(m);
        }
        prev = cur;
    }
    return *prev.at(b.len);
}

fn lower(s: str) -> String {
    let mut o = String.empty();
    for i in 0..s.len { o.push(s[i] >= 'A' && s[i] <= 'Z' ? s[i] + 32 : s[i]); }
    return o;
}

// the closest candidate to `name` (empty when none is close enough)
pub fn suggest(name: str, candidates: []str) -> String {
    let mut best = String.empty();
    let mut best_d = 1000000000 as i64;
    let ln = lower(name);
    for c in candidates {
        if c == name { continue; }
        let d = edit_distance(ln, lower(c));
        if d < best_d { best = String.from(c); best_d = d; }
    }
    let mut limit = name.len / 3 + 1;
    if limit > 3 { limit = 3; }
    if limit < 1 { limit = 1; }
    if best.len > 0 && best_d <= limit { return best; }
    return String.empty();
}
