// Semantic analysis, written in Crumbs. A port of src/crumbsc/checker.py, in stages: this file holds the data
// model and the declaration phase (symbols, impls, traits, destructors, bounds).
import std.map;
import ast;
import diag;
import lexer;
import loader;
import parser;
import types;
import creserved;
import fmtspec;

// ---- data model -------------------------------------------------------------------------------------

pub struct TMeth { name: String, node: i64 }
pub struct BoundList { tp: String, traits: List<i64> }

pub struct CVal { kind: i64, i: i64, s: String, f: f64 }     // kind: 0 int, 1 float (value in f), 2 bool, 3 bytes
extern fn strtod(s: *u8, end: *void) -> f64;
pub struct SField { name: String, ty: i64, span: ast.Span }
pub struct NameTy { name: String, ty: i64 }

pub struct Local {
    name: String, ty: i64, is_mut: bool, cname: String, span: ast.Span, used: bool, is_param: bool, glue: bool,
    rdepth: i64, id: i64, captured: bool, written: bool, region_handle: bool, byref: bool, outer: i64, taint: i64, rd: i64,
}
pub struct SumEnt { kind: i64, idx: i64 }
pub struct CloInfo { is_move: bool, span: ast.Span, outer: List<i64>, proxy: List<i64>, sym: i64, body: ast.Node }
pub struct BckEnt { sym: i64, body: ast.Node, params: List<i64>, context: String }
pub struct MovedEnt { local: i64, line: i64 }
pub struct Scope { names: List<String>, ids: List<i64>, clo: i64 }
pub struct LoopFrame { breaks: List<List<MovedEnt>>, conts: List<List<MovedEnt>> }
pub struct ImplRec { item: i64, fn_nodes: List<i64>, fn_idx: List<i64> }
pub struct GlueEnt { key: String, v: bool }

pub struct Sym {
    kind: String,                 // fn struct enum const error trait
    name: String,
    mod_idx: i64,
    node: i64,                    // index into Checker.nodes
    is_pub: bool,
    full: String,
    cname: String,
    is_extern: bool,
    is_export: bool,
    variadic: bool,
    tparams: List<String>,
    csym: String,
    has_csym: bool,
    opaque: bool,
    extern_struct: bool,
    is_method: bool,
    has_self: bool,
    self_mut: bool,
    method_name: String,
    is_drop: bool,
    code: i64,
    variants: List<String>,
    trait_methods: List<TMeth>,   // in order of first declaration
    supers: List<i64>,
    drop_sym: i64,                // -1: none
    has_bounds: bool,
    bounds: List<BoundList>,
    ty: i64,                      // struct / enum: its type; const: its declared type
    params: List<i64>,
    ret: i64,
    fields: List<SField>,
    base: i64,                    // generic template this instance came from (-1: none)
    targs: List<i64>,
    tenv: List<NameTy>,
    cv: CVal,
    evaluating: bool,
    evaluated: bool,
    drop_inst: i64,
    summary: List<SumEnt>,
    has_summary: bool,
    clo: i64,
    param_locals: List<i64>,
}

pub struct CImp { alias: String, mod_idx: i64, node_line: i64, node_col: i64, node_len: i64, used: bool }

pub struct CMod {
    syms: map.HashMap<i64>,
    order: List<i64>,             // symbols in definition order
    items: List<i64>,             // the module's items, as indices into Checker.nodes
    imports: List<CImp>,
}

pub struct MEnt { name: String, sym: i64 }
pub struct MethTab { key: String, entries: List<MEnt> }

pub struct TImpl {
    trait_full: String,
    trait_sym: i64,
    key: String,
    tparams: List<String>,
    bounds: ast.Val,              // the impl's `tbounds` (a dict value)
    node: i64,
    mod_idx: i64,
    line: i64,
    col: i64,
    len: i64,
}

pub struct NameSym { name: String, sym: i64 }

pub struct Checker {
    ld: *loader.Loader,
    d: diag.Diags,
    nostd: bool,
    nodes: List<ast.Node>,
    syms: List<Sym>,
    cmods: List<CMod>,            // indexed like Loader.mods
    errors: List<i64>,
    fns: List<i64>,
    structs: List<i64>,
    enums: List<i64>,
    consts: List<i64>,
    traits: List<i64>,
    methods: List<MethTab>,
    trait_impls: List<TImpl>,
    prelude_types: List<NameSym>,
    prelude_traits: List<NameSym>,
    bound_seen: List<String>,
    types: types.Arena,
    tenv: List<NameTy>,
    cur_mod: i64,
    inst_cache: map.HashMap<i64>,
    n_inst: i64,
    pending: List<i64>,
    nc: bool,                     // a `NotConst` is in flight
    nc_mi: i64,
    nc_span: ast.Span,
    nc_msg: String,
    locals: List<Local>,
    scopes: List<Scope>,
    moved: List<MovedEnt>,
    has_fn: bool,                 // a function body is being checked
    fn_sym: i64,                  // its symbol (-1 outside functions)
    fn_ret: i64,
    fn_names: List<String>,
    fn_loops: i64,
    fn_rdepth: i64,
    loop_stack: List<LoopFrame>,
    reinit_line: i64,             // the identifier being re-assigned (0: none)
    reinit_col: i64,
    glue: List<GlueEnt>,
    glue_busy: List<String>,
    strict: bool,
    entry_name: String,
    main_sym: i64,
    entry_mod: i64,
    opt_consumed: List<i64>,
    impl_recs: List<ImplRec>,
    gc_mode: String,
    recv_wrap: bool,
    clos: List<CloInfo>,
    bck: List<BckEnt>,
    try_stack: List<List<List<MovedEnt>>>,   // per enclosing `try { }`: the moved-sets at each point that can fail
}

pub fn new_checker(ld: *loader.Loader, nostd: bool) -> Checker {
    let mut ck = Checker {
        ld: ld, d: diag.new_diags(), nostd: nostd, nodes: List.new(), syms: List.new(), cmods: List.new(),
        errors: List.new(), fns: List.new(), structs: List.new(), enums: List.new(), consts: List.new(),
        traits: List.new(), methods: List.new(), trait_impls: List.new(), prelude_types: List.new(),
        prelude_traits: List.new(), bound_seen: List.new(),
        types: types.new_arena(), tenv: List.new(), cur_mod: 0, inst_cache: map.HashMap.new(), n_inst: 0, pending: List.new(),
        nc: false, nc_mi: 0, nc_span: ast.span(0, 0, 1), nc_msg: String.empty(),
        locals: List.new(), scopes: List.new(), moved: List.new(), has_fn: false, fn_sym: -1, fn_ret: types.VOID, fn_names: List.new(),
        fn_loops: 0, fn_rdepth: 0, loop_stack: List.new(), reinit_line: 0, reinit_col: 0, glue: List.new(), glue_busy: List.new(),
        strict: false, entry_name: String.from("main"), opt_consumed: List.new(), impl_recs: List.new(), gc_mode: String.from("auto"), recv_wrap: false, clos: List.new(), bck: List.new(), try_stack: List.new(), main_sym: -1, entry_mod: ld.order.len > 0 ? *ld.order.at(ld.order.len - 1) : 0,
    };
    // move every module's items into the node arena; syms and later phases refer to them by index
    for mi in 0..ld.mods.len {
        let mut cm = CMod { syms: map.HashMap.new(), order: List.new(), items: List.new(), imports: List.new() };
        let n = ld.mods.at(mi).ast.get("items").items.len;
        for k in 0..n {
            let id = ck.nodes.len;
            ck.nodes.push(ast.clone_node(ld.mods.at(mi).ast.get("items").items.at(k).node.at(0)));
            cm.items.push(id);
        }
        for i in 0..ld.mods.at(mi).imports.len {
            let im = ld.mods.at(mi).imports.at(i);
            cm.imports.push(CImp { alias: String.from(im.alias), mod_idx: im.mod_idx, node_line: im.line, node_col: im.col, node_len: im.len, used: false });
        }
        ck.cmods.push(cm);
    }
    return ck;
}

// ---- small helpers -----------------------------------------------------------------------------------

pub fn new_sym(ck: *Checker, kind: str, name: str, mi: i64, node: i64, is_pub: bool) -> Sym {
    let prefix: str = ck.ld.mods.at(mi).cprefix;
    return Sym {
        kind: String.from(kind), name: String.from(name), mod_idx: mi, node: node, is_pub: is_pub,
        full: format("{prefix}.{name}"), cname: format("{prefix}__{name}"),
        is_extern: false, is_export: false, variadic: false, tparams: List.new(), csym: String.empty(), has_csym: false,
        opaque: false, extern_struct: false, is_method: false, has_self: false, self_mut: false,
        method_name: String.empty(), is_drop: false, code: 0, variants: List.new(), trait_methods: List.new(),
        supers: List.new(), drop_sym: -1, has_bounds: false, bounds: List.new(),
        ty: -1, params: List.new(), ret: types.VOID, fields: List.new(), base: -1, targs: List.new(), tenv: List.new(),
        cv: CVal { kind: 0, i: 0, s: String.empty(), f: 0.0 }, evaluating: false, evaluated: false, drop_inst: -1, summary: List.new(), has_summary: false, clo: -1, param_locals: List.new(),
    };
}

pub fn names_of(v: *ast.Val) -> List<String> {
    let mut o: List<String> = List.new();
    for i in 0..v.items.len { o.push(String.from(v.items.at(i).s)); }
    return o;
}

pub fn path_of(n: *ast.Node) -> List<String> { return names_of(n.get("path")); }

pub fn join_path(p: *List<String>) -> String {
    let mut o = String.empty();
    for i in 0..p.len { if i > 0 { o.push('.'); } o.append(*p.at(i)); }
    return o;
}

pub fn child(v: *ast.Val, i: i64) -> *ast.Node { return v.items.at(i).node.at(0); }

pub fn has_name(l: *List<String>, s: str) -> bool {
    for i in 0..l.len { if *l.at(i) == s { return true; } }
    return false;
}

pub fn is_prim_name(s: str) -> bool {
    return s == "i8" || s == "i16" || s == "i32" || s == "i64" || s == "u8" || s == "u16" || s == "u32" || s == "u64"
        || s == "f32" || s == "f64" || s == "bool" || s == "str" || s == "String" || s == "void";
}

pub fn is_reserved(s: str) -> bool {
    if is_prim_name(s) || s == "error" || s == "null" { return true; }
    let names = ["print", "println", "format", "panic", "assert", "alloc", "free", "exit", "to_str", "string_new",
                 "string_from", "string_clear", "cstr", "from_cstr", "slice_of", "size_of", "drop", "drop_at", "write_at",
                 "read_at", "gc_collect", "gc_bytes", "gc_collections", "alloc_in", "gc_collect_gen", "gc_gen_bytes",
                 "gc_gen_collections"];
    for i in 0..27 { if s == names[i] { return true; } }
    return false;
}

// reports an error in module `mi`; `notes` are joined with " ## "
pub fn err(ck: *Checker, mi: i64, sp: ast.Span, msg: str, label: str, help: str, notes: str) {
    ck.d.file = String.from(ck.ld.mods.at(mi).shown);
    ck.d.add_error_note(sp.line, sp.col, sp.len, msg, label, help, notes);
}

pub fn lookup_sym(ck: *Checker, mi: i64, name: str) -> i64 {
    let p = ck.cmods.at(mi).syms.get(name);
    if p == null { return -1; }
    return *p;
}

pub fn lookup_named(l: *List<NameSym>, name: str) -> i64 {
    for i in 0..l.len { if l.at(i).name == name { return l.at(i).sym; } }
    return -1;
}

pub fn import_of(ck: *Checker, mi: i64, alias: str) -> i64 {
    let cm = ck.cmods.at(mi);
    for i in 0..cm.imports.len { if cm.imports.at(i).alias == alias { return i; } }
    return -1;
}

pub fn node_line(ck: *Checker, sym: i64) -> i64 { return ck.nodes.at(ck.syms.at(sym).node).span.line; }

// registers `s` in module `mi`; -1 (and an error) when the name is taken
pub fn define(ck: *Checker, mi: i64, s: Sym, sp: ast.Span) -> i64 {
    let name = String.from(s.name);
    let old = lookup_sym(ck, mi, name);
    if old >= 0 {
        err(ck, mi, sp, format("the name `{name}` is defined multiple times"), "redefined here", "",
            format("previous definition of `{name}` is at line {node_line(ck, old)}"));
        return -1;
    }
    if is_reserved(name) {
        err(ck, mi, sp, format("`{name}` is a reserved name and cannot be redefined"), "", "", "");
        return -1;
    }
    if import_of(ck, mi, name) >= 0 {
        err(ck, mi, sp, format("`{name}` conflicts with an imported module of the same name"), "", "", "");
        return -1;
    }
    let id = ck.syms.len;
    ck.syms.push(s);
    ck.cmods.at(mi).syms.set(name, id);
    ck.cmods.at(mi).order.push(id);
    return id;
}

// ---- declaration ----------------------------------------------------------------------------------------

pub fn declare(ck: *Checker, mi: i64) {
    let nitems = ck.cmods.at(mi).items.len;
    let mut drops: List<i64> = List.new();
    let mut plain: List<i64> = List.new();
    for k in 0..nitems {
        let id = *ck.cmods.at(mi).items.at(k);
        let it = ck.nodes.at(id);
        if it.kind == "Fn" && !it.is_none("drop_for") { drops.push(id); } else { plain.push(id); }
    }
    for k in 0..plain.len {
        let id = *plain.at(k);
        declare_item(ck, mi, id);
    }
    for k in 0..drops.len { declare_drop(ck, mi, *drops.at(k)); }
    for k in 0..nitems {
        let id = *ck.cmods.at(mi).items.at(k);
        if ck.nodes.at(id).kind == "Impl" { declare_impl(ck, mi, id); }
    }
}

pub fn declare_item(ck: *Checker, mi: i64, id: i64) {
    let kind = String.from(ck.nodes.at(id).kind);
    let sp = ck.nodes.at(id).span;
    let is_pub = param_flag(ck.nodes.at(id), "pub");
    if kind == "Fn" {
        let name = String.from(ck.nodes.at(id).str_of("name"));
        let mut s = new_sym(ck, "fn", name, mi, id, is_pub);
        s.is_extern = ck.nodes.at(id).get("extern").i != 0;
        s.tparams = names_of(ck.nodes.at(id).get("tparams"));
        s.variadic = ck.nodes.at(id).get("variadic").i != 0;
        s.is_export = ck.nodes.at(id).get("export").i != 0;
        if s.is_extern {
            let cs = String.from(ck.nodes.at(id).str_of("cname_str"));
            s.csym = cs.len > 0 ? cs : String.from(name);
            s.has_csym = true;
            let prefix: str = ck.ld.mods.at(mi).cprefix;
            s.cname = format("cb_x_{prefix}__{name}");
        } else if s.is_export {
            s.cname = String.from(name);
        }
        let generic = s.tparams.len > 0;
        let sid = define(ck, mi, s, sp);
        if sid >= 0 && !generic { ck.fns.push(sid); }
    } else if kind == "Struct" {
        let name = String.from(ck.nodes.at(id).str_of("name"));
        let mut s = new_sym(ck, "struct", name, mi, id, is_pub);
        s.tparams = names_of(ck.nodes.at(id).get("tparams"));
        s.extern_struct = ck.nodes.at(id).get("extern").i != 0;
        s.opaque = ck.nodes.at(id).get("opaque").i != 0;
        let generic = s.tparams.len > 0;
        let sid = define(ck, mi, s, sp);
        if sid >= 0 {
            let full: str = ck.syms.at(sid).full;
            ck.syms.at(sid).ty = types.sym_ty(&ck.types, types.K_STRUCT, sid, full);
        }
        if sid >= 0 && !generic { ck.structs.push(sid); }
    } else if kind == "Enum" {
        let name = String.from(ck.nodes.at(id).str_of("name"));
        let mut s = new_sym(ck, "enum", name, mi, id, is_pub);
        let nv = ck.nodes.at(id).get("variants").items.len;
        for k in 0..nv { s.variants.push(String.from(ck.nodes.at(id).get("variants").items.at(k).items.at(0).s)); }
        if nv == 0 { err(ck, mi, sp, format("enum `{name}` has no variants"), "", "", ""); }
        let mut seen: List<String> = List.new();
        for k in 0..nv {
            let vn = String.from(ck.nodes.at(id).get("variants").items.at(k).items.at(0).s);
            let vs = ck.nodes.at(id).get("variants").items.at(k).items.at(1).span;
            if has_name(&seen, vn) { err(ck, mi, vs, format("duplicate variant `{vn}` in enum `{name}`"), "", "", ""); }
            seen.push(vn);
        }
        let sid = define(ck, mi, s, sp);
        if sid >= 0 {
            let full: str = ck.syms.at(sid).full;
            ck.syms.at(sid).ty = types.sym_ty(&ck.types, types.K_ENUM, sid, full);
            ck.enums.push(sid);
        }
    } else if kind == "Trait" {
        let name = String.from(ck.nodes.at(id).str_of("name"));
        let mut s = new_sym(ck, "trait", name, mi, id, is_pub);
        let nm = ck.nodes.at(id).get("methods").items.len;
        for k in 0..nm {
            let f = child(ck.nodes.at(id).get("methods"), k);
            let fname = String.from(f.str_of("name"));
            let mut at = -1 as i64;
            for q in 0..s.trait_methods.len { if s.trait_methods.at(q).name == fname { at = q; } }
            if at >= 0 {
                err(ck, mi, f.span, format("the trait `{name}` declares the method `{fname}` more than once"), "", "",
                    format("the first one is at line {first_line_of(ck, id, fname)}"));
            }
            // the dict keeps the first position and the last node
            if at >= 0 { s.trait_methods.at(at).node = k; } else { s.trait_methods.push(TMeth { name: fname, node: k }); }
        }
        if nm == 0 { err(ck, mi, sp, format("trait `{name}` has no methods"), "", "declare at least one `fn` inside it", ""); }
        let sid = define(ck, mi, s, sp);
        if sid >= 0 { ck.traits.push(sid); }
    } else if kind == "Const" {
        let name = String.from(ck.nodes.at(id).str_of("name"));
        let mut s = new_sym(ck, "const", name, mi, id, is_pub);
        if ck.nodes.at(id).get("extern").i != 0 {
            s.is_extern = true;
            let cs = String.from(ck.nodes.at(id).str_of("cname_str"));
            s.csym = cs.len > 0 ? cs : String.from(name);
            s.has_csym = true;
        }
        let sid = define(ck, mi, s, sp);
        if sid >= 0 { ck.consts.push(sid); }
    } else if kind == "ErrorDecl" {
        let nn = ck.nodes.at(id).get("names").items.len;
        for k in 0..nn {
            let nm = String.from(ck.nodes.at(id).get("names").items.at(k).items.at(0).s);
            let nsp = ck.nodes.at(id).get("names").items.at(k).items.at(1).span;
            let mut s = new_sym(ck, "error", nm, mi, id, is_pub);
            s.ty = types.ERR;
            let sid = define(ck, mi, s, nsp);
            if sid >= 0 {
                ck.errors.push(sid);
                ck.syms.at(sid).code = ck.errors.len;
            }
        }
    }
}

// the line of the first method called `fname` in trait item `id`
pub fn first_line_of(ck: *Checker, id: i64, fname: str) -> i64 {
    let ms = ck.nodes.at(id).get("methods");
    for k in 0..ms.items.len {
        let f = child(ms, k);
        if f.str_of("name") == fname { return f.span.line; }
    }
    return 0;
}

// ---- types as written: a canonical string, and readable text -------------------------------------------------

pub fn inner_of(tn: *ast.Node) -> *ast.Node { return tn.node_of("inner"); }
pub fn ptr_prefix(tn: *ast.Node) -> str { return tn.get("ro").i != 0 ? "*const " : "*"; }
pub fn q(fallback: str) -> str { return fallback; }

pub fn size_text(n: *ast.Node, fallback: str) -> String {
    let sz = n.node_of("size");
    if sz.has("value") {
        let v = sz.get("value");
        if v.tag == 2 { return v.s.len > 0 ? String.from(v.s) : format("{v.i}"); }
        if v.tag == 1 { return String.from(v.i != 0 ? "True" : "False"); }
    }
    return String.from(fallback);
}

// Names are replaced by their full symbol names and `Self` by `selfc` (None when `has_self` is false), so two
// spellings of the same type (`Point` / `geom.Point`) give the same string.
pub fn canon(ck: *Checker, tn: *ast.Node, mi: i64, selfc: str, has_self: bool) -> String {
    let k: str = tn.kind;
    if k == "TName" {
        let mut p = path_of(tn);
        let nargs = tn.get("args").items.len;
        if p.len == 1 && *p.at(0) == "Self" && nargs == 0 { return String.from(has_self ? selfc : "None"); }
        let mut base = String.empty();
        if p.len == 1 {
            let mut sym = -1 as i64;
            if !is_prim_name(*p.at(0)) {
                sym = lookup_sym(ck, mi, *p.at(0));
                if sym < 0 { sym = lookup_named(&ck.prelude_types, *p.at(0)); }
            }
            base = sym >= 0 ? String.from(ck.syms.at(sym).full) : String.from(*p.at(0));
        } else if p.len == 2 && import_of(ck, mi, *p.at(0)) >= 0 {
            let im = import_of(ck, mi, *p.at(0));
            let tm = ck.cmods.at(mi).imports.at(im).mod_idx;
            let sym = lookup_sym(ck, tm, *p.at(1));
            base = sym >= 0 ? String.from(ck.syms.at(sym).full) : join_path(&p);
        } else {
            base = join_path(&p);
        }
        if nargs > 0 {
            base.push('<');
            for i in 0..nargs {
                if i > 0 { base.push(','); }
                base.append(canon(ck, child(tn.get("args"), i), mi, selfc, has_self));
            }
            base.push('>');
        }
        return base;
    }
    if k == "TPtr" || k == "TSlice" || k == "TArray" || k == "TErrUnion" || k == "TOpt" {
        let inner = canon(ck, inner_of(tn), mi, selfc, has_self);
        if k == "TPtr" { return format("{ptr_prefix(tn)}{inner}"); }
        if k == "TSlice" { return format("[]{inner}"); }
        if k == "TArray" { let sz = size_text(tn, "?"); return format("[{sz}]{inner}"); }
        if k == "TErrUnion" { return format("{inner}!"); }
        return format("{inner}?");
    }
    if k == "TFn" || k == "TClo" {
        let mut ret = String.from("void");
        if !tn.is_none("ret") { ret = canon(ck, tn.node_of("ret"), mi, selfc, has_self); }
        let mut ps = String.empty();
        for i in 0..tn.get("params").items.len {
            if i > 0 { ps.push(','); }
            ps.append(canon(ck, child(tn.get("params"), i), mi, selfc, has_self));
        }
        let kw = k == "TFn" ? "fn" : "clo";
        return format("{kw}({ps})->{ret}");
    }
    return String.from("?");
}

pub fn tn_text(tn: *ast.Node) -> String {
    let k: str = tn.kind;
    if k == "TName" {
        let mut p = path_of(tn);
        let mut o = join_path(&p);
        let nargs = tn.get("args").items.len;
        if nargs > 0 {
            o.push('<');
            for i in 0..nargs {
                if i > 0 { o.append(", "); }
                o.append(tn_text(child(tn.get("args"), i)));
            }
            o.push('>');
        }
        return o;
    }
    if k == "TPtr" || k == "TSlice" || k == "TArray" || k == "TErrUnion" || k == "TOpt" {
        let inner = tn_text(inner_of(tn));
        if k == "TPtr" { return format("{ptr_prefix(tn)}{inner}"); }
        if k == "TSlice" { return format("[]{inner}"); }
        if k == "TArray" { let sz = size_text(tn, ".."); return format("[{sz}]{inner}"); }
        if k == "TErrUnion" { return format("{inner}!"); }
        return format("{inner}?");
    }
    if k == "TFn" || k == "TClo" {
        let mut ps = String.empty();
        for i in 0..tn.get("params").items.len {
            if i > 0 { ps.append(", "); }
            ps.append(tn_text(child(tn.get("params"), i)));
        }
        let mut ret = String.empty();
        if !tn.is_none("ret") { let rt = tn_text(tn.node_of("ret")); ret = format(" -> {rt}"); }
        if k == "TFn" { return format("fn({ps}){ret}"); }
        return format("|{ps}|{ret}");
    }
    return String.from("?");
}

pub fn param_flag(p: *ast.Node, name: str) -> bool { return p.has(name) && p.get(name).i != 0; }

pub fn sig_text(f: *ast.Node) -> String {
    let mut ps = String.empty();
    let params = f.get("params");
    for i in 0..params.items.len {
        let p = child(params, i);
        if i > 0 { ps.append(", "); }
        if param_flag(p, "self_param") { ps.append(param_flag(p, "self_mut") ? "mut self" : "self"); }
        else {
            let pn = String.from(p.str_of("name"));
            let pt = tn_text(p.node_of("tyn"));
            ps.append(format("{pn}: {pt}"));
        }
    }
    let fname = String.from(f.str_of("name"));
    let mut o = format("fn {fname}({ps})");
    if !f.is_none("ret") { let rt = tn_text(f.node_of("ret")); o.append(format(" -> {rt}")); }
    return o;
}

// ---- destructors ----------------------------------------------------------------------------------------------

pub fn plain_tname_is(a: *ast.Node, tp: str) -> bool {
    if a.kind != "TName" { return false; }
    let p = a.get("path");
    return p.items.len == 1 && a.get("args").items.len == 0 && p.items.at(0).s == tp;
}

// does `args` (type nodes) spell exactly the names `tps`, in order?
pub fn args_match(args: *ast.Val, tps: *List<String>) -> bool {
    if args.items.len != tps.len { return false; }
    for i in 0..tps.len { if !plain_tname_is(child(args, i), *tps.at(i)) { return false; } }
    return true;
}

pub fn angle(tps: *List<String>) -> String {
    if tps.len == 0 { return String.empty(); }
    let mut o = String.from("<");
    for i in 0..tps.len { if i > 0 { o.append(", "); } o.append(*tps.at(i)); }
    o.push('>');
    return o;
}

pub fn declare_drop(ck: *Checker, mi: i64, id: i64) {
    let dname = String.from(ck.nodes.at(id).str_of("drop_for"));
    let sp = ck.nodes.at(id).span;
    let st = lookup_sym(ck, mi, dname);
    if st < 0 || ck.syms.at(st).kind != "struct" {
        err(ck, mi, sp, format("cannot find struct `{dname}` in this module"),
            "destructors must be declared in the module that defines the type",
            format("write `drop {dname}(self) {{ ... }}` next to `struct {dname}`"), "");
        return;
    }
    if ck.syms.at(st).opaque {
        err(ck, mi, sp, format("`{ck.syms.at(st).name}` is an opaque C type and cannot have a destructor"), "",
            format("give the wrapper struct a destructor instead, e.g. one that holds a `*{ck.syms.at(st).name}`"), "");
        return;
    }
    if ck.syms.at(st).drop_sym >= 0 {
        err(ck, mi, sp, format("`{ck.syms.at(st).name}` already has a destructor"), "", "",
            format("the first one is at line {node_line(ck, ck.syms.at(st).drop_sym)}"));
        return;
    }
    let n_expect = ck.syms.at(st).tparams.len;
    let tys = ck.nodes.at(id).get("tparams");
    let mut itps = names_of(tys);
    let ty = child(ck.nodes.at(id).get("params"), 0).node_of("tyn").node_of("inner");
    let args = ty.get("args");
    let ok = itps.len == n_expect && args.items.len == n_expect && args_match(args, &itps);
    if !ok {
        let sname = String.from(ck.syms.at(st).name);
        let want = angle(&ck.syms.at(st).tparams);
        if n_expect > 0 {
            err(ck, mi, sp, format("the destructor of `{sname}` must be generic over exactly the struct's type parameters"), "",
                format("write `drop{want} {sname}{want}(self) {{ ... }}`"), "");
        } else {
            err(ck, mi, sp, format("`{sname}` is not generic, so its destructor takes no type parameters"), "",
                format("write `drop{want} {sname}{want}(self) {{ ... }}`"), "");
        }
        return;
    }
    let fname = String.from(ck.nodes.at(id).str_of("name"));
    let mut s = new_sym(ck, "fn", fname, mi, id, false);
    s.tparams = itps;
    s.is_drop = true;
    let generic = s.tparams.len > 0;
    let sid = define(ck, mi, s, sp);
    if sid >= 0 {
        ck.syms.at(st).drop_sym = sid;
        if !generic { ck.fns.push(sid); }
    }
}

// ---- traits -------------------------------------------------------------------------------------------------------

pub fn bound_key(mi: i64, sp: ast.Span) -> String { return format("{mi}:{sp.line}:{sp.col}"); }

// the trait symbol a path like `Shape` / `shapes.Shape` names (an error and -1 otherwise)
pub fn resolve_trait(ck: *Checker, tn: *ast.Node, mi: i64, quiet_in: bool) -> i64 {
    let mut quiet = quiet_in;
    let mut path = path_of(tn);
    let mut sym = -1 as i64;
    if !quiet {
        let key = bound_key(mi, tn.span);
        if has_name(&ck.bound_seen, key) { quiet = true; }
        ck.bound_seen.push(key);
    }
    if path.len == 1 {
        sym = lookup_sym(ck, mi, *path.at(0));
        if sym < 0 && import_of(ck, mi, *path.at(0)) < 0 { sym = lookup_named(&ck.prelude_traits, *path.at(0)); }
    } else if path.len == 2 {
        let im = import_of(ck, mi, *path.at(0));
        if im < 0 {
            if !quiet {
                let p0 = String.from(*path.at(0));
                err(ck, mi, tn.span, format("cannot find module `{p0}`"), "", format("add `import {p0};` at the top of the file"), "");
            }
            return -1;
        }
        ck.cmods.at(mi).imports.at(im).used = true;
        let tm = ck.cmods.at(mi).imports.at(im).mod_idx;
        sym = lookup_sym(ck, tm, *path.at(1));
        if sym >= 0 && ck.syms.at(sym).kind == "trait" && !ck.syms.at(sym).is_pub && ck.syms.at(sym).mod_idx != mi {
            if !quiet {
                let p0 = String.from(*path.at(0));
                let p1 = String.from(*path.at(1));
                err(ck, mi, tn.span, format("trait `{p1}` is private to module `{p0}`"), "", "mark it `pub` in its module", "");
            }
            return -1;
        }
    }
    if sym >= 0 && ck.syms.at(sym).kind == "trait" { return sym; }
    if quiet { return -1; }
    let name = join_path(&path);
    if sym >= 0 {
        err(ck, mi, tn.span, format("`{name}` is a {ck.syms.at(sym).kind}, not a trait"), "expected a trait here", "", "");
        return -1;
    }
    let scope_mod = path.len == 1 ? mi : ck.cmods.at(mi).imports.at(import_of(ck, mi, *path.at(0))).mod_idx;
    let mut names: List<String> = List.new();
    let order = &ck.cmods.at(scope_mod).order;
    for i in 0..order.len {
        let sid = *order.at(i);
        if ck.syms.at(sid).kind == "trait" { names.push(String.from(ck.syms.at(sid).name)); }
    }
    let sg = diag.suggest_list(*path.at(path.len - 1), &names);
    err(ck, mi, tn.span, format("cannot find trait `{name}` in this scope"), "not found",
        sg.len > 0 ? format("a trait with a similar name exists: `{sg}`") : String.empty(), "");
    return -1;
}

pub fn same_sig(ck: *Checker, tf: *ast.Node, f: *ast.Node, tm: i64, mi: i64, selfc: str) -> bool {
    let tp = tf.get("params");
    let fp = f.get("params");
    if tp.items.len != fp.items.len { return false; }
    for i in 0..tp.items.len {
        let a = child(tp, i);
        let b = child(fp, i);
        let sa = param_flag(a, "self_param");
        let sb = param_flag(b, "self_param");
        if sa != sb || (sa && param_flag(a, "self_mut") != param_flag(b, "self_mut")) { return false; }
        if !sa && canon(ck, a.node_of("tyn"), tm, selfc, true) != canon(ck, b.node_of("tyn"), mi, selfc, true) { return false; }
    }
    let ra = tf.is_none("ret") ? String.from("void") : canon(ck, tf.node_of("ret"), tm, selfc, true);
    let rb = f.is_none("ret") ? String.from("void") : canon(ck, f.node_of("ret"), mi, selfc, true);
    return ra == rb;
}

pub fn find_timpl(ck: *Checker, trait_full: str, key: str) -> i64 {
    for i in 0..ck.trait_impls.len {
        if ck.trait_impls.at(i).trait_full == trait_full && ck.trait_impls.at(i).key == key { return i; }
    }
    return -1;
}

pub fn sorted_names(l: *List<String>) -> List<String> {
    let mut o: List<String> = List.new();
    for i in 0..l.len { o.push(String.from(*l.at(i))); }
    for i in 0..o.len {
        for j in i + 1..o.len {
            let a: str = *o.at(i);
            let b: str = *o.at(j);
            if b.compare(a) < 0 {
                let t = String.from(a);
                o.set(i, String.from(b));
                o.set(j, t);
            }
        }
    }
    return o;
}

// the TraitFn node `name` of trait `tr` (its last declaration)
pub fn trait_fn(ck: *Checker, tr: i64, name: str) -> *ast.Node {
    let tms = &ck.syms.at(tr).trait_methods;
    for i in 0..tms.len {
        if tms.at(i).name == name { return child(ck.nodes.at(ck.syms.at(tr).node).get("methods"), tms.at(i).node); }
    }
    panic("no such trait method");
}

pub fn has_trait_fn(ck: *Checker, tr: i64, name: str) -> bool {
    let tms = &ck.syms.at(tr).trait_methods;
    for i in 0..tms.len { if tms.at(i).name == name { return true; } }
    return false;
}

// Checks an `impl Trait for Type` block; returns the functions to register (the impl's own plus the trait's default
// methods it does not override). `ok` is false after an error that stops the impl.
pub fn conform(ck: *Checker, mi: i64, it_id: i64, trait: i64, key: str, tname: str, fns: List<ast.Node>, ok: *bool) -> List<ast.Node> {
    let tm = ck.syms.at(trait).mod_idx;
    let trait_full = String.from(ck.syms.at(trait).full);
    let trait_name = String.from(ck.syms.at(trait).name);
    let it_span = ck.nodes.at(it_id).span;
    let mut itps = names_of(ck.nodes.at(it_id).get("tparams"));
    let mut shown = String.from(tname);
    if itps.len > 0 { shown = format("{tname}{angle(&itps)}"); }
    let prev = find_timpl(ck, trait_full, key);
    if prev >= 0 {
        err(ck, mi, it_span, format("`{shown}` already implements the trait `{trait_name}`"), "conflicting implementation", "",
            format("the first `impl` is at line {ck.trait_impls.at(prev).line}"));
        *ok = false;
        return List.new();
    }
    let mut strays: List<i64> = List.new();
    let selfc = canon(ck, ck.nodes.at(it_id).node_of("tyn"), mi, "", false);
    let mut have: List<String> = List.new();
    for i in 0..fns.len {
        let f = fns.at(i);
        let fname = String.from(f.str_of("name"));
        if has_name(&have, fname) {
            err(ck, mi, f.span, format("the method `{fname}` is defined more than once in this `impl`"), "", "", "");
            strays.push(i);
            continue;
        }
        have.push(String.from(fname));
        if !has_trait_fn(ck, trait, fname) {
            let mut avail: List<String> = List.new();
            for q in 0..ck.syms.at(trait).trait_methods.len { avail.push(String.from(ck.syms.at(trait).trait_methods.at(q).name)); }
            let mut sorted = sorted_names(&avail);
            let sg = diag.suggest_list(fname, &sorted);
            err(ck, mi, f.span, format("`{fname}` is not a member of the trait `{trait_name}`"), "not in the trait",
                sg.len > 0 ? format("did you mean `{sg}`?") : format("declare it in `trait {trait_name}`, or move it to a plain `impl {tname} {{ ... }}` block"), "");
            strays.push(i);
            continue;
        }
        let tf = trait_fn(ck, trait, fname);
        if !same_sig(ck, tf, f, tm, mi, selfc) {
            let n1 = format("the trait declares `{sig_text(tf)}` at line {tf.span.line}");
            let n2 = format("this impl has `{sig_text(f)}`");
            err(ck, mi, f.span, format("the method `{fname}` does not match its declaration in the trait `{trait_name}`"),
                "different signature", "make the receiver, the parameter types and the return type agree with the trait",
                format("{n1} ## {n2}"));
        }
    }
    let mut missing: List<String> = List.new();
    for q in 0..ck.syms.at(trait).trait_methods.len {
        let n = String.from(ck.syms.at(trait).trait_methods.at(q).name);
        if trait_fn(ck, trait, n).is_none("body") && !has_name(&have, n) { missing.push(n); }
    }
    if missing.len > 0 {
        let mut list = String.empty();
        let mut notes = String.empty();
        for q in 0..missing.len {
            if q > 0 { list.append(", "); notes.append(" ## "); }
            let mn = String.from(*missing.at(q));
            let ml = trait_fn(ck, trait, mn).span.line;
            list.append(format("`{mn}`"));
            notes.append(format("`{mn}` is declared at line {ml} of the trait"));
        }
        let m0 = String.from(*missing.at(0));
        err(ck, mi, it_span, format("not all required methods of `{trait_name}` are implemented for `{shown}`: {list}"),
            "missing implementations", format("add `fn {m0}(...) {{ ... }}` to this `impl`"), notes);
    }
    let mut out: List<ast.Node> = List.new();
    for i in 0..fns.len {
        let mut stray = false;
        for q in 0..strays.len { if *strays.at(q) == i { stray = true; } }
        if !stray { out.push(ast.clone_node(fns.at(i))); }
    }
    for q in 0..ck.syms.at(trait).trait_methods.len {
        let n = String.from(ck.syms.at(trait).trait_methods.at(q).name);
        let tf = trait_fn(ck, trait, n);
        if !tf.is_none("body") && !has_name(&have, n) {
            let lo = tf.get("tok_lo").i;
            let hi = tf.get("tok_hi").i;
            let mut perrs: List<lexer.Diag> = List.new();
            let node = parser.parse_default(ck.ld.mods.at(tm).text, lo, hi, ck.nodes.at(it_id).node_of("tyn"), &perrs);
            ck.d.file = String.from(ck.ld.mods.at(tm).shown);
            for e in perrs { ck.d.add_error(e.line, e.col, 1, e.msg, "", ""); }
            let mut node2 = node;
            node2.put_str("default_of", trait_name);
            node2.put_int("src_mod", tm);
            out.push(node2);
        }
    }
    let info = TImpl { trait_full: trait_full, trait_sym: trait, key: String.from(key), tparams: itps,
                       bounds: ast.clone_val(ck.nodes.at(it_id).get("tbounds")), node: it_id, mod_idx: mi,
                       line: it_span.line, col: it_span.col, len: it_span.len };
    ck.trait_impls.push(info);
    *ok = true;
    return out;
}

// ---- impls -----------------------------------------------------------------------------------------------------------

pub fn find_table(ck: *Checker, key: str) -> i64 {
    for i in 0..ck.methods.len { if ck.methods.at(i).key == key { return i; } }
    ck.methods.push(MethTab { key: String.from(key), entries: List.new() });
    return ck.methods.len - 1;
}

pub fn table_get(ck: *Checker, t: i64, name: str) -> i64 {
    let e = &ck.methods.at(t).entries;
    for i in 0..e.len { if e.at(i).name == name { return e.at(i).sym; } }
    return -1;
}

// `{**a, **b}` for two `tbounds` dict values
pub fn merge_tbounds(a: *ast.Val, b: *ast.Val) -> ast.Val {
    let mut out = ast.clone_val(a);
    let mut i = 0 as i64;
    while i < b.items.len {
        let mut found = -1 as i64;
        let mut k = 0 as i64;
        while k < out.items.len {
            if out.items.at(k).s == b.items.at(i).s { found = k; }
            k += 2;
        }
        if found >= 0 { out.items.set(found + 1, ast.clone_val(b.items.at(i + 1))); }
        else {
            out.items.push(ast.clone_val(b.items.at(i)));
            out.items.push(ast.clone_val(b.items.at(i + 1)));
        }
        i += 2;
    }
    return out;
}

pub fn declare_impl(ck: *Checker, mi: i64, id: i64) {
    let tyn_span = ck.nodes.at(id).node_of("tyn").span;
    let mut path = path_of(ck.nodes.at(id).node_of("tyn"));
    let nargs = ck.nodes.at(id).node_of("tyn").get("args").items.len;
    let mut itps = names_of(ck.nodes.at(id).get("tparams"));
    let mut sym = -1 as i64;
    let mut key = String.empty();
    if path.len == 1 && is_prim_name(*path.at(0)) && *path.at(0) != "void" {
        key = String.from(*path.at(0));
        if nargs > 0 || itps.len > 0 {
            err(ck, mi, tyn_span, format("`{key}` is not generic, so its `impl` takes no type parameters"), "", "", "");
            return;
        }
    } else {
        if path.len == 1 {
            sym = lookup_sym(ck, mi, *path.at(0));
            if sym < 0 { sym = lookup_named(&ck.prelude_types, *path.at(0)); }
        } else if path.len == 2 {
            let im = import_of(ck, mi, *path.at(0));
            if im >= 0 {
                ck.cmods.at(mi).imports.at(im).used = true;
                sym = lookup_sym(ck, ck.cmods.at(mi).imports.at(im).mod_idx, *path.at(1));
            }
        }
        if sym < 0 || (ck.syms.at(sym).kind != "struct" && ck.syms.at(sym).kind != "enum") {
            let pj = join_path(&path);
            err(ck, mi, tyn_span, format("cannot find the type `{pj}` to attach methods to"),
                "not a struct, enum or built-in type", "", "");
            return;
        }
        if ck.syms.at(sym).kind == "struct" && ck.syms.at(sym).opaque {
            err(ck, mi, tyn_span, format("`{ck.syms.at(sym).name}` is an opaque C type and cannot have methods"), "",
                "wrap it in a Crumbs struct and put the methods there", "");
            return;
        }
        key = String.from(ck.syms.at(sym).full);
        let stps = &ck.syms.at(sym).tparams;
        let ok = nargs == stps.len && stps.len == itps.len && args_match(ck.nodes.at(id).node_of("tyn").get("args"), &itps);
        if !ok {
            let sname = String.from(ck.syms.at(sym).name);
            let want = angle(stps);
            if stps.len > 0 {
                err(ck, mi, tyn_span, format("an `impl` for `{sname}` must be generic over exactly its type parameters"), "",
                    format("write `impl{want} {sname}{want} {{ ... }}`"), "");
            } else {
                err(ck, mi, tyn_span, format("`{sname}` is not generic, so its `impl` takes no type parameters"), "",
                    format("write `impl{want} {sname}{want} {{ ... }}`"), "");
            }
            return;
        }
    }
    let table = find_table(ck, key);
    let tname = String.from(*path.at(path.len - 1));
    let mut fns: List<ast.Node> = List.new();
    let nf = ck.nodes.at(id).get("fns").items.len;
    for i in 0..nf { fns.push(ast.clone_node(child(ck.nodes.at(id).get("fns"), i))); }
    let mut has_trait = false;
    if !ck.nodes.at(id).is_none("trait") {
        has_trait = true;
        let trait = resolve_trait(ck, ck.nodes.at(id).node_of("trait"), mi, false);
        if trait < 0 { return; }
        let mut ok = false;
        fns = conform(ck, mi, id, trait, key, tname, fns, &ok);
        if !ok { return; }
    }
    let mut impl_tbounds = ast.clone_val(ck.nodes.at(id).get("tbounds"));
    let rec = ck.impl_recs.len;
    ck.impl_recs.push(ImplRec { item: id, fn_nodes: List.new(), fn_idx: List.new() });
    for i in 0..fns.len {
        let fname = String.from(fns.at(i).str_of("name"));
        let fsp = fns.at(i).span;
        let old = table_get(ck, table, fname);
        if old >= 0 {
            err(ck, mi, fsp, format("`{tname}` already has a method named `{fname}`"), "", "",
                format("the first one is at line {node_line(ck, old)}"));
            continue;
        }
        let f_pub = fns.at(i).get("pub").i != 0;
        let mut node = ast.clone_node(fns.at(i));
        let full_name = format("{tname}.{fname}");
        node.set("name", ast.v_str(full_name));
        let mut tp = names_of(ck.nodes.at(id).get("tparams"));
        let fps = names_of(fns.at(i).get("tparams"));
        for q in 0..fps.len { tp.push(String.from(*fps.at(q))); }
        node.set("tparams", ast.v_list(strs_vals(&tp)));
        let mut ftb = fns.at(i).has("tbounds") ? ast.clone_val(fns.at(i).get("tbounds")) : empty_dict();
        node.set("tbounds", merge_tbounds(&impl_tbounds, &ftb));
        let params = fns.at(i).get("params");
        let has_self = params.items.len > 0 && child(params, 0).str_of("name") == "self";
        let self_mut = has_self && (param_flag(child(params, 0), "self_mut") || param_flag(child(params, 0), "mut"));
        let nid = ck.nodes.len;
        ck.nodes.push(node);
        ck.impl_recs.at(rec).fn_nodes.push(nid);
        ck.impl_recs.at(rec).fn_idx.push(i);
        let mut s = new_sym(ck, "fn", full_name, mi, nid, f_pub || has_trait);
        s.tparams = tp;
        let prefix: str = ck.ld.mods.at(mi).cprefix;
        s.cname = format("{prefix}__{tname}__m_{fname}");
        s.is_method = true;
        s.method_name = String.from(fname);
        s.has_self = has_self;
        s.self_mut = self_mut;
        let generic = s.tparams.len > 0;
        let sid = define(ck, mi, s, fsp);
        if sid >= 0 {
            ck.methods.at(table).entries.push(MEnt { name: String.from(fname), sym: sid });
            if !generic { ck.fns.push(sid); }
        }
    }
}

pub fn empty_dict() -> ast.Val {
    let mut v = ast.v_list(List.new());
    v.tag = 9;
    return v;
}

pub fn strs_vals(l: *List<String>) -> List<ast.Val> {
    let mut o: List<ast.Val> = List.new();
    for i in 0..l.len { o.push(ast.v_str(*l.at(i))); }
    return o;
}

// ---- bounds and supertraits -------------------------------------------------------------------------------------------

pub fn resolve_bounds(ck: *Checker, mi: i64) {
    let mut snapshot: List<i64> = List.new();
    for i in 0..ck.cmods.at(mi).order.len { snapshot.push(*ck.cmods.at(mi).order.at(i)); }
    for si in 0..snapshot.len {
        let s = *snapshot.at(si);
        let skind = String.from(ck.syms.at(s).kind);
        if skind == "trait" {
            let n = ck.nodes.at(ck.syms.at(s).node).get("supers").items.len;
            for k in 0..n {
                let tn = child(ck.nodes.at(ck.syms.at(s).node).get("supers"), k);
                let sup = resolve_trait(ck, tn, mi, false);
                let mut known = false;
                for q in 0..ck.syms.at(s).supers.len { if *ck.syms.at(s).supers.at(q) == sup { known = true; } }
                if sup >= 0 && !known {
                    if sup == s {
                        err(ck, mi, tn.span, format("trait `{ck.syms.at(s).name}` cannot be its own supertrait"), "", "", "");
                    } else {
                        ck.syms.at(s).supers.push(sup);
                    }
                }
            }
            continue;
        }
        if skind != "fn" && skind != "struct" { continue; }
        let nd = ck.nodes.at(ck.syms.at(s).node);
        if !nd.has("tbounds") { continue; }
        let tb = nd.get("tbounds");
        if tb.items.len == 0 { continue; }
        ck.syms.at(s).has_bounds = true;
        let mut i = 0 as i64;
        while i < tb.items.len {
            let tp = String.from(tb.items.at(i).s);
            let tns = tb.items.at(i + 1);
            for k in 0..tns.items.len {
                let tr = resolve_trait(ck, child(tns, k), mi, false);
                if tr >= 0 {
                    let mut bi = -1 as i64;
                    for q in 0..ck.syms.at(s).bounds.len { if ck.syms.at(s).bounds.at(q).tp == tp { bi = q; } }
                    if bi < 0 {
                        ck.syms.at(s).bounds.push(BoundList { tp: String.from(tp), traits: List.new() });
                        bi = ck.syms.at(s).bounds.len - 1;
                    }
                    let mut dup = false;
                    for q in 0..ck.syms.at(s).bounds.at(bi).traits.len { if *ck.syms.at(s).bounds.at(bi).traits.at(q) == tr { dup = true; } }
                    if !dup { ck.syms.at(s).bounds.at(bi).traits.push(tr); }
                }
            }
            i += 2;
        }
    }
    let nitems = ck.cmods.at(mi).items.len;
    for k in 0..nitems {
        let id = *ck.cmods.at(mi).items.at(k);
        if ck.nodes.at(id).kind != "Impl" { continue; }
        let tb = ck.nodes.at(id).get("tbounds");
        let mut i = 0 as i64;
        while i < tb.items.len {
            let tns = tb.items.at(i + 1);
            for q in 0..tns.items.len { resolve_trait(ck, child(tns, q), mi, false); }
            i += 2;
        }
    }
}

// Every impl of a trait needs impls of that trait's supertraits; supertrait lists must not form a cycle.
pub fn check_trait_impls(ck: *Checker) {
    for ti in 0..ck.traits.len {
        let tr = *ck.traits.at(ti);
        let mut seen: List<String> = List.new();
        let mut stack: List<i64> = List.new();
        for q in 0..ck.syms.at(tr).supers.len { stack.push(*ck.syms.at(tr).supers.at(q)); }
        while stack.len > 0 {
            let x = stack.pop() catch { panic("unreachable"); };
            if x == tr {
                let tmi = ck.syms.at(tr).mod_idx;
                err(ck, tmi, ck.nodes.at(ck.syms.at(tr).node).span,
                    format("the supertraits of `{ck.syms.at(tr).name}` form a cycle"), "a trait cannot require itself", "", "");
                ck.syms.at(tr).supers = List.new();
                break;
            }
            if has_name(&seen, ck.syms.at(x).full) { continue; }
            seen.push(String.from(ck.syms.at(x).full));
            for q in 0..ck.syms.at(x).supers.len { stack.push(*ck.syms.at(x).supers.at(q)); }
        }
    }
    // in order of line number (the sort is stable)
    let mut order: List<i64> = List.new();
    for i in 0..ck.trait_impls.len { order.push(i); }
    for i in 1..order.len {
        let mut j = i;
        while j > 0 && ck.trait_impls.at(*order.at(j)).line < ck.trait_impls.at(*order.at(j - 1)).line {
            let t = *order.at(j);
            order.set(j, *order.at(j - 1));
            order.set(j - 1, t);
            j -= 1;
        }
    }
    for oi in 0..order.len {
        let info = ck.trait_impls.at(*order.at(oi));
        let tr = info.trait_sym;
        for q in 0..ck.syms.at(tr).supers.len {
            let sup = *ck.syms.at(tr).supers.at(q);
            if find_timpl(ck, ck.syms.at(sup).full, info.key) < 0 {
                let tn = ck.nodes.at(info.node).node_of("tyn");
                let tp = path_of(tn);
                let last = String.from(*tp.at(tp.len - 1));
                let sp = ast.span(info.line, info.col, info.len);
                err(ck, info.mod_idx, sp,
                    format("the trait `{ck.syms.at(tr).name}` requires `{ck.syms.at(sup).name}`, but `{last}` does not implement it"),
                    format("`{last}: {ck.syms.at(sup).name}` is required first"),
                    format("add `impl {ck.syms.at(sup).name} for {last} {{ ... }}`"), "");
            }
        }
    }
}

// the first phases of `Checker._run`
pub fn run_decl(ck: *Checker) {
    let n = ck.ld.order.len;
    for oi in 0..n {
        let mi = *ck.ld.order.at(oi);
        declare(ck, mi);
        let name = String.from(ck.ld.mods.at(mi).name);
        let is_std = ck.ld.mods.at(mi).is_std;
        if name == "std.list" && is_std && !ck.nostd {
            let s = lookup_sym(ck, mi, "List");
            if s >= 0 { ck.prelude_types.push(NameSym { name: String.from("List"), sym: s }); }
        }
        if name == "std.iter" && is_std && !ck.nostd {
            let names = ["Iter", "Pair", "Indexed"];
            for q in 0..3 {
                let s = lookup_sym(ck, mi, names[q]);
                if s >= 0 { ck.prelude_types.push(NameSym { name: String.from(names[q]), sym: s }); }
            }
        }
        if name == "std.fmt" && is_std && !ck.nostd {
            let s = lookup_sym(ck, mi, "Display");
            if s >= 0 { ck.prelude_traits.push(NameSym { name: String.from("Display"), sym: s }); }
        }
    }
    for oi in 0..n { resolve_bounds(ck, *ck.ld.order.at(oi)); }
    check_trait_impls(ck);
}

// ---- types: printing, instantiation, resolution -------------------------------------------------------------------------

pub fn ptr_pre(ro: bool) -> str { return ro ? "*const " : "*"; }
pub fn tk(ck: *Checker, t: i64) -> i64 { return ck.types.tys.at(t).kind; }

// the text of a type, as `Ty.__str__` prints it
pub fn ty_str(ck: *Checker, t: i64) -> String {
    let k = tk(ck, t);
    if k == types.K_PRIM { return String.from(ck.types.tys.at(t).name); }
    let inner = ck.types.tys.at(t).inner;
    if k == types.K_PTR { return format("{ptr_pre(ck.types.tys.at(t).ro)}{ty_str(ck, inner)}"); }
    if k == types.K_ARR { let n = ck.types.tys.at(t).n; return format("[{n}]{ty_str(ck, inner)}"); }
    if k == types.K_SLICE { return format("[]{ty_str(ck, inner)}"); }
    if k == types.K_EU { return format("{ty_str(ck, inner)}!"); }
    if k == types.K_OPT { return format("{ty_str(ck, inner)}?"); }
    if k == types.K_FN || k == types.K_CLO {
        let mut ps = String.empty();
        for i in 0..ck.types.tys.at(t).params.len {
            if i > 0 { ps.append(", "); }
            ps.append(ty_str(ck, *ck.types.tys.at(t).params.at(i)));
        }
        let rs = inner == types.VOID ? String.empty() : format(" -> {ty_str(ck, inner)}");
        if k == types.K_FN { return format("fn({ps}){rs}"); }
        return format("|{ps}|{rs}");
    }
    if k == types.K_STRUCT || k == types.K_ENUM { return String.from(ck.syms.at(ck.types.tys.at(t).sym).name); }
    if k == types.K_ERR { return String.from("err"); }
    if k == types.K_POISON { return String.from("poison"); }
    return String.from("never");
}

pub fn ty_key(ck: *Checker, t: i64) -> String { return String.from(ck.types.tys.at(t).key); }

// the key under which methods of `t` are registered ("" if none)
pub fn type_key(ck: *Checker, t: i64) -> String {
    let k = tk(ck, t);
    if k == types.K_PRIM { return String.from(ck.types.tys.at(t).name); }
    if k == types.K_STRUCT || k == types.K_ENUM {
        let mut s = ck.types.tys.at(t).sym;
        if ck.syms.at(s).base >= 0 { s = ck.syms.at(s).base; }
        return String.from(ck.syms.at(s).full);
    }
    return String.empty();
}

pub fn lower_first(s: str) -> String {
    let mut o = String.empty();
    for i in 0..s.len {
        let c = s[i];
        if i == 0 && c >= 'A' && c <= 'Z' { o.push(c + 32); } else { o.push(c); }
    }
    return o;
}

// the trait symbols named for type parameter `tp` in the header of impl `info`
pub fn bound_traits(ck: *Checker, info: i64, tp: str) -> List<i64> {
    let mut out: List<i64> = List.new();
    let mut i = 0 as i64;
    let mi = ck.trait_impls.at(info).mod_idx;
    while i < ck.trait_impls.at(info).bounds.items.len {
        if ck.trait_impls.at(info).bounds.items.at(i).s == tp {
            let n = ck.trait_impls.at(info).bounds.items.at(i + 1).items.len;
            for q in 0..n {
                let tn = ck.trait_impls.at(info).bounds.items.at(i + 1).items.at(q).node.at(0);
                let tr = resolve_trait(ck, tn, mi, true);
                if tr >= 0 { out.push(tr); }
            }
        }
        i += 2;
    }
    return out;
}

// does `ty` implement trait `tr`? when not, `why` holds a short reason
pub fn implements(ck: *Checker, ty: i64, tr: i64, why: *String) -> bool {
    let key = type_key(ck, ty);
    let trfull = String.from(ck.syms.at(tr).full);
    let info = key.len > 0 ? find_timpl(ck, trfull, key) : -1;
    if info < 0 {
        let ts = ty_str(ck, ty);
        *why = format("the type `{ts}` does not implement `{ck.syms.at(tr).name}`");
        return false;
    }
    if ck.trait_impls.at(info).bounds.items.len > 0 && tk(ck, ty) == types.K_STRUCT {
        let sid = ck.types.tys.at(ty).sym;
        if ck.syms.at(sid).base >= 0 {
            let ntp = ck.trait_impls.at(info).tparams.len;
            for k in 0..ntp {
                if k >= ck.syms.at(sid).targs.len { break; }
                let tp = String.from(*ck.trait_impls.at(info).tparams.at(k));
                let ta = *ck.syms.at(sid).targs.at(k);
                let needs = bound_traits(ck, info, tp);
                for q in 0..needs.len {
                    let need = *needs.at(q);
                    let mut why2 = String.empty();
                    if !implements(ck, ta, need, &why2) {
                        let ts = ty_str(ck, ty);
                        let lw = lower_first(why2);
                        *why = format("`{ts}` implements `{ck.syms.at(tr).name}` only when `{tp}: {ck.syms.at(need).name}`, but {lw}");
                        return false;
                    }
                }
            }
        }
    }
    return true;
}

// the type arguments chosen for `sid` must satisfy the `T: Trait` bounds on its type parameters
pub fn check_bounds(ck: *Checker, sid: i64, targs: *List<i64>, smi: i64, span: ast.Span) -> bool {
    if !ck.syms.at(sid).has_bounds { return true; }
    let mut ok = true;
    let ntp = ck.syms.at(sid).tparams.len;
    for k in 0..ntp {
        if k >= targs.len { break; }
        let tp = String.from(*ck.syms.at(sid).tparams.at(k));
        let ta = *targs.at(k);
        let mut trs: List<i64> = List.new();
        for b in 0..ck.syms.at(sid).bounds.len {
            if ck.syms.at(sid).bounds.at(b).tp == tp {
                for q in 0..ck.syms.at(sid).bounds.at(b).traits.len { trs.push(*ck.syms.at(sid).bounds.at(b).traits.at(q)); }
            }
        }
        for q in 0..trs.len {
            let tr = *trs.at(q);
            let mut why = String.empty();
            if implements(ck, ta, tr, &why) { continue; }
            ok = false;
            let kd: str = ck.syms.at(sid).kind;
            let what = kd == "struct" ? "struct" : (kd == "fn" ? "function" : "item");
            let tn = String.from(ck.syms.at(tr).name);
            let sname = String.from(ck.syms.at(sid).name);
            let tas = ty_str(ck, ta);
            let req = format("required by the bound `{tp}: {tn}` on the {what} `{sname}`");
            let notes = why.starts_with("the type") ? req : format("{why} ## {req}");
            let help = type_key(ck, ta).len > 0 ? format("implement it: `impl {tn} for {tas} {{ ... }}`")
                : format("only structs, enums and built-in types can implement a trait, so `{tas}` cannot satisfy `{tn}`");
            err(ck, smi, span, format("the trait bound `{tas}: {tn}` is not satisfied"), format("`{tas}` does not implement `{tn}`"), help, notes);
        }
    }
    return ok;
}

pub fn too_deep(ck: *Checker, key: str, smi: i64, span: ast.Span) -> bool {
    if key.len > 160 || ck.n_inst > 4000 {
        err(ck, smi, span, "generic instantiation recursion limit reached", "",
            "a generic type or function keeps instantiating itself with ever larger types", "");
        return true;
    }
    return false;
}

pub fn inst_key(ck: *Checker, full: str, targs: *List<i64>) -> String {
    let mut k = String.from(full);
    k.push('\x01');
    for i in 0..targs.len { if i > 0 { k.push('\x02'); } k.append(ty_key(ck, *targs.at(i))); }
    return k;
}

pub fn keys_joined(ck: *Checker, targs: *List<i64>) -> String {
    let mut k = String.empty();
    for i in 0..targs.len { k.append(ty_key(ck, *targs.at(i))); }
    return k;
}

pub fn tenv_of(ck: *Checker, sid: i64, targs: *List<i64>) -> List<NameTy> {
    let mut e: List<NameTy> = List.new();
    for i in 0..ck.syms.at(sid).tparams.len {
        if i >= targs.len { break; }
        e.push(NameTy { name: String.from(*ck.syms.at(sid).tparams.at(i)), ty: *targs.at(i) });
    }
    return e;
}

pub fn tenv_get(ck: *Checker, name: str) -> i64 {
    for i in 0..ck.tenv.len { if ck.tenv.at(i).name == name { return ck.tenv.at(i).ty; } }
    return -1;
}

// installs `env` as the type-parameter environment and returns the previous one
pub fn tenv_replace(ck: *Checker, env: List<NameTy>) -> List<NameTy> {
    let mut old: List<NameTy> = List.new();
    while ck.tenv.len > 0 { old.push(ck.tenv.pop() catch { panic("unreachable"); }); }
    old.reverse();
    for i in 0..env.len { ck.tenv.push(NameTy { name: String.from(env.at(i).name), ty: env.at(i).ty }); }
    return old;
}

pub fn find_field(ck: *Checker, sid: i64, name: str) -> i64 {
    for i in 0..ck.syms.at(sid).fields.len { if ck.syms.at(sid).fields.at(i).name == name { return i; } }
    return -1;
}

// a copy of generic function `sid` for `targs`, with its signature resolved (-1 when it could not be made)
pub fn inst_fn(ck: *Checker, sid: i64, targs: *List<i64>, smi: i64, span: ast.Span) -> i64 {
    let full = String.from(ck.syms.at(sid).full);
    let key = inst_key(ck, full, targs);
    let got = ck.inst_cache.get(key);
    if got != null { return *got; }
    let kj = keys_joined(ck, targs);
    if too_deep(ck, kj, smi, span) { return -1; }
    if !check_bounds(ck, sid, targs, smi, span) { return -1; }
    ck.n_inst += 1;
    let nid = ck.nodes.len;
    ck.nodes.push(ast.clone_node(ck.nodes.at(ck.syms.at(sid).node)));
    let name = String.from(ck.syms.at(sid).name);
    let mi = ck.syms.at(sid).mod_idx;
    let mut inst = new_sym(ck, "fn", name, mi, nid, ck.syms.at(sid).is_pub);
    let cn: str = ck.syms.at(sid).cname;
    inst.cname = format("{cn}__g{ck.n_inst}");
    inst.base = sid;
    for i in 0..targs.len { inst.targs.push(*targs.at(i)); }
    inst.tenv = tenv_of(ck, sid, targs);
    let iid = ck.syms.len;
    ck.syms.push(inst);
    ck.inst_cache.set(key, iid);
    let saved_mod = ck.cur_mod;
    let saved_env = tenv_replace(ck, tenv_of(ck, sid, targs));
    ck.cur_mod = mi;
    let np = ck.nodes.at(nid).get("params").items.len;
    for p in 0..np {
        let t = resolve_type(ck, ck.nodes.at(nid).get("params").items.at(p).node.at(0).node_of("tyn"), mi, false);
        ck.syms.at(iid).params.push(t);
    }
    let has_ret = !ck.nodes.at(nid).is_none("ret");
    let rt = has_ret ? resolve_type(ck, ck.nodes.at(nid).node_of("ret"), mi, true) : types.VOID;
    ck.syms.at(iid).ret = rt;
    ck.cur_mod = saved_mod;
    tenv_replace(ck, saved_env);
    ck.fns.push(iid);
    ck.pending.push(iid);
    return iid;
}

// the struct type for generic struct `sid` applied to `targs`
pub fn inst_struct(ck: *Checker, sid: i64, targs: *List<i64>, smi: i64, span: ast.Span, has_span: bool) -> i64 {
    let full = String.from(ck.syms.at(sid).full);
    let key = inst_key(ck, full, targs);
    let got = ck.inst_cache.get(key);
    if got != null { return ck.syms.at(*got).ty; }
    let kj = keys_joined(ck, targs);
    let nsp = ck.nodes.at(ck.syms.at(sid).node).span;
    if has_span && too_deep(ck, kj, smi, span) { return types.POISON; }
    if !check_bounds(ck, sid, targs, smi, has_span ? span : nsp) { return types.POISON; }
    ck.n_inst += 1;
    let name = String.from(ck.syms.at(sid).name);
    let mi = ck.syms.at(sid).mod_idx;
    let mut inst = new_sym(ck, "struct", name, mi, ck.syms.at(sid).node, ck.syms.at(sid).is_pub);
    let mut shown = String.empty();
    for i in 0..targs.len { if i > 0 { shown.append(", "); } shown.append(ty_str(ck, *targs.at(i))); }
    let mut keys = String.empty();
    for i in 0..targs.len { if i > 0 { keys.push(','); } keys.append(ty_key(ck, *targs.at(i))); }
    let sfull: str = ck.syms.at(sid).full;
    let scn: str = ck.syms.at(sid).cname;
    inst.name = format("{name}<{shown}>");
    inst.full = format("{sfull}<{keys}>");
    inst.cname = format("{scn}__g{ck.n_inst}");
    inst.base = sid;
    for i in 0..targs.len { inst.targs.push(*targs.at(i)); }
    let iid = ck.syms.len;
    let ifull: str = inst.full;
    ck.syms.push(inst);
    let t = types.sym_ty(&ck.types, types.K_STRUCT, iid, ifull);
    ck.syms.at(iid).ty = t;
    ck.inst_cache.set(key, iid);
    ck.structs.push(iid);
    let saved_mod = ck.cur_mod;
    let saved_env = tenv_replace(ck, tenv_of(ck, sid, targs));
    ck.cur_mod = mi;
    let nf = ck.nodes.at(ck.syms.at(sid).node).get("fields").items.len;
    for f in 0..nf {
        let fnode = ck.nodes.at(ck.syms.at(sid).node).get("fields").items.at(f).node.at(0);
        let ft = resolve_type(ck, fnode.node_of("tyn"), mi, false);
        let fname = String.from(fnode.str_of("name"));
        if find_field(ck, iid, fname) >= 0 { continue; }
        ck.syms.at(iid).fields.push(SField { name: fname, ty: ft, span: fnode.span });
    }
    ck.cur_mod = saved_mod;
    tenv_replace(ck, saved_env);
    if ck.syms.at(iid).fields.len == 0 {
        err(ck, mi, nsp, format("struct `{name}` has no fields"), "", "", "");
    }
    if ck.syms.at(sid).drop_sym >= 0 {
        let ds = ck.syms.at(sid).drop_sym;
        let dsp = has_span ? span : nsp;
        let di = inst_fn(ck, ds, targs, has_span ? smi : mi, dsp);
        ck.syms.at(iid).drop_inst = di;
    }
    return t;
}

pub fn use_type_sym(ck: *Checker, sid: i64, args: *ast.Val, tn: *ast.Node, mi: i64) -> i64 {
    let ntp = ck.syms.at(sid).tparams.len;
    let name = String.from(ck.syms.at(sid).name);
    if ntp > 0 {
        if ck.syms.at(sid).kind != "struct" { return types.POISON; }
        if args.items.len != ntp {
            let mut tps = String.empty();
            for i in 0..ntp { if i > 0 { tps.append(", "); } tps.append(*ck.syms.at(sid).tparams.at(i)); }
            let pl = ntp != 1 ? "s" : "";
            err(ck, mi, tn.span, format("struct `{name}` expects {ntp} type argument{pl}, found {args.items.len}"), "",
                format("write `{name}<{tps}>` with concrete types"), "");
            return types.POISON;
        }
        let mut ts: List<i64> = List.new();
        for i in 0..args.items.len { ts.push(resolve_type(ck, args.items.at(i).node.at(0), mi, false)); }
        for i in 0..ts.len { if *ts.at(i) == types.POISON { return types.POISON; } }
        return inst_struct(ck, sid, &ts, mi, tn.span, true);
    }
    if args.items.len > 0 {
        err(ck, mi, tn.span, format("`{name}` is not generic and takes no type arguments"), "", "", "");
        return types.POISON;
    }
    return ck.syms.at(sid).ty;
}

// an opaque C type used by value is an error
pub fn sized(ck: *Checker, t_in: i64, mi: i64, sp: ast.Span) -> bool {
    let mut t = t_in;
    while tk(ck, t) == types.K_ARR { t = ck.types.tys.at(t).inner; }
    if tk(ck, t) == types.K_STRUCT {
        let s = ck.types.tys.at(t).sym;
        if ck.syms.at(s).opaque {
            let n = String.from(ck.syms.at(s).name);
            err(ck, mi, sp, format("`{n}` is an opaque C type, so it cannot be used by value"), "its size is unknown",
                format("use a pointer: `*{n}`"), "");
            return false;
        }
    }
    return true;
}

pub fn need_std(ck: *Checker, mi: i64, sp: ast.Span, what: str) {
    err(ck, mi, sp, format("{what} needs the standard runtime, which `--no-stdruntime` removes"), "not available in this build",
        "drop --no-stdruntime, or call the C library yourself through `extern fn`", "");
}

pub fn resolve_type(ck: *Checker, tn: *ast.Node, mi: i64, allow_void: bool) -> i64 {
    let k: str = tn.kind;
    if k == "TName" {
        let path = path_of(tn);
        let mut noargs = ast.v_list(List.new());
        let args = tn.has("args") ? tn.get("args") : &noargs;
        if path.len == 1 {
            let n = String.from(*path.at(0));
            let te = tenv_get(ck, n);
            if te >= 0 {
                if args.items.len > 0 {
                    err(ck, mi, tn.span, format("type parameter `{n}` does not take type arguments"), "", "", "");
                    return types.POISON;
                }
                return te;
            }
            if is_prim_name(n) {
                if args.items.len > 0 {
                    err(ck, mi, tn.span, format("type `{n}` does not take type arguments"), "", "", "");
                    return types.POISON;
                }
                if n == "void" && !allow_void {
                    err(ck, mi, tn.span, "`void` is not allowed here", "", "`void` can only be a return type", "");
                    return types.POISON;
                }
                if ck.nostd && n == "String" {
                    need_std(ck, mi, tn.span, "`String`");
                    return types.POISON;
                }
                return types.prim_named(n);
            }
            if n == "error" { return types.ERR; }
            let mut sym = lookup_sym(ck, mi, n);
            if sym < 0 && import_of(ck, mi, n) < 0 { sym = lookup_named(&ck.prelude_types, n); }
            if sym >= 0 && (ck.syms.at(sym).kind == "struct" || ck.syms.at(sym).kind == "enum") {
                return use_type_sym(ck, sym, args, tn, mi);
            }
            if sym >= 0 && ck.syms.at(sym).kind == "trait" {
                err(ck, mi, tn.span, format("`{n}` is a trait, not a type"), "traits cannot be used as types",
                    format("use it as a bound instead: `fn f<T: {n}>(x: T)`"), "");
                return types.POISON;
            }
            if import_of(ck, mi, n) >= 0 {
                err(ck, mi, tn.span, format("expected a type, found module `{n}`"), "", format("use `{n}.TypeName`"), "");
                return types.POISON;
            }
            let mut cands: List<String> = List.new();
            let cm = ck.cmods.at(mi);
            for q in 0..cm.order.len {
                let s = ck.syms.at(*cm.order.at(q));
                if s.kind == "struct" || s.kind == "enum" { cands.push(String.from(s.name)); }
            }
            let pn = ["i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64", "f32", "f64", "bool", "str", "String", "void"];
            for q in 0..14 { cands.push(String.from(pn[q])); }
            for q in 0..ck.tenv.len { cands.push(String.from(ck.tenv.at(q).name)); }
            let sg = diag.suggest_list(n, &cands);
            err(ck, mi, tn.span, format("cannot find type `{n}` in this scope"), "",
                sg.len > 0 ? format("a type with a similar name exists: `{sg}`") : String.empty(), "");
            return types.POISON;
        }
        if path.len == 2 {
            let im = import_of(ck, mi, *path.at(0));
            let p0 = String.from(*path.at(0));
            let p1 = String.from(*path.at(1));
            if im < 0 {
                err(ck, mi, tn.span, format("cannot find module `{p0}`"), "", format("add `import {p0};` at the top of the file"), "");
                return types.POISON;
            }
            ck.cmods.at(mi).imports.at(im).used = true;
            let tm = ck.cmods.at(mi).imports.at(im).mod_idx;
            let sym = lookup_sym(ck, tm, p1);
            if sym < 0 || (ck.syms.at(sym).kind != "struct" && ck.syms.at(sym).kind != "enum") {
                err(ck, mi, tn.span, format("module `{p0}` has no type `{p1}`"), "", "", "");
                return types.POISON;
            }
            if !ck.syms.at(sym).is_pub && ck.syms.at(sym).mod_idx != mi {
                err(ck, mi, tn.span, format("type `{p1}` is private to module `{p0}`"), "", "mark it `pub` in its module", "");
                return types.POISON;
            }
            return use_type_sym(ck, sym, args, tn, mi);
        }
        err(ck, mi, tn.span, "type paths can have at most one module qualifier", "", "", "");
        return types.POISON;
    }
    if k == "TPtr" {
        let inner = resolve_type(ck, tn.node_of("inner"), mi, true);
        if inner == types.POISON { return types.POISON; }
        return types.ptr(&ck.types, inner, param_flag(tn, "ro"));
    }
    if k == "TFn" || k == "TClo" {
        let mut ps: List<i64> = List.new();
        let np = tn.get("params").items.len;
        for i in 0..np { ps.push(resolve_type(ck, tn.get("params").items.at(i).node.at(0), mi, false)); }
        let ret = tn.is_none("ret") ? types.VOID : resolve_type(ck, tn.node_of("ret"), mi, true);
        let mut bad = ret == types.POISON;
        for i in 0..ps.len { if *ps.at(i) == types.POISON { bad = true; } }
        if bad { return types.POISON; }
        if k == "TFn" { return types.fnty(&ck.types, &ps, ret); }
        return types.clo(&ck.types, &ps, ret);
    }
    if k == "TSlice" {
        let inner = resolve_type(ck, tn.node_of("inner"), mi, false);
        if inner == types.POISON { return types.POISON; }
        return types.slc(&ck.types, inner);
    }
    if k == "TArray" {
        let inner = resolve_type(ck, tn.node_of("inner"), mi, false);
        let size = tn.node_of("size");
        let v = const_eval(ck, size, mi);
        if ck.nc {
            ck.nc = false;
            err(ck, ck.nc_mi, ck.nc_span, ck.nc_msg, "", "", "");
            return types.POISON;
        }
        if v.kind != 0 {
            err(ck, mi, size.span, "array length must be an integer constant", "", "", "");
            return types.POISON;
        }
        if v.i <= 0 {
            err(ck, mi, size.span, "array length must be at least 1", "", "", "");
            return types.POISON;
        }
        if v.i > 2147483648 {
            err(ck, mi, size.span, "array length is too large", "", "", "");
            return types.POISON;
        }
        if inner == types.POISON || !sized(ck, inner, mi, tn.span) { return types.POISON; }
        return types.arr(&ck.types, inner, v.i);
    }
    if k == "TOpt" {
        let inner = resolve_type(ck, tn.node_of("inner"), mi, false);
        if inner == types.POISON { return types.POISON; }
        let ik = tk(ck, inner);
        if ik == types.K_EU || ik == types.K_OPT {
            let s = ty_str(ck, inner);
            err(ck, mi, tn.span, format("`{s}?` is not allowed: optional and error types cannot be stacked"), "",
                "use one of them, or wrap one in a struct", "");
            return types.POISON;
        }
        return types.opt(&ck.types, inner);
    }
    if k == "TErrUnion" {
        let inner = resolve_type(ck, tn.node_of("inner"), mi, true);
        if inner == types.POISON { return types.POISON; }
        if tk(ck, inner) == types.K_EU {
            err(ck, mi, tn.span, "error unions cannot be nested", "", "", "");
            return types.POISON;
        }
        return types.eu(&ck.types, inner);
    }
    panic("unknown type node");
}

// ---- constants --------------------------------------------------------------------------------------------------------

pub fn nc_raise(ck: *Checker, mi: i64, sp: ast.Span, msg: str) {
    ck.nc = true;
    ck.nc_mi = mi;
    ck.nc_span = sp;
    ck.nc_msg = String.from(msg);
}

pub fn cv_int(i: i64) -> CVal { return CVal { kind: 0, i: i, s: String.empty(), f: 0.0 }; }
pub fn cv_bool(b: bool) -> CVal { return CVal { kind: 2, i: b ? 1 : 0, s: String.empty(), f: 0.0 }; }
pub fn cv_float(f: f64) -> CVal { return CVal { kind: 1, i: 0, s: String.empty(), f: f }; }
pub fn cv_asf(v: *CVal) -> f64 { return v.kind == 1 ? v.f : (v.i as f64); }
pub fn parse_float(text: str) -> f64 { return strtod(cstr(text), 0 as *void); }

pub fn cv_copy(v: *CVal) -> CVal { return CVal { kind: v.kind, i: v.i, s: String.from(v.s), f: v.f }; }

pub fn cv_truth(v: *CVal) -> bool {
    if v.kind == 3 { return v.s.len > 0; }
    if v.kind == 1 { return true; }
    return v.i != 0;
}

pub fn const_value(ck: *Checker, sid: i64) -> CVal {
    if ck.syms.at(sid).evaluated { return cv_copy(&ck.syms.at(sid).cv); }
    let mi = ck.syms.at(sid).mod_idx;
    let nsp = ck.nodes.at(ck.syms.at(sid).node).span;
    let name = String.from(ck.syms.at(sid).name);
    if ck.syms.at(sid).is_extern {
        nc_raise(ck, mi, nsp, format("`{name}` is defined in C, so its value is not known at compile time"));
        return cv_int(0);
    }
    if ck.syms.at(sid).evaluating {
        nc_raise(ck, mi, nsp, format("constant `{name}` depends on itself"));
        return cv_int(0);
    }
    ck.syms.at(sid).evaluating = true;
    let mut v = const_eval(ck, ck.nodes.at(ck.syms.at(sid).node).node_of("init"), mi);
    ck.syms.at(sid).evaluating = false;
    if ck.nc { return cv_int(0); }
    ck.syms.at(sid).evaluated = true;
    ck.syms.at(sid).cv = cv_copy(&v);
    return v;
}

pub fn wrap_int(v: i64, t: i64) -> i64 {
    let b = types.bits(t);
    if b == 64 { return v; }
    let mask = (1 as i64 << b) - 1;
    let mut r = v & mask;
    if types.signed(t) && r >= (1 as i64 << (b - 1)) { r -= 1 as i64 << b; }
    return r;
}

pub fn const_eval(ck: *Checker, e: *ast.Node, mi: i64) -> CVal {
    let k: str = e.kind;
    if k == "Int" {
        let v = e.get("value");
        if v.s.len > 0 {
            let s: str = v.s;
            let mut x: u64 = 0;
            for i in 0..s.len { x = x * 10 + ((s[i] - 48) as u64); }
            return cv_int(x as i64);
        }
        return cv_int(v.i);
    }
    if k == "Float" { return cv_float(parse_float(e.get("value").s)); }
    if k == "Bool" { return cv_bool(e.get("value").i != 0); }
    if k == "Str" { return CVal { kind: 3, i: 0, s: String.from(e.get("value").s), f: 0.0 }; }
    if k == "Ident" {
        let name = String.from(e.str_of("name"));
        let s = lookup_sym(ck, mi, name);
        if s >= 0 && ck.syms.at(s).kind == "const" { return const_value(ck, s); }
        nc_raise(ck, mi, e.span, format("`{name}` is not a constant"));
        return cv_int(0);
    }
    if k == "Field" && e.node_of("obj").kind == "Ident" && import_of(ck, mi, e.node_of("obj").str_of("name")) >= 0 {
        let alias = String.from(e.node_of("obj").str_of("name"));
        let name = String.from(e.str_of("name"));
        let im = import_of(ck, mi, alias);
        let tm = ck.cmods.at(mi).imports.at(im).mod_idx;
        let s = lookup_sym(ck, tm, name);
        if s >= 0 && ck.syms.at(s).kind == "const" && (ck.syms.at(s).is_pub || tm == mi) {
            ck.cmods.at(mi).imports.at(im).used = true;
            return const_value(ck, s);
        }
        nc_raise(ck, mi, e.span, format("`{alias}.{name}` is not a public constant"));
        return cv_int(0);
    }
    if k == "Unary" {
        let v = const_eval(ck, e.node_of("expr"), mi);
        if ck.nc { return v; }
        let op: str = e.str_of("op");
        if op == "-" && v.kind != 2 && v.kind != 3 {
            if v.kind == 1 { return cv_float(0.0 - v.f); }
            return cv_int(0 - v.i);
        }
        if op == "!" && v.kind == 2 { return cv_bool(v.i == 0); }
        if op == "~" && v.kind == 0 { return cv_int(~v.i); }
        nc_raise(ck, mi, e.span, "operator not allowed in a constant expression");
        return cv_int(0);
    }
    if k == "Binary" {
        let mut a = const_eval(ck, e.node_of("l"), mi);
        if ck.nc { return a; }
        let mut b = const_eval(ck, e.node_of("r"), mi);
        if ck.nc { return b; }
        let op: str = e.str_of("op");
        if op == "&&" { return cv_truth(&a) ? b : a; }
        if op == "||" { return cv_truth(&a) ? a : b; }
        if a.kind == 3 || b.kind == 3 {
            if op == "==" { return cv_bool(a.kind == b.kind && a.s == b.s); }
            if op == "!=" { return cv_bool(!(a.kind == b.kind && a.s == b.s)); }
            nc_raise(ck, mi, e.span, "operator not allowed on strings in a constant expression");
            return cv_int(0);
        }
        let fl = a.kind == 1 || b.kind == 1;
        let x = a.i;
        let y = b.i;
        let fa = cv_asf(&a);
        let fb = cv_asf(&b);
        if op == "+" { return fl ? cv_float(fa + fb) : cv_int(x + y); }
        if op == "-" { return fl ? cv_float(fa - fb) : cv_int(x - y); }
        if op == "*" { return fl ? cv_float(fa * fb) : cv_int(x * y); }
        if op == "/" || op == "%" {
            if fl { return cv_float(fa / fb); }
            if y == 0 {
                nc_raise(ck, mi, e.span, "division by zero in constant expression");
                return cv_int(0);
            }
            return cv_int(op == "/" ? x / y : x % y);
        }
        if op == "<<" {
            if y < 0 || y >= 63 { return cv_int(x == 0 ? 0 : 9223372036854775807); }
            return cv_int(x << y);
        }
        if op == ">>" {
            if y < 0 || y >= 64 { return cv_int(x < 0 ? -1 : 0); }
            return cv_int(x >> y);
        }
        if op == "&" { return cv_int(x & y); }
        if op == "|" { return cv_int(x | y); }
        if op == "^" { return cv_int(x ^ y); }
        if fl { return cv_bool(false); }
        if op == "==" { return cv_bool(x == y); }
        if op == "!=" { return cv_bool(x != y); }
        if op == "<" { return cv_bool(x < y); }
        if op == ">" { return cv_bool(x > y); }
        if op == "<=" { return cv_bool(x <= y); }
        if op == ">=" { return cv_bool(x >= y); }
        nc_raise(ck, mi, e.span, "operator not allowed in a constant expression");
        return cv_int(0);
    }
    if k == "Cast" {
        let mut v = const_eval(ck, e.node_of("expr"), mi);
        if ck.nc { return v; }
        let tn = e.node_of("tyn");
        if tn.kind == "TName" && tn.get("path").items.len == 1 && is_prim_name(tn.get("path").items.at(0).s) {
            let t = types.prim_named(tn.get("path").items.at(0).s);
            if types.is_int(t) && v.kind != 3 { return cv_int(wrap_int(v.i, t)); }
            if types.is_float(t) && v.kind != 3 { return cv_float(cv_asf(&v)); }
        }
        nc_raise(ck, mi, e.span, "cast not allowed in a constant expression");
        return cv_int(0);
    }
    nc_raise(ck, mi, e.span, "this expression is not a compile-time constant");
    return cv_int(0);
}

// ---- signatures -----------------------------------------------------------------------------------------------------------

pub fn resolve_sigs(ck: *Checker, mi: i64) {
    ck.cur_mod = mi;
    let nsyms = ck.cmods.at(mi).order.len;
    for q in 0..nsyms {
        let sid = *ck.cmods.at(mi).order.at(q);
        let nid = ck.syms.at(sid).node;
        if ck.syms.at(sid).tparams.len > 0 { continue; }
        let kd = String.from(ck.syms.at(sid).kind);
        let name = String.from(ck.syms.at(sid).name);
        if kd == "fn" {
            let mut seen: List<String> = List.new();
            let np = ck.nodes.at(nid).get("params").items.len;
            for pi in 0..np {
                let p = ck.nodes.at(nid).get("params").items.at(pi).node.at(0);
                let tyn = p.node_of("tyn");
                let mut t = resolve_type(ck, tyn, mi, false);
                if t != types.POISON && !sized(ck, t, mi, tyn.span) { t = types.POISON; }
                ck.syms.at(sid).params.push(t);
                let pname = String.from(p.str_of("name"));
                if has_name(&seen, pname) {
                    err(ck, mi, p.get("name_span").span, format("parameter `{pname}` is declared more than once"), "", "", "");
                }
                seen.push(pname);
            }
            let has_ret = !ck.nodes.at(nid).is_none("ret");
            let mut rt = types.VOID;
            if has_ret { rt = resolve_type(ck, ck.nodes.at(nid).node_of("ret"), mi, true); }
            ck.syms.at(sid).ret = rt;
            if has_ret && rt != types.POISON && !sized(ck, rt, mi, ck.nodes.at(nid).node_of("ret").span) {
                ck.syms.at(sid).ret = types.POISON;
            }
        } else if kd == "struct" {
            let nf = ck.nodes.at(nid).get("fields").items.len;
            if nf == 0 && ck.nodes.at(nid).get("opaque").i == 0 {
                err(ck, mi, ck.nodes.at(nid).span, format("struct `{name}` has no fields"), "", "", "");
            }
            for fi in 0..nf {
                let f = ck.nodes.at(nid).get("fields").items.at(fi).node.at(0);
                let tyn = f.node_of("tyn");
                let t0 = resolve_type(ck, tyn, mi, false);
                let fname = String.from(f.str_of("name"));
                if find_field(ck, sid, fname) >= 0 {
                    err(ck, mi, f.span, format("field `{fname}` is declared more than once in `{name}`"), "", "", "");
                    continue;
                }
                let mut t = t0;
                if t != types.POISON && !sized(ck, t, mi, tyn.span) { t = types.POISON; }
                ck.syms.at(sid).fields.push(SField { name: fname, ty: t, span: f.span });
            }
        } else if kd == "const" {
            let tyn = ck.nodes.at(nid).node_of("tyn");
            let mut t = resolve_type(ck, tyn, mi, false);
            let ts = ty_str(ck, t);
            if ck.syms.at(sid).is_extern {
                if t != types.POISON && !(types.is_numeric(t) || t == types.BOOL || tk(ck, t) == types.K_PTR) {
                    err(ck, mi, tyn.span, format("extern constants must be numbers, `bool` or pointers, not `{ts}`"), "",
                        "for C strings, bind a function such as `SDL_GetError()` instead", "");
                    t = types.POISON;
                }
            } else if t != types.POISON && !(types.is_numeric(t) || t == types.BOOL || t == types.STR) {
                err(ck, mi, tyn.span, format("constants must be integers, floats, `bool` or `str`, not `{ts}`"), "", "", "");
                t = types.POISON;
            }
            ck.syms.at(sid).ty = t;
        }
    }
}

// ---- C ABI ---------------------------------------------------------------------------------------------------------------

pub fn ffi_ok(ck: *Checker, t: i64, seen: *List<String>) -> bool {
    let k = tk(ck, t);
    if k == types.K_PRIM { return types.is_numeric(t) || t == types.BOOL; }
    if k == types.K_PTR || k == types.K_FN || k == types.K_ENUM { return true; }
    if k == types.K_ARR { return ffi_ok(ck, ck.types.tys.at(t).inner, seen); }
    if k == types.K_STRUCT {
        let sid = ck.types.tys.at(t).sym;
        if ck.syms.at(sid).opaque { return false; }
        let full = String.from(ck.syms.at(sid).full);
        if has_name(seen, full) { return true; }
        seen.push(full);
        let nf = ck.syms.at(sid).fields.len;
        for i in 0..nf {
            if !ffi_ok(ck, ck.syms.at(sid).fields.at(i).ty, seen) { return false; }
        }
        return true;
    }
    return false;
}

pub fn ffi_why(ck: *Checker, t: i64) -> String {
    let k = tk(ck, t);
    if t == types.STR { return String.from("`str` is a Crumbs view (pointer + length); pass `cstr(s)` for a C string"); }
    if t == types.STRING { return String.from("`String` is a Crumbs type; pass `cstr(s)` or `s.ptr` instead"); }
    if k == types.K_SLICE { return String.from("slices are (pointer, length) pairs in Crumbs; pass `s.ptr` and `s.len` separately"); }
    if k == types.K_EU { return String.from("error unions have no C equivalent"); }
    if k == types.K_STRUCT {
        let sid = ck.types.tys.at(t).sym;
        let n = String.from(ck.syms.at(sid).name);
        if ck.syms.at(sid).opaque { return format("`{n}` is opaque; use `*{n}`"); }
        return format("`{n}` contains fields that have no C layout (`str`, slices, ...)");
    }
    if k == types.K_ERR { return String.from("use `i32` and convert errors yourself"); }
    return String.empty();
}

pub fn ffi_check(ck: *Checker, mi: i64, t: i64, sp: ast.Span, what: str) {
    if t == types.POISON || t == types.VOID { return; }
    let mut seen: List<String> = List.new();
    if !ffi_ok(ck, t, &seen) {
        let ts = ty_str(ck, t);
        err(ck, mi, sp, format("{what} uses type `{ts}`, which has no C ABI equivalent"), "", ffi_why(ck, t), "");
    }
}

pub fn check_ffi(ck: *Checker) {
    let nf = ck.fns.len;
    for q in 0..nf {
        let sid = *ck.fns.at(q);
        if !(ck.syms.at(sid).is_extern || ck.syms.at(sid).is_export) { continue; }
        let mi = ck.syms.at(sid).mod_idx;
        let nid = ck.syms.at(sid).node;
        let name = String.from(ck.syms.at(sid).name);
        let what = ck.syms.at(sid).is_extern ? format("extern function `{name}`") : format("exported function `{name}`");
        let np = ck.nodes.at(nid).get("params").items.len;
        for pi in 0..np {
            if pi >= ck.syms.at(sid).params.len { break; }
            let sp = ck.nodes.at(nid).get("params").items.at(pi).node.at(0).node_of("tyn").span;
            ffi_check(ck, mi, *ck.syms.at(sid).params.at(pi), sp, what);
        }
        let rt = ck.syms.at(sid).ret;
        if tk(ck, rt) == types.K_EU {
            err(ck, mi, ck.nodes.at(nid).span, format("{what} cannot return an error union"), "", "return an `i32` status code instead", "");
        } else {
            let has_ret = !ck.nodes.at(nid).is_none("ret");
            let sp = has_ret ? ck.nodes.at(nid).node_of("ret").span : ck.nodes.at(nid).span;
            ffi_check(ck, mi, rt, sp, what);
        }
    }
    let ns = ck.structs.len;
    for q in 0..ns {
        let sid = *ck.structs.at(q);
        if !ck.syms.at(sid).extern_struct { continue; }
        let mi = ck.syms.at(sid).mod_idx;
        let name = String.from(ck.syms.at(sid).name);
        for fi in 0..ck.syms.at(sid).fields.len {
            let fname = String.from(ck.syms.at(sid).fields.at(fi).name);
            ffi_check(ck, mi, ck.syms.at(sid).fields.at(fi).ty, ck.syms.at(sid).fields.at(fi).span,
                      format("field `{fname}` of extern struct `{name}`"));
        }
    }
}

// ---- recursive structs --------------------------------------------------------------------------------------------------------

pub fn value_structs(ck: *Checker, t: i64, out: *List<i64>) {
    let k = tk(ck, t);
    if k == types.K_STRUCT { out.push(ck.types.tys.at(t).sym); }
    else if k == types.K_ARR { value_structs(ck, ck.types.tys.at(t).inner, out); }
}

pub fn cycle_visit(ck: *Checker, state: *List<i64>, sid: i64, path: *List<i64>) {
    let st = *state.at(sid);
    if st == 2 { return; }
    if st == 1 {
        let mut start = 0 as i64;
        for i in 0..path.len { if *path.at(i) == sid { start = i; break; } }
        let mut chain = String.empty();
        for i in start..path.len { chain.append(ck.syms.at(*path.at(i)).name); chain.append(" -> "); }
        chain.append(ck.syms.at(sid).name);
        let name = String.from(ck.syms.at(sid).name);
        err(ck, ck.syms.at(sid).mod_idx, ck.nodes.at(ck.syms.at(sid).node).span,
            format("recursive type `{name}` has infinite size"), "contains itself by value",
            format("use a pointer (`*{name}`) to break the cycle"), format("cycle: {chain}"));
        *state.at(sid) = 2;
        return;
    }
    *state.at(sid) = 1;
    let nf = ck.syms.at(sid).fields.len;
    for i in 0..nf {
        let mut ds: List<i64> = List.new();
        value_structs(ck, ck.syms.at(sid).fields.at(i).ty, &ds);
        for q in 0..ds.len {
            let mut p2: List<i64> = List.new();
            for z in 0..path.len { p2.push(*path.at(z)); }
            p2.push(sid);
            cycle_visit(ck, state, *ds.at(q), &p2);
        }
    }
    *state.at(sid) = 2;
}

pub fn check_struct_cycles(ck: *Checker) {
    let mut state: List<i64> = List.new();
    for i in 0..ck.syms.len { state.push(0); }
    let n = ck.structs.len;
    for q in 0..n {
        let mut path: List<i64> = List.new();
        cycle_visit(ck, &state, *ck.structs.at(q), &path);
    }
}

// the signature phase of `Checker._run`
pub fn run_sigs(ck: *Checker) {
    for oi in 0..ck.ld.order.len { resolve_sigs(ck, *ck.ld.order.at(oi)); }
    check_ffi(ck);
}

// =====================================================================================================================
// ---- function bodies: expressions and statements -----------------------------------------------------------------
// =====================================================================================================================

pub struct Ent { kind: i64, idx: i64 }           // kind: 0 none, 1 module, 2 symbol, 3 bad

pub fn warn(ck: *Checker, mi: i64, sp: ast.Span, msg: str, label: str, help: str, notes: str) {
    ck.d.file = String.from(ck.ld.mods.at(mi).shown);
    ck.d.add_warn_note(sp.line, sp.col, sp.len, msg, label, help, notes);
}

pub fn here(ck: *Checker, sp: ast.Span, msg: str, label: str, help: str) { err(ck, ck.cur_mod, sp, msg, label, help, ""); }
pub fn here_n(ck: *Checker, sp: ast.Span, msg: str, label: str, help: str, notes: str) { err(ck, ck.cur_mod, sp, msg, label, help, notes); }
pub fn warn_here(ck: *Checker, sp: ast.Span, msg: str, label: str, help: str) { warn(ck, ck.cur_mod, sp, msg, label, help, ""); }

pub fn unimpl(ck: *Checker, e: *ast.Node, what: str) -> i64 {
    here(ck, e.span, format("UNIMPLEMENTED in the Crumbs checker: {what}"), "", "");
    return types.POISON;
}

pub fn is_arith(op: str) -> bool { return op == "+" || op == "-" || op == "*" || op == "/" || op == "%"; }
pub fn is_bitwise(op: str) -> bool { return op == "&" || op == "|" || op == "^"; }
pub fn is_shift(op: str) -> bool { return op == "<<" || op == ">>"; }
pub fn is_cmp(op: str) -> bool { return op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">="; }

// ---- annotations on nodes ----------------------------------------------------------------------------------------

pub fn ety(e: *ast.Node) -> i64 { return e.has("ty") ? e.get("ty").i : -2; }
pub fn set_ty(e: *ast.Node, t: i64) { e.set("ty", ast.v_tag(10, t)); }
pub fn set_tyn(e: *ast.Node, name: str, t: i64) { e.set(name, ast.v_tag(10, t)); }
pub fn set_flag(e: *ast.Node, name: str, b: bool) { e.set(name, ast.v_bool(b)); }
pub fn set_nil(e: *ast.Node, name: str) { e.set(name, ast.v_none()); }
pub fn flag(e: *ast.Node, name: str) -> bool { return e.has(name) && e.get(name).i != 0 && e.get(name).tag == 1; }
pub fn is_set(e: *ast.Node, name: str) -> bool { return e.has(name) && e.get(name).tag != 0; }
pub fn has_suffix(e: *ast.Node) -> bool { return e.has("suffix") && e.get("suffix").tag != 0; }

pub fn int_text(e: *ast.Node) -> String {
    let v = e.get("value");
    if v.s.len > 0 { return String.from(v.s); }
    return format("{v.i}");
}

pub fn int_is_zero(e: *ast.Node) -> bool { return e.kind == "Int" && e.get("value").s.len == 0 && e.get("value").i == 0; }

// ---- integer ranges (as decimal text, so that u64 and i64 limits are exact) ----------------------------------------------

pub fn lo_text(t: i64) -> str {
    if !types.signed(t) { return "0"; }
    let b = types.bits(t);
    if b == 8 { return "-128"; }
    if b == 16 { return "-32768"; }
    if b == 32 { return "-2147483648"; }
    return "-9223372036854775808";
}

pub fn hi_text(t: i64) -> str {
    let b = types.bits(t);
    if types.signed(t) {
        if b == 8 { return "127"; }
        if b == 16 { return "32767"; }
        if b == 32 { return "2147483647"; }
        return "9223372036854775807";
    }
    if b == 8 { return "255"; }
    if b == 16 { return "65535"; }
    if b == 32 { return "4294967295"; }
    return "18446744073709551615";
}

// magnitude comparison of two non-negative decimal strings: -1, 0, 1
pub fn cmp_mag(a: str, b: str) -> i64 {
    if a.len != b.len { return a.len < b.len ? -1 : 1; }
    for i in 0..a.len {
        if a[i] != b[i] { return a[i] < b[i] ? -1 : 1; }
    }
    return 0;
}

// does the value (sign and decimal magnitude) lie in the range of integer type `t`?
pub fn in_range(neg: bool, mag: str, t: i64) -> bool {
    if mag == "0" { return true; }
    if neg {
        if !types.signed(t) { return false; }
        let lo: str = lo_text(t);
        return cmp_mag(mag, lo[1..lo.len]) <= 0;
    }
    return cmp_mag(mag, hi_text(t)) <= 0;
}

// ---- scopes and locals -----------------------------------------------------------------------------------------------

pub fn push_scope(ck: *Checker) { ck.scopes.push(Scope { names: List.new(), ids: List.new(), clo: -1 }); }

pub fn pop_scope(ck: *Checker) {
    let sc = ck.scopes.pop() catch { panic("scope underflow"); };
    for i in 0..sc.ids.len {
        let id = *sc.ids.at(i);
        let nm = String.from(ck.locals.at(id).name);
        if !ck.locals.at(id).used && !ck.locals.at(id).is_param && !nm.starts_with("_") {
            warn_here(ck, ck.locals.at(id).span, format("unused variable `{nm}`"), "",
                      format("if this is intentional, rename it to `_{nm}`"));
        }
    }
}

pub fn lookup_local(ck: *Checker, name: str) -> i64 {
    let mut crossed: List<i64> = List.new();
    let mut i = ck.scopes.len;
    while i > 0 {
        i -= 1;
        let sc = ck.scopes.at(i);
        for q in 0..sc.names.len {
            if *sc.names.at(q) == name {
                let mut loc = *sc.ids.at(q);
                let mut c = crossed.len;
                while c > 0 { c -= 1; loc = capture(ck, *crossed.at(c), loc); }
                return loc;
            }
        }
        if sc.clo >= 0 { crossed.push(sc.clo); }
    }
    return -1;
}

// the proxy local that stands for `loc` inside closure `ci`
pub fn capture(ck: *Checker, ci: i64, loc: i64) -> i64 {
    for k in 0..ck.clos.at(ci).outer.len { if *ck.clos.at(ci).outer.at(k) == loc { return *ck.clos.at(ci).proxy.at(k); } }
    let idx = ck.clos.at(ci).outer.len;
    let byref = !ck.clos.at(ci).is_move;
    let cname = byref ? format("(*cb_e->c{idx})") : format("(cb_e->c{idx})");
    let nm = String.from(ck.locals.at(loc).name);
    let p = new_local(ck, nm, ck.locals.at(loc).ty, ck.locals.at(loc).is_mut, cname, ck.locals.at(loc).span, false);
    ck.locals.at(p).used = true;
    ck.locals.at(p).captured = true;
    ck.locals.at(p).byref = byref;
    ck.locals.at(p).outer = loc;
    ck.locals.at(p).region_handle = ck.locals.at(loc).region_handle;
    ck.locals.at(p).taint = ck.locals.at(loc).taint;
    ck.locals.at(loc).used = true;
    ck.clos.at(ci).outer.push(loc);
    ck.clos.at(ci).proxy.push(p);
    return p;
}

pub fn alloc_cname(ck: *Checker, name: str) -> String {
    let mut base = String.from(name);
    if creserved.is_c_reserved(name) || name.starts_with("cb_") || name.starts_with("__") { base.push('_'); }
    let mut cand = String.from(base);
    let mut k = 0 as i64;
    while has_name(&ck.fn_names, cand) {
        k += 1;
        cand = format("{base}__{k}");
    }
    ck.fn_names.push(String.from(cand));
    return cand;
}

pub fn new_local(ck: *Checker, name: str, ty: i64, is_mut: bool, cname: String, sp: ast.Span, is_param: bool) -> i64 {
    let id = ck.locals.len;
    ck.locals.push(Local { name: String.from(name), ty: ty, is_mut: is_mut, cname: cname, span: sp, used: false, is_param: is_param,
                           glue: false, rdepth: 0, id: id + 1, captured: false, written: false, region_handle: false, byref: false, outer: -1, taint: -1, rd: 0 });
    return id;
}

pub fn declare_local(ck: *Checker, name: str, ty: i64, is_mut: bool, sp: ast.Span, is_param: bool) -> i64 {
    let top = ck.scopes.len - 1;
    if name == "null" {
        here(ck, sp, "`null` is a reserved name", "", "it is the null pointer literal");
        let cn = alloc_cname(ck, "null_");
        return new_local(ck, name, ty, is_mut, cn, sp, is_param);
    }
    let mut at = -1 as i64;
    for q in 0..ck.scopes.at(top).names.len { if *ck.scopes.at(top).names.at(q) == name { at = q; } }
    if at >= 0 && !is_param {
        let old = *ck.scopes.at(top).ids.at(at);
        let ol = ck.locals.at(old).span.line;
        here_n(ck, sp, format("variable `{name}` is already declared in this scope"), "redeclared here",
               "use a different name, or assign to the existing variable (declare it with `let mut`)",
               format("first declared at line {ol}"));
    }
    let cn = alloc_cname(ck, name);
    let id = new_local(ck, name, ty, is_mut, cn, sp, is_param);
    let g = ty != types.POISON && has_glue(ck, ty);
    ck.locals.at(id).glue = g;
    ck.locals.at(id).rdepth = ck.has_fn ? ck.fn_rdepth : 0;
    if at >= 0 { *ck.scopes.at(top).ids.at(at) = id; }
    else { ck.scopes.at(top).names.push(String.from(name)); ck.scopes.at(top).ids.push(id); }
    return id;
}

// ---- destructors and moves ------------------------------------------------------------------------------------------

pub fn drop_fn_of(ck: *Checker, sid: i64) -> i64 {
    if ck.syms.at(sid).base >= 0 { return ck.syms.at(sid).drop_inst; }
    return ck.syms.at(sid).tparams.len == 0 ? ck.syms.at(sid).drop_sym : -1;
}

pub fn has_glue(ck: *Checker, t: i64) -> bool {
    let k = tk(ck, t);
    if t == types.STRING { return true; }
    if k == types.K_ARR || k == types.K_OPT { return has_glue(ck, ck.types.tys.at(t).inner); }
    if k == types.K_CLO { return true; }
    if k != types.K_STRUCT { return false; }
    let key = String.from(ck.types.tys.at(t).key);
    for i in 0..ck.glue.len { if ck.glue.at(i).key == key { return ck.glue.at(i).v; } }
    if has_name(&ck.glue_busy, key) { return false; }
    ck.glue_busy.push(String.from(key));
    let sid = ck.types.tys.at(t).sym;
    let mut r = drop_fn_of(ck, sid) >= 0;
    let nf = ck.syms.at(sid).fields.len;
    for i in 0..nf { if !r && has_glue(ck, ck.syms.at(sid).fields.at(i).ty) { r = true; } }
    let mut keep: List<String> = List.new();
    for i in 0..ck.glue_busy.len { if *ck.glue_busy.at(i) != key { keep.push(String.from(*ck.glue_busy.at(i))); } }
    ck.glue_busy = keep;
    ck.glue.push(GlueEnt { key: key, v: r });
    return r;
}

pub fn moved_at(l: *List<MovedEnt>, local: i64) -> i64 {
    for i in 0..l.len { if l.at(i).local == local { return i; } }
    return -1;
}

pub fn copy_moved(l: *List<MovedEnt>) -> List<MovedEnt> {
    let mut o: List<MovedEnt> = List.new();
    for i in 0..l.len { o.push(MovedEnt { local: l.at(i).local, line: l.at(i).line }); }
    return o;
}

pub fn set_moved(l: *List<MovedEnt>, local: i64, line: i64) {
    let at = moved_at(l, local);
    if at >= 0 { l.at(at).line = line; } else { l.push(MovedEnt { local: local, line: line }); }
}

// the first state to mention a variable wins
pub fn merge_moved(m0: *List<MovedEnt>, states: *List<List<MovedEnt>>) -> List<MovedEnt> {
    if states.len == 0 { return copy_moved(m0); }
    let mut out: List<MovedEnt> = List.new();
    for s in 0..states.len {
        for i in 0..states.at(s).len {
            if moved_at(&out, states.at(s).at(i).local) < 0 { out.push(MovedEnt { local: states.at(s).at(i).local, line: states.at(s).at(i).line }); }
        }
    }
    return out;
}

// `e` is used by value where ownership is taken: a variable is moved, anything else must be a temporary
pub fn consume(ck: *Checker, e: *ast.Node) {
    let t = ety(e);
    if t == -2 || t == types.POISON || !has_glue(ck, t) || flag(e, "coerce") { return; }
    let k: str = e.kind;
    if k == "Ident" && e.has("local") && e.get("local").tag == 12 {
        let loc = e.get("local").i;
        if ck.locals.at(loc).captured {
            let nm = String.from(e.str_of("name"));
            here(ck, e.span, format("cannot move `{nm}` out of a closure's captured variables"), "a closure can run more than once",
                 "clone it, or borrow it with `&`");
            return;
        }
        set_flag(e, "move", true);
        set_moved(&ck.moved, loc, e.span.line);
        return;
    }
    if k == "Call" || k == "StructLit" || k == "ArrayLit" || k == "Binary" || k == "Try" || k == "Catch" || k == "Ternary" {
        set_flag(e, "owned", true);
        return;
    }
    let mut what = "";
    if k == "Field" && e.has("mode") && (e.str_of("mode") == "field" || e.str_of("mode") == "ptrfield") { what = "a struct field"; }
    else if k == "Index" { what = "an array or slice element"; }
    else if k == "Unary" && e.str_of("op") == "*" { what = "a pointer"; }
    if what.len > 0 {
        let ts = ty_str(ck, t);
        here(ck, e.span, format("cannot move a `{ts}` out of {what}"), "its type has a destructor, so it cannot be copied",
             "borrow it with `&`, or use `read_at(p)` to take ownership of raw storage");
    }
}

// ---- control-flow analysis --------------------------------------------------------------------------------------------

pub fn has_break_val(v: *ast.Val) -> bool {
    if v.tag == 4 { return has_break(v.node.at(0)); }
    if v.tag == 5 {
        for i in 0..v.items.len { if has_break_val(v.items.at(i)) { return true; } }
    }
    return false;
}

pub fn has_break(n: *ast.Node) -> bool {
    if n.kind == "Break" { return true; }
    if n.kind == "While" || n.kind == "Loop" || n.kind == "For" { return false; }
    for i in 0..n.attrs.len {
        if n.attrs.at(i).name == "span" || n.attrs.at(i).name == "ty" { continue; }
        if has_break_val(&n.attrs.at(i).v) { return true; }
    }
    return false;
}

pub fn terminates(ck: *Checker, s: *ast.Node) -> bool {
    let k: str = s.kind;
    if k == "Return" || k == "Throw" || k == "Break" || k == "Continue" { return true; }
    if k == "ExprStmt" {
        let e = s.node_of("expr");
        return e.kind == "Call" && e.has("builtin") && (e.str_of("builtin") == "panic" || e.str_of("builtin") == "exit");
    }
    if k == "Block" {
        let n = s.get("stmts").items.len;
        for i in 0..n { if terminates(ck, s.get("stmts").items.at(i).node.at(0)) { return true; } }
        return false;
    }
    if k == "Region" { return terminates(ck, s.node_of("body")); }
    if k == "TryBlock" { return terminates(ck, s.node_of("body")) && terminates(ck, s.node_of("handler")); }
    if k == "If" {
        return !s.is_none("els") && terminates(ck, s.node_of("then")) && terminates(ck, s.node_of("els"));
    }
    if k == "Match" {
        if !flag(s, "exhaustive") || s.get("arms").items.len == 0 { return false; }
        for i in 0..s.get("arms").items.len {
            if !terminates(ck, s.get("arms").items.at(i).node.at(0).node_of("body")) { return false; }
        }
        return true;
    }
    if k == "Loop" { return !has_break(s.node_of("body")); }
    if k == "While" {
        let c = s.node_of("cond");
        return c.kind == "Bool" && c.get("value").i != 0 && !has_break(s.node_of("body"));
    }
    return false;
}

// ---- name resolution --------------------------------------------------------------------------------------------------

pub fn syms_of_kind_names(ck: *Checker, mi: i64, a: str, b: str, out: *List<String>) {
    let cm = ck.cmods.at(mi);
    for q in 0..cm.order.len {
        let s = ck.syms.at(*cm.order.at(q));
        if s.kind == a || s.kind == b { out.push(String.from(s.name)); }
    }
}

pub fn entity(ck: *Checker, e: *ast.Node) -> Ent {
    let none = Ent { kind: 0, idx: -1 };
    let mi = ck.cur_mod;
    if e.kind == "Ident" {
        let name = String.from(e.str_of("name"));
        if lookup_local(ck, name) >= 0 { return none; }
        let im = import_of(ck, mi, name);
        if im >= 0 {
            ck.cmods.at(mi).imports.at(im).used = true;
            return Ent { kind: 1, idx: ck.cmods.at(mi).imports.at(im).mod_idx };
        }
        let s = lookup_sym(ck, mi, name);
        if s >= 0 {
            let kd: str = ck.syms.at(s).kind;
            if kd == "struct" || kd == "enum" || kd == "fn" { return Ent { kind: 2, idx: s }; }
            return none;
        }
        let p = lookup_named(&ck.prelude_types, name);
        if p >= 0 { return Ent { kind: 2, idx: p }; }
        return none;
    }
    if e.kind == "Field" {
        let base = entity(ck, e.node_of("obj"));
        if base.kind == 1 {
            let md = base.idx;
            let name = String.from(e.str_of("name"));
            let mname = String.from(ck.ld.mods.at(md).name);
            let s = lookup_sym(ck, md, name);
            if s < 0 {
                let mut cands: List<String> = List.new();
                for q in 0..ck.cmods.at(md).order.len { cands.push(String.from(ck.syms.at(*ck.cmods.at(md).order.at(q)).name)); }
                let sg = diag.suggest_list(name, &cands);
                here(ck, e.get("name_span").span, format("module `{mname}` has no member `{name}`"), "",
                     sg.len > 0 ? format("did you mean `{sg}`?") : String.empty());
                return Ent { kind: 3, idx: -1 };
            }
            if !ck.syms.at(s).is_pub {
                here(ck, e.get("name_span").span, format("`{name}` is private to module `{mname}`"), "private item",
                     format("mark it `pub` in `{mname}` to export it"));
                return Ent { kind: 3, idx: -1 };
            }
            return Ent { kind: 2, idx: s };
        }
    }
    return none;
}

// ---- helpers for diagnostics and conversions ------------------------------------------------------------------------------

pub fn mismatch(ck: *Checker, e: *ast.Node, exp: i64, got: i64, what: str) {
    let mut help = String.empty();
    if types.is_float(exp) && e.kind == "Int" && !has_suffix(e) {
        help = format("write the literal as a float, e.g. `{int_text(e)}.0`");
    } else if types.is_numeric(exp) && types.is_numeric(got) {
        help = format("convert explicitly with `as {ty_str(ck, exp)}`");
    } else if exp == types.BOOL && types.is_numeric(got) {
        help = String.from("compare explicitly, e.g. `x != 0`");
    } else if got == types.VOID {
        help = String.from("this expression produces no value");
    }
    let es = ty_str(ck, exp);
    let gs = ty_str(ck, got);
    here(ck, e.span, what, format("expected `{es}`, found `{gs}`"), help);
}

pub fn ro_violation(ck: *Checker, e: *ast.Node, t: i64, exp: i64) -> bool {
    if tk(ck, t) == types.K_PTR && tk(ck, exp) == types.K_PTR && ck.types.tys.at(t).ro && !ck.types.tys.at(exp).ro
        && types.same(&ck.types, t, exp) && !flag(e, "recv_ok") {
        let es = ty_str(ck, exp);
        let ts = ty_str(ck, t);
        let ei = ty_str(ck, ck.types.tys.at(exp).inner);
        here(ck, e.span, "cannot turn a read-only pointer into a writable one", format("expected `{es}`, found `{ts}`"),
             format("take `*const {ei}` instead, or cast with `as` if you really must"));
        return true;
    }
    return false;
}

// `*T` converts implicitly to `*void` (as in C), never the other way round
pub fn ptr_ok(ck: *Checker, exp: i64, t: i64) -> bool {
    return tk(ck, exp) == types.K_PTR && ck.types.tys.at(exp).inner == types.VOID && tk(ck, t) == types.K_PTR;
}

pub fn lint(ck: *Checker, sp: ast.Span, msg: str, label: str, help: str) {
    if ck.strict {
        let h = help.len > 0 ? format("{help} (error because of --strict-casts)") : String.from("error because of --strict-casts");
        here(ck, sp, msg, label, h);
    } else {
        warn_here(ck, sp, msg, label, help);
    }
}

// the type both numeric operands are converted to (-1 if there is no lossless choice)
pub fn common_type(a: i64, b: i64) -> i64 {
    if types.is_float(a) || types.is_float(b) {
        if types.is_float(a) && types.is_float(b) { return types.F64; }
        return types.is_float(a) ? a : b;
    }
    if types.signed(a) == types.signed(b) { return types.bits(a) >= types.bits(b) ? a : b; }
    let s = types.signed(a) ? a : b;
    let u = types.signed(a) ? b : a;
    if types.bits(s) > types.bits(u) { return s; }
    let need = types.bits(u) * 2;
    if need == 16 { return types.I16; }
    if need == 32 { return types.I32; }
    if need == 64 { return types.I64; }
    return -1;
}

// 0 none, 1 widen, 2 checked, 3 lossy, 4 fnarrow, 5 bad
pub fn conv_kind(src: i64, dst: i64) -> i64 {
    if src == dst { return 0; }
    if types.is_int(src) && types.is_int(dst) {
        let widen = types.signed(src) == types.signed(dst) ? types.bits(dst) >= types.bits(src)
            : (!types.signed(src) && types.signed(dst) && types.bits(dst) > types.bits(src));
        return widen ? 1 : 2;
    }
    if types.is_int(src) && types.is_float(dst) {
        return types.bits(src) <= (dst == types.F32 ? 24 : 53) ? 1 : 3;
    }
    if types.is_float(src) && types.is_float(dst) { return src == types.F32 ? 1 : 4; }
    return 5;
}

pub fn kind_name(k: i64) -> str {
    if k == 1 { return "widen"; }
    if k == 2 { return "checked"; }
    if k == 3 { return "lossy"; }
    return "fnarrow";
}

// records an implicit conversion on `node` (src -> dst); false after reporting an error
pub fn apply_conv(ck: *Checker, node: *ast.Node, src: i64, dst: i64) -> bool {
    set_nil(node, "conv");
    let mut kind = conv_kind(src, dst);
    if kind == 0 { return true; }
    let ss = ty_str(ck, src);
    let ds = ty_str(ck, dst);
    if kind == 5 {
        mismatch(ck, node, dst, src, "mismatched types");
        return false;
    }
    if kind == 2 {
        let v = const_eval(ck, node, ck.cur_mod);
        if ck.nc {
            ck.nc = false;
            kind = 2;
        } else if v.kind == 0 {
            let neg = v.i < 0;
            let mag = neg ? format("{0 - v.i}") : format("{v.i}");
            if !in_range(neg, mag, dst) {
                here(ck, node.span, format("constant value {v.i} does not fit in `{ds}`"),
                     format("valid range is {lo_text(dst)}..={hi_text(dst)}"), "");
                return false;
            }
            kind = 1;
        } else {
            kind = 2;
        }
        if kind == 2 {
            let sg = types.signed(src);
            let dg = types.signed(dst);
            let sign = sg && !dg ? format("signed `{ss}` to unsigned `{ds}`")
                : (!sg && dg ? format("unsigned `{ss}` to signed `{ds}`")
                : (types.bits(src) > types.bits(dst) ? format("`{ss}` to narrower `{ds}`") : format("`{ss}` to `{ds}`")));
            lint(ck, node.span, format("implicit conversion from {sign} may not fit"),
                 "checked at runtime: panics if the value is out of range",
                 format("use `x as {ds}` to truncate on purpose, or widen the destination type"));
        }
    } else if kind == 3 {
        lint(ck, node.span, format("implicit conversion from `{ss}` to `{ds}` may lose precision"),
             format("`{ds}` cannot represent every `{ss}` exactly"), format("use `x as {ds}` if the rounding is intended"));
    } else if kind == 4 {
        lint(ck, node.span, "implicit conversion from `f64` to `f32` loses precision", "",
             "use `x as f32` if the rounding is intended");
    }
    let mut items: List<ast.Val> = List.new();
    items.push(ast.v_tag(10, src));
    items.push(ast.v_tag(10, dst));
    items.push(ast.v_str(kind_name(kind)));
    node.set("conv", ast.v_list(items));
    return true;
}

// both operands of a binary operation converted to a common numeric type (-1 on error)
pub fn binary_conv(ck: *Checker, e: *ast.Node, lt: i64, rt: i64) -> i64 {
    let op: str = e.str_of("op");
    let ct = common_type(lt, rt);
    let opsp = e.get("op_span").span;
    if ct < 0 {
        let ls = ty_str(ck, lt);
        let rs = ty_str(ck, rt);
        here(ck, opsp, format("cannot mix `{ls}` and `{rs}` in `{op}`"), "no integer type can represent every value of both",
             "cast one side explicitly, e.g. `x as i64` (negative values or large values may change)");
        return -1;
    }
    let ok = apply_conv(ck, e.node_of("l"), lt, ct) && apply_conv(ck, e.node_of("r"), rt, ct);
    if !ok { return -1; }
    if types.is_int(lt) && types.is_int(rt) && types.signed(lt) != types.signed(rt) {
        let sg = types.signed(lt) ? lt : rt;
        let us = types.signed(lt) ? rt : lt;
        let sgs = ty_str(ck, sg);
        let uss = ty_str(ck, us);
        let cts = ty_str(ck, ct);
        if op == "<" || op == ">" || op == "<=" || op == ">=" {
            lint(ck, opsp, format("comparing signed `{sgs}` with unsigned `{uss}`"), format("both operands are converted to `{cts}`"),
                 "cast one side explicitly (e.g. `x as i32`) to make the intent clear");
        } else if is_bitwise(op) {
            lint(ck, opsp, format("`{op}` mixes signed `{sgs}` and unsigned `{uss}` operands"),
                 format("both operands are converted to `{cts}` (the signed one is sign-extended)"),
                 "cast one side explicitly to make the bit pattern you want unambiguous");
        }
    }
    return ct;
}

// converts the checked expression `e` (of type `t`) implicitly to `exp`, or reports a mismatch
pub fn coerce(ck: *Checker, e: *ast.Node, t: i64, exp: i64) -> i64 {
    set_nil(e, "conv");
    set_nil(e, "wrap_opt");
    if tk(ck, exp) == types.K_OPT && !types.same(&ck.types, t, exp) {
        if t == types.POISON { return types.POISON; }
        if coerce(ck, e, t, ck.types.tys.at(exp).inner) == types.POISON { return types.POISON; }
        set_tyn(e, "wrap_opt", exp);
        return exp;
    }
    if exp == types.STR && t == types.STRING {
        set_flag(e, "coerce", true);
        return exp;
    }
    if types.is_numeric(t) && types.is_numeric(exp) && t != exp {
        return apply_conv(ck, e, t, exp) ? exp : types.POISON;
    }
    if ro_violation(ck, e, t, exp) { return types.POISON; }
    if ptr_ok(ck, exp, t) { return exp; }
    if tk(ck, exp) == types.K_PTR && tk(ck, t) == types.K_PTR && types.same(&ck.types, t, exp) && ck.types.tys.at(exp).ro && !ck.types.tys.at(t).ro {
        return exp;
    }
    if !types.same(&ck.types, t, exp) {
        mismatch(ck, e, exp, t, "mismatched types");
        return types.POISON;
    }
    consume(ck, e);
    return t;
}

pub fn expect(ck: *Checker, e: *ast.Node, exp: i64, eu_ok: bool) -> i64 {
    let t = check(ck, e, exp, eu_ok);
    return coerce(ck, e, t, exp);
}

pub fn is_null(ck: *Checker, e: *ast.Node) -> bool {
    return e.kind == "Ident" && e.str_of("name") == "null" && lookup_local(ck, "null") < 0;
}

pub fn untyped(ck: *Checker, e: *ast.Node) -> bool {
    let k: str = e.kind;
    if k == "Ident" && e.str_of("name") == "null" && lookup_local(ck, "null") < 0 { return true; }
    if k == "Int" || k == "Float" { return !has_suffix(e); }
    if k == "Unary" && e.str_of("op") == "-" { return untyped(ck, e.node_of("expr")); }
    if k == "Binary" && (is_arith(e.str_of("op")) || is_bitwise(e.str_of("op"))) {
        return untyped(ck, e.node_of("l")) && untyped(ck, e.node_of("r"));
    }
    return false;
}

pub fn lit_is_float(e: *ast.Node) -> bool {
    if e.kind == "Float" { return true; }
    if e.kind == "Unary" { return lit_is_float(e.node_of("expr")); }
    if e.kind == "Binary" { return lit_is_float(e.node_of("l")) || lit_is_float(e.node_of("r")); }
    return false;
}

// ---- the expression dispatcher ----------------------------------------------------------------------------------------------

pub fn check(ck: *Checker, e: *ast.Node, exp: i64, eu: bool) -> i64 {
    let mut hint = exp;
    if exp >= 0 && tk(ck, exp) == types.K_OPT && !is_null(ck, e) && e.kind != "Ternary" { hint = ck.types.tys.at(exp).inner; }
    let k: str = e.kind;
    let mut t = types.POISON;
    if k == "Int" { t = ex_int(ck, e, hint, false); }
    else if k == "Float" { t = ex_float(e, hint, ck); }
    else if k == "Bool" { t = types.BOOL; }
    else if k == "Str" { t = types.STR; }
    else if k == "Ident" { t = ex_ident(ck, e, hint); }
    else if k == "Field" { t = ex_field(ck, e, hint); }
    else if k == "Unary" { t = ex_unary(ck, e, hint); }
    else if k == "Binary" { t = ex_binary(ck, e, hint); }
    else if k == "Cast" { t = ex_cast(ck, e, hint); }
    else if k == "IncDec" { t = ex_incdec(ck, e); }
    else if k == "Call" { t = ex_call(ck, e, hint); }
    else if k == "Index" { t = ex_index(ck, e); }
    else if k == "SliceExpr" { t = ex_slice(ck, e); }
    else if k == "StructLit" { t = ex_structlit(ck, e, hint); }
    else if k == "ArrayLit" { t = ex_arraylit(ck, e, hint); }
    else if k == "ArrayRepeat" { t = ex_arrayrepeat(ck, e, hint); }
    else if k == "Ternary" { t = ex_ternary(ck, e, hint); }
    else if k == "FStr" { t = ex_fstr(ck, e); }
    else if k == "Try" { t = ex_try(ck, e); }
    else if k == "Catch" { t = ex_catch(ck, e); }
    else if k == "OptChain" { t = ex_optchain(ck, e); }
    else if k == "Closure" { t = ex_closure(ck, e, exp); }
    else if k == "OptPayload" { t = e.get("ty").i; }
    else if k == "NamedArg" {
        here(ck, e.span, "named arguments only work when calling a function that is declared with `fn`", "not allowed here",
             "pass the value positionally");
        check(ck, e.node_of("expr"), -1, false);
        t = types.POISON;
    }
    else { t = unimpl(ck, e, e.kind); }
    set_ty(e, t);
    if tk(ck, t) == types.K_EU && !eu && ck.try_stack.len > 0 && e.kind == "Call" { return auto_try(ck, e, t); }
    if tk(ck, t) == types.K_EU && !eu {
        let ts = ty_str(ck, t);
        here(ck, e.span, format("unhandled error union `{ts}`"), "this call can fail",
             "propagate with `try expr`, or handle it with `expr catch default` / `expr catch |e| { ... }`");
        set_ty(e, types.POISON);
        return types.POISON;
    }
    return t;
}

// ---- literals -------------------------------------------------------------------------------------------------------------

pub fn suffix_type(s: str) -> i64 {
    if s == "f32" { return types.F32; }
    if s == "f64" { return types.F64; }
    return types.prim_named(s);
}

pub fn ex_int(ck: *Checker, e: *ast.Node, exp: i64, neg: bool) -> i64 {
    let mag = int_text(e);
    let mut ty = types.I32;
    if has_suffix(e) { ty = suffix_type(e.str_of("suffix")); }
    else if exp >= 0 && types.is_int(exp) { ty = exp; }
    if types.is_int(ty) {
        let isneg = neg && mag != "0";
        if !in_range(isneg, mag, ty) {
            let mut hint = String.empty();
            let sg0 = isneg ? "-" : "";
            if !has_suffix(e) && (exp < 0 || !types.is_int(exp)) {
                if in_range(isneg, mag, types.I64) {
                    hint = format("integers default to `i32`; write `{sg0}{mag}i64` or annotate the variable type");
                } else if in_range(isneg, mag, types.U64) {
                    hint = format("integers default to `i32`; write `{sg0}{mag}u64` or annotate the variable type");
                }
            }
            let ts = ty_str(ck, ty);
            let sign = isneg ? "-" : "";
            here(ck, e.span, format("integer literal `{sign}{mag}` is out of range for `{ts}`"),
                 format("valid range is {lo_text(ty)}..={hi_text(ty)}"), hint);
        }
    }
    return ty;
}

pub fn ex_float(e: *ast.Node, exp: i64, ck: *Checker) -> i64 {
    if has_suffix(e) { return suffix_type(e.str_of("suffix")); }
    if exp >= 0 && types.is_float(exp) { return exp; }
    return types.F64;
}

// ---- names ------------------------------------------------------------------------------------------------------------------

pub fn fn_value(ck: *Checker, e: *ast.Node, sid: i64) -> i64 {
    let name = String.from(ck.syms.at(sid).name);
    if ck.syms.at(sid).tparams.len > 0 {
        here(ck, e.span, format("generic function `{name}` cannot be used as a value"), "",
             "call it directly, or write a small non-generic wrapper function");
        return types.POISON;
    }
    if ck.syms.at(sid).variadic {
        here(ck, e.span, format("variadic function `{name}` cannot be used as a value"), "", "");
        return types.POISON;
    }
    let mut bad = ck.syms.at(sid).ret == types.POISON;
    for i in 0..ck.syms.at(sid).params.len { if *ck.syms.at(sid).params.at(i) == types.POISON { bad = true; } }
    if bad { return types.POISON; }
    e.set("sym", ast.v_tag(11, sid));
    e.set("mode", ast.v_str("sym"));
    let mut ps = copy_ids(&ck.syms.at(sid).params);
    let rt = ck.syms.at(sid).ret;
    return types.fnty(&ck.types, &ps, rt);
}

pub fn has_id(l: *List<i64>, x: i64) -> bool {
    for i in 0..l.len { if *l.at(i) == x { return true; } }
    return false;
}

pub fn copy_ids(l: *List<i64>) -> List<i64> {
    let mut o: List<i64> = List.new();
    for i in 0..l.len { o.push(*l.at(i)); }
    return o;
}

pub fn ex_ident(ck: *Checker, e: *ast.Node, exp: i64) -> i64 {
    let name = String.from(e.str_of("name"));
    let mi = ck.cur_mod;
    if name == "null" && lookup_local(ck, "null") < 0 {
        set_flag(e, "is_null", true);
        if exp >= 0 && (tk(ck, exp) == types.K_PTR || tk(ck, exp) == types.K_FN || tk(ck, exp) == types.K_OPT) { return exp; }
        if exp == types.POISON { return types.POISON; }
        here(ck, e.span, "cannot infer the type of `null`", "",
             "write `null as *T`, or give the variable a pointer or optional type, e.g. `let p: *i32 = null;` or `let n: i32? = null;`");
        return types.POISON;
    }
    let loc = lookup_local(ck, name);
    if loc >= 0 {
        ck.locals.at(loc).used = true;
        e.set("local", ast.v_tag(12, loc));
        if ck.locals.at(loc).region_handle {
            here(ck, e.span, format("the region `{name}` can only be used as the last argument of `alloc_in`"), "",
                 format("write `alloc_in(T, n, {name})`"));
            return types.POISON;
        }
        let mv = moved_at(&ck.moved, loc);
        if mv >= 0 && !(e.span.line == ck.reinit_line && e.span.col == ck.reinit_col) && !has_id(&ck.opt_consumed, e.span.line * 1048576 + e.span.col) {
            let ml = ck.moved.at(mv).line;
            here_n(ck, e.span, format("use of moved value `{name}`"), "value used after it was moved",
                   format("move it only once, pass a pointer (`&{name}`) instead, or re-assign it before using it again"),
                   format("`{name}` was moved at line {ml}, and its type has a destructor, so it cannot be copied"));
        }
        return ck.locals.at(loc).ty;
    }
    let sym = lookup_sym(ck, mi, name);
    if sym >= 0 {
        let kd = String.from(ck.syms.at(sym).kind);
        if kd == "const" || kd == "error" {
            e.set("sym", ast.v_tag(11, sym));
            return ck.syms.at(sym).ty;
        }
        if kd == "fn" { return fn_value(ck, e, sym); }
        let what = kd == "fn" ? "function" : kd;
        let h = kd == "struct" ? format("construct it with `{name} {{ field: value }}`") : String.empty();
        here(ck, e.span, format("expected a value, found {what} `{name}`"), "", h);
        return types.POISON;
    }
    let im = import_of(ck, mi, name);
    if im >= 0 {
        ck.cmods.at(mi).imports.at(im).used = true;
        here(ck, e.span, format("expected a value, found module `{name}`"), "", format("access its members with `{name}.name`"));
        return types.POISON;
    }
    let mut cands: List<String> = List.new();
    for si in 0..ck.scopes.len { for q in 0..ck.scopes.at(si).names.len { cands.push(String.from(*ck.scopes.at(si).names.at(q))); } }
    syms_of_kind_names(ck, mi, "const", "error", &cands);
    let sg = diag.suggest_list(name, &cands);
    here(ck, e.span, format("cannot find value `{name}` in this scope"), "not found",
         sg.len > 0 ? format("a similar name exists: `{sg}`") : String.empty());
    return types.POISON;
}

pub fn variant_index(ck: *Checker, sid: i64, name: str) -> i64 {
    for i in 0..ck.syms.at(sid).variants.len { if *ck.syms.at(sid).variants.at(i) == name { return i; } }
    return -1;
}

pub fn ex_field(ck: *Checker, e: *ast.Node, exp: i64) -> i64 {
    let ent = entity(ck, e);
    let name = String.from(e.str_of("name"));
    let nsp = e.get("name_span").span;
    if ent.kind != 0 {
        if ent.kind == 3 { return types.POISON; }
        if ent.kind == 2 {
            let sid = ent.idx;
            let kd = String.from(ck.syms.at(sid).kind);
            if kd == "const" || kd == "error" {
                e.set("mode", ast.v_str("sym"));
                e.set("sym", ast.v_tag(11, sid));
                return ck.syms.at(sid).ty;
            }
            if kd == "fn" { return fn_value(ck, e, sid); }
            let sn = String.from(ck.syms.at(sid).name);
            here(ck, e.span, format("expected a value, found {kd} `{sn}`"), "", "");
            return types.POISON;
        }
        here(ck, e.span, "expected a value, found module", "", "");
        return types.POISON;
    }
    let ent2 = entity(ck, e.node_of("obj"));
    if ent2.kind != 0 {
        if ent2.kind == 3 { return types.POISON; }
        if ent2.kind == 2 && ck.syms.at(ent2.idx).kind == "enum" {
            let sid = ent2.idx;
            let vi = variant_index(ck, sid, name);
            let sn = String.from(ck.syms.at(sid).name);
            if vi < 0 {
                let sg = diag.suggest_list(name, &ck.syms.at(sid).variants);
                here(ck, nsp, format("enum `{sn}` has no variant `{name}`"), "", sg.len > 0 ? format("did you mean `{sg}`?") : String.empty());
                return types.POISON;
            }
            e.set("mode", ast.v_str("variant"));
            e.set("sym", ast.v_tag(11, sid));
            e.set("vidx", ast.v_int(vi));
            return ck.syms.at(sid).ty;
        }
        if ent2.kind == 2 {
            let sn = String.from(ck.syms.at(ent2.idx).name);
            let sk = String.from(ck.syms.at(ent2.idx).kind);
            here(ck, e.span, format("`{sn}` is a {sk}, which has no members to access with `.`"), "", "");
            return types.POISON;
        }
        here(ck, e.node_of("obj").span, "expected a value, found module", "", "");
        return types.POISON;
    }
    let mut ot = check(ck, e.node_of("obj"), -1, false);
    if ot == types.POISON { return types.POISON; }
    while tk(ck, ot) == types.K_PTR && tk(ck, ck.types.tys.at(ot).inner) == types.K_PTR {
        let w = unary_node(e.node_of("obj").span, "*", e.node_of("obj"));
        e.set("obj", ast.v_node(w));
        ot = check(ck, e.node_of("obj"), -1, false);
    }
    let mut base = ot;
    e.set("mode", ast.v_str("field"));
    if tk(ck, ot) == types.K_PTR {
        let pi = ck.types.tys.at(ot).inner;
        let pk = tk(ck, pi);
        if pk == types.K_STRUCT || pk == types.K_ARR || pk == types.K_SLICE || pi == types.STR || pi == types.STRING {
            base = pi;
            e.set("mode", ast.v_str("ptrfield"));
        }
    }
    let bk = tk(ck, base);
    if bk == types.K_ARR || bk == types.K_SLICE || base == types.STR || base == types.STRING {
        if name == "ptr" && (bk == types.K_SLICE || base == types.STR || base == types.STRING) {
            e.set("mode", ast.v_str("slice_ptr"));
            return types.ptr(&ck.types, bk == types.K_SLICE ? ck.types.tys.at(base).inner : types.U8, false);
        }
        if name == "len" {
            e.set("mode", ast.v_str(bk == types.K_ARR ? "len_arr" : "len_slice"));
            return types.I64;
        }
        if name == "cap" && base == types.STRING {
            e.set("mode", ast.v_str("cap"));
            return types.I64;
        }
        let bs = ty_str(ck, base);
        here(ck, nsp, format("type `{bs}` has no field `{name}`"), "",
             base == types.STRING ? "the available fields are `len`, `ptr` and `cap`" : "the available fields are `len` and `ptr`");
        return types.POISON;
    }
    if bk == types.K_STRUCT {
        let sid = ck.types.tys.at(base).sym;
        let fi = find_field(ck, sid, name);
        let sn = String.from(ck.syms.at(sid).name);
        if fi < 0 {
            let mut fns: List<String> = List.new();
            for i in 0..ck.syms.at(sid).fields.len { fns.push(String.from(ck.syms.at(sid).fields.at(i).name)); }
            let sg = diag.suggest_list(name, &fns);
            let mut all = String.empty();
            for i in 0..fns.len { if i > 0 { all.append(", "); } all.append(*fns.at(i)); }
            here(ck, nsp, format("struct `{sn}` has no field `{name}`"), "", sg.len > 0 ? format("did you mean `{sg}`?") : format("fields: {all}"));
            return types.POISON;
        }
        return ck.syms.at(sid).fields.at(fi).ty;
    }
    let os = ty_str(ck, ot);
    here(ck, nsp, format("type `{os}` has no field `{name}`"), "not a struct", "");
    return types.POISON;
}

// ---- places ----------------------------------------------------------------------------------------------------------------

pub fn is_place(e: *ast.Node) -> bool {
    let k: str = e.kind;
    if k == "Ident" { return e.has("local") && e.get("local").tag == 12; }
    if k == "Field" { return e.has("mode") && (e.str_of("mode") == "field" || e.str_of("mode") == "ptrfield"); }
    if k == "Index" { return true; }
    if k == "Unary" && e.str_of("op") == "*" { return true; }
    return false;
}

// is `e` the `self` of the method being checked, declared with plain `self` (not `mut self`)?
pub fn readonly_self(ck: *Checker, e: *ast.Node) -> bool {
    if e.kind != "Ident" { return false; }
    if !(e.has("local") && e.get("local").tag == 12) { return false; }
    let loc = e.get("local").i;
    return ck.locals.at(loc).is_param && ck.locals.at(loc).name == "self" && ck.has_fn && ck.fn_sym >= 0
        && ck.syms.at(ck.fn_sym).has_self && !ck.syms.at(ck.fn_sym).self_mut;
}

pub fn ptr_ro_of(ck: *Checker, t: i64) -> bool { return tk(ck, t) == types.K_PTR && ck.types.tys.at(t).ro; }

// true when `e` is not a mutable place; `label` and `help` then explain why
pub fn place_mut(ck: *Checker, e: *ast.Node, label: *String, help: *String) -> bool {
    let k: str = e.kind;
    if k == "Ident" {
        let loc = e.get("local").i;
        let nm = String.from(ck.locals.at(loc).name);
        if ck.locals.at(loc).is_mut {
            if ck.locals.at(loc).captured { ck.locals.at(loc).written = true; }
            return false;
        }
        let ts = ty_str(ck, ck.locals.at(loc).ty);
        if ck.locals.at(loc).is_param {
            *label = format("`{nm}` is a parameter, and parameters are immutable by default");
            *help = format("declare it as `mut {nm}: {ts}` in the parameter list");
            return true;
        }
        *label = format("`{nm}` is declared without `mut`");
        *help = format("declare it with `let mut {nm}`");
        return true;
    }
    if k == "Field" {
        if e.str_of("mode") == "ptrfield" {
            if ptr_ro_of(ck, ety(e.node_of("obj"))) {
                *label = String.from("this pointer is `*const`, so nothing may be written through it");
                *help = String.from("take a `*T` (without `const`) if the function must change the value");
                return true;
            }
            if readonly_self(ck, e.node_of("obj")) {
                *label = String.from("this method takes `self`, which only reads the object");
                *help = String.from("declare the method with `mut self` so it may change its fields (the caller then needs `let mut`)");
                return true;
            }
            return false;
        }
        return place_mut(ck, e.node_of("obj"), label, help);
    }
    if k == "Index" {
        let ot = ety(e.node_of("obj"));
        if tk(ck, ot) == types.K_ARR || ot == types.STRING { return place_mut(ck, e.node_of("obj"), label, help); }
        if ot == types.STR {
            *label = String.from("strings are immutable");
            *help = String.from("use a `[]u8` slice created with `alloc(u8, n)`");
            return true;
        }
        return false;
    }
    if k == "Unary" && e.str_of("op") == "*" {
        if ptr_ro_of(ck, ety(e.node_of("expr"))) {
            *label = String.from("this pointer is `*const`, so nothing may be written through it");
            *help = String.from("take a `*T` (without `const`) if the function must change the value");
            return true;
        }
        return false;
    }
    *label = String.from("not an assignable place");
    *help = String.empty();
    return true;
}

// does the place `e` lie behind a `*const` pointer?
pub fn through_ro(ck: *Checker, e: *ast.Node) -> bool {
    let k: str = e.kind;
    if k == "Field" {
        if e.str_of("mode") == "ptrfield" { return ptr_ro_of(ck, ety(e.node_of("obj"))) || readonly_self(ck, e.node_of("obj")); }
        return through_ro(ck, e.node_of("obj"));
    }
    if k == "Index" {
        return tk(ck, ety(e.node_of("obj"))) == types.K_ARR ? through_ro(ck, e.node_of("obj")) : false;
    }
    if k == "Unary" && e.str_of("op") == "*" { return ptr_ro_of(ck, ety(e.node_of("expr"))); }
    return false;
}

// ---- operators ----------------------------------------------------------------------------------------------------------------

pub fn ex_unary(ck: *Checker, e: *ast.Node, exp: i64) -> i64 {
    let op: str = e.str_of("op");
    let inner = e.node_of("expr");
    if op == "-" {
        if inner.kind == "Int" && !has_suffix(inner) && !flag(inner, "parenthesized") {
            let lt = (exp >= 0 && types.is_int(exp)) ? exp : types.I32;
            if !types.signed(lt) {
                set_ty(inner, lt);
                let ls = ty_str(ck, lt);
                here(ck, e.span, format("cannot negate an unsigned integer (`{ls}`)"), "", "unsigned values cannot be negative; use a signed type");
                return types.POISON;
            }
            let t = ex_int(ck, inner, exp, true);
            set_ty(inner, t);
            return t;
        }
        let t = check(ck, inner, exp, false);
        if t == types.POISON { return t; }
        if !(types.is_float(t) || (types.is_int(t) && types.signed(t))) {
            let ts = ty_str(ck, t);
            here(ck, e.span, format("cannot apply unary `-` to type `{ts}`"), "",
                 types.is_int(t) ? "negation needs a signed integer or float" : "");
            return types.POISON;
        }
        return t;
    }
    if op == "!" {
        let t = check(ck, inner, types.BOOL, false);
        if t == types.POISON { return t; }
        if t != types.BOOL {
            let ts = ty_str(ck, t);
            here(ck, e.span, format("cannot apply `!` to type `{ts}`"), "", "`!` works on `bool`; use `~` for bitwise not");
            return types.POISON;
        }
        return types.BOOL;
    }
    if op == "~" {
        let t = check(ck, inner, exp, false);
        if t == types.POISON { return t; }
        if !types.is_int(t) {
            let ts = ty_str(ck, t);
            here(ck, e.span, format("cannot apply `~` to type `{ts}`"), "", "");
            return types.POISON;
        }
        return t;
    }
    if op == "*" {
        let t = check(ck, inner, -1, false);
        if t == types.POISON { return t; }
        if tk(ck, t) != types.K_PTR {
            let ts = ty_str(ck, t);
            here(ck, e.span, format("cannot dereference non-pointer type `{ts}`"), "", "");
            return types.POISON;
        }
        let pi = ck.types.tys.at(t).inner;
        if pi == types.VOID {
            here(ck, e.span, "cannot dereference a `*void`", "", "cast it to a typed pointer first: `p as *T`");
            return types.POISON;
        }
        if !sized(ck, pi, ck.cur_mod, e.span) { return types.POISON; }
        return pi;
    }
    // op == "&"
    let exp_inner = (exp >= 0 && tk(ck, exp) == types.K_PTR) ? ck.types.tys.at(exp).inner : -1;
    let t = check(ck, inner, exp_inner, false);
    if t == types.POISON { return t; }
    let ik: str = inner.kind;
    if !is_place(inner) && flag(e, "auto_ref") && (ik == "Call" || ik == "StructLit" || ik == "ArrayLit" || ik == "Binary" || ik == "Try"
        || ik == "Catch" || ik == "Ternary" || ik == "Cast" || ik == "Field" || ik == "Index") {
        set_flag(e, "temp", true);
        return types.ptr(&ck.types, t, false);
    }
    if !is_place(inner) {
        here(ck, e.span, "cannot take the address of a temporary value", "", "store it in a `let mut` variable first");
        return types.POISON;
    }
    if through_ro(ck, inner) { return types.ptr(&ck.types, t, true); }
    if !flag(e, "auto_ref") {
        let mut label = String.empty();
        let mut help = String.empty();
        if place_mut(ck, inner, &label, &help) {
            here(ck, e.span, "cannot take the address of an immutable binding", label, help);
            return types.POISON;
        }
    }
    return types.ptr(&ck.types, t, false);
}

pub fn ex_binary(ck: *Checker, e: *ast.Node, exp: i64) -> i64 {
    let op: str = e.str_of("op");
    let l = e.node_of("l");
    let r = e.node_of("r");
    let opsp = e.get("op_span").span;
    if op == "&&" || op == "||" {
        set_tyn(e, "opty", types.BOOL);
        let lt = check(ck, l, types.BOOL, false);
        let rt = check(ck, r, types.BOOL, false);
        for side in 0..2 {
            let t = side == 0 ? lt : rt;
            let x = side == 0 ? l : r;
            if t != types.POISON && t != types.BOOL {
                let ts = ty_str(ck, t);
                here(ck, x.span, format("`{op}` needs `bool` operands, found `{ts}`"), "",
                     types.is_numeric(t) ? "compare explicitly, e.g. `x != 0`" : "");
                return types.BOOL;
            }
        }
        return types.BOOL;
    }
    if op == "??" { return ex_coalesce(ck, e, exp); }
    let arith_like = is_arith(op) || is_bitwise(op);
    if is_shift(op) {
        let lt = check(ck, l, (exp >= 0 && types.is_int(exp)) ? exp : -1, false);
        let rt = check(ck, r, -1, false);
        set_tyn(e, "opty", lt);
        if lt == types.POISON || rt == types.POISON { return types.POISON; }
        if !types.is_int(lt) || !types.is_int(rt) {
            let ls = ty_str(ck, lt);
            let rs = ty_str(ck, rt);
            here(ck, opsp, format("cannot apply `{op}` to `{ls}` and `{rs}`"), "", "shifts need integer operands");
            return types.POISON;
        }
        return lt;
    }
    let hint = (arith_like && exp >= 0 && types.is_numeric(exp)) ? exp : -1;
    let mut lt = types.POISON;
    let mut rt = types.POISON;
    if untyped(ck, l) && !untyped(ck, r) {
        rt = check(ck, r, -1, false);
        let rk = tk(ck, rt);
        lt = check(ck, l, (types.is_numeric(rt) || rk == types.K_PTR || rk == types.K_FN || rk == types.K_OPT) ? rt : -1, false);
    } else {
        lt = check(ck, l, hint, false);
        let lk = tk(ck, lt);
        rt = check(ck, r, (types.is_numeric(lt) || lk == types.K_PTR || lk == types.K_FN || lk == types.K_OPT) ? lt : -1, false);
    }
    set_tyn(e, "opty", lt);
    if lt == types.POISON || rt == types.POISON { return is_cmp(op) ? types.BOOL : types.POISON; }
    if (op == "==" || op == "!=") && tk(ck, lt) == types.K_OPT && tk(ck, rt) == types.K_OPT && (is_null(ck, l) || is_null(ck, r)) {
        if is_null(ck, l) && is_null(ck, r) { return types.BOOL; }
        set_flag(e, "opt_null", true);
        e.set("opt_side", ast.v_str(is_null(ck, l) ? "r" : "l"));
        set_nil(l, "conv");
        set_nil(r, "conv");
        return types.BOOL;
    }
    if (lt == types.STR || lt == types.STRING) && (rt == types.STR || rt == types.STRING) && (op == "+" || op == "==" || op == "!=") {
        if op == "+" {
            if ck.nostd {
                need_std(ck, ck.cur_mod, opsp, "joining strings with `+`");
                return types.POISON;
            }
            let res = (lt == types.STRING || rt == types.STRING) ? types.STRING : types.STR;
            e.set("strk", ast.v_str(res == types.STRING ? "String" : "str"));
            set_tyn(e, "opty", res);
            return res;
        }
        set_tyn(e, "opty", types.STR);
        return types.BOOL;
    }
    if is_cmp(op) && types.is_int(lt) && types.is_int(rt) {
        let zero_r = int_is_zero(r) && !types.signed(lt);
        let zero_l = int_is_zero(l) && !types.signed(rt);
        if (zero_r && (op == "<" || op == ">=")) || (zero_l && (op == ">" || op == "<=")) {
            let always = (op == "<" || op == ">") ? "false" : "true";
            warn_here(ck, opsp, format("this comparison is always {always}"), "unsigned values are never negative",
                      "remove it, or use a signed type if negative values are possible");
        }
    }
    if !types.eq(&ck.types, lt, rt) && types.is_numeric(lt) && types.is_numeric(rt) {
        let ct = binary_conv(ck, e, lt, rt);
        if ct < 0 { return is_cmp(op) ? types.BOOL : types.POISON; }
        lt = ct;
        rt = ct;
        set_tyn(e, "opty", ct);
    } else {
        set_nil(l, "conv");
        set_nil(r, "conv");
    }
    if !types.eq(&ck.types, lt, rt) {
        let ls = ty_str(ck, lt);
        let rs = ty_str(ck, rt);
        let mut help = format("`{op}` needs both operands to have the same type");
        if types.is_numeric(lt) && types.is_numeric(rt) { help = format("convert one side explicitly, e.g. `x as {ls}`"); }
        else if (lt == types.STR || lt == types.STRING) && op == "+" { help = String.from("convert the other operand with `to_str(x)`"); }
        here(ck, r.span, "mismatched types in binary operation", format("expected `{ls}`, found `{rs}`"), help);
        return is_cmp(op) ? types.BOOL : types.POISON;
    }
    let t = lt;
    let ts = ty_str(ck, t);
    if is_arith(op) {
        let ok = (types.is_numeric(t) && !(op == "%" && types.is_float(t))) || (op == "+" && t == types.STR);
        if !ok {
            here(ck, opsp, format("cannot apply `{op}` to type `{ts}`"), "",
                 (op == "%" && types.is_float(t)) ? "`%` is only defined on integers" : "");
            return types.POISON;
        }
        if (op == "/" || op == "%") && types.is_int(t) && int_is_zero(r) {
            here(ck, r.span, "division by zero", "the divisor is the literal 0", "");
        }
        return t;
    }
    if is_bitwise(op) {
        if !types.is_int(t) {
            here(ck, opsp, format("cannot apply `{op}` to type `{ts}`"), "", "this operator needs integer operands");
            return types.POISON;
        }
        return t;
    }
    let tkind = tk(ck, t);
    if op == "==" || op == "!=" {
        if types.is_numeric(t) || t == types.BOOL || t == types.STR || t == types.ERR || tkind == types.K_ENUM || tkind == types.K_PTR || tkind == types.K_FN {
            return types.BOOL;
        }
        here(ck, opsp, format("cannot compare values of type `{ts}` with `{op}`"), "",
             (tkind == types.K_STRUCT || tkind == types.K_ARR || tkind == types.K_SLICE) ? "compare fields individually" : "");
        return types.BOOL;
    }
    if types.is_numeric(t) { return types.BOOL; }
    here(ck, opsp, format("cannot order values of type `{ts}` with `{op}`"), "", "");
    return types.BOOL;
}

pub fn ex_cast(ck: *Checker, e: *ast.Node, exp: i64) -> i64 {
    let target = resolve_type(ck, e.node_of("tyn"), ck.cur_mod, false);
    let inner = e.node_of("expr");
    let mut hint = -1 as i64;
    let tkd = tk(ck, target);
    if (tkd == types.K_PTR || tkd == types.K_FN) && inner.kind == "Ident" && inner.str_of("name") == "null" {
        hint = target;
    } else if tkd == types.K_PTR && untyped(ck, inner) && !lit_is_float(inner) {
        hint = types.U64;
    } else if untyped(ck, inner) && types.is_numeric(target) {
        let inner_is_float = lit_is_float(inner);
        if types.is_int(target) && !inner_is_float { hint = target; }
        else if types.is_float(target) && inner_is_float { hint = target; }
    }
    let t = check(ck, inner, hint, false);
    if target == types.POISON || t == types.POISON { return target; }
    let tkk = tk(ck, t);
    let mut ok = false;
    if types.eq(&ck.types, t, target) { ok = true; }
    else if types.is_numeric(t) && types.is_numeric(target) { ok = true; }
    else if t == types.BOOL && types.is_int(target) { ok = true; }
    else if tkk == types.K_ENUM && types.is_int(target) { ok = true; }
    else if tkk == types.K_PTR && (types.is_int(target) || tkd == types.K_PTR) { ok = true; }
    else if types.is_int(t) && tkd == types.K_PTR { ok = true; }
    else if tkk == types.K_FN && tkd == types.K_PTR && ck.types.tys.at(target).inner == types.VOID { ok = true; }
    else if tkd == types.K_FN && tkk == types.K_PTR && ck.types.tys.at(t).inner == types.VOID { ok = true; }
    if !ok {
        let mut h = String.empty();
        if types.is_int(t) && target == types.BOOL { h = String.from("compare explicitly: `x != 0`"); }
        else if types.is_int(t) && tkd == types.K_ENUM { h = String.from("enums cannot be created from integers; use `match`"); }
        else if tkk == types.K_FN || tkd == types.K_FN { h = String.from("function pointers convert only to and from `*void`"); }
        let ts = ty_str(ck, t);
        let gs = ty_str(ck, target);
        here(ck, e.span, format("cannot cast `{ts}` to `{gs}`"), "", h);
    }
    return target;
}

pub fn ex_incdec(ck: *Checker, e: *ast.Node) -> i64 {
    let inner = e.node_of("expr");
    let t = check(ck, inner, -1, false);
    if t == types.POISON { return types.POISON; }
    let op = String.from(e.str_of("op"));
    if !types.is_numeric(t) {
        let ts = ty_str(ck, t);
        here(ck, e.span, format("cannot apply `{op}` to type `{ts}`"), "", "`++` and `--` work on integers and floats");
        return types.POISON;
    }
    if !is_place(inner) {
        here(ck, e.span, format("`{op}` needs a variable, field or element to modify"), "not an assignable place", "");
        return types.POISON;
    }
    let mut label = String.empty();
    let mut help = String.empty();
    if place_mut(ck, inner, &label, &help) {
        here(ck, e.span, format("cannot apply `{op}` to an immutable place"), label, help);
    }
    return t;
}

// ---- calls ---------------------------------------------------------------------------------------------------------------------

pub fn is_builtin_name(s: str) -> bool {
    let names = ["print", "println", "format", "panic", "assert", "alloc", "free", "exit", "to_str", "string_new", "string_from",
                 "string_clear", "cstr", "from_cstr", "slice_of", "size_of", "drop", "drop_at", "write_at", "read_at", "gc_collect",
                 "gc_bytes", "gc_collections", "alloc_in", "gc_collect_gen", "gc_gen_bytes", "gc_gen_collections"];
    for i in 0..27 { if names[i] == s { return true; } }
    return false;
}

pub fn callee_is_value(ck: *Checker, c: *ast.Node, ent: Ent) -> bool {
    if c.kind != "Ident" && c.kind != "Field" { return true; }
    if ent.kind != 0 { return false; }
    let mut root = c;
    while root.kind == "Field" { root = root.node_of("obj"); }
    if root.kind != "Ident" { return true; }
    return lookup_local(ck, root.str_of("name")) >= 0;
}

pub fn default_ok(d: *ast.Node) -> bool {
    if d.kind == "Int" || d.kind == "Float" || d.kind == "Bool" || d.kind == "Str" { return true; }
    if d.kind == "Ident" && d.str_of("name") == "null" { return true; }
    return d.kind == "Unary" && d.str_of("op") == "-" && (d.node_of("expr").kind == "Int" || d.node_of("expr").kind == "Float");
}

pub fn param_has_default(p: *ast.Node) -> bool { return p.has("default") && p.get("default").tag != 0; }

// matches the written arguments to the parameters: positional first, then `name = value`, then defaults
pub fn normalize_args(ck: *Checker, e: *ast.Node, sid: i64) -> bool {
    let nid = ck.syms.at(sid).node;
    if !ck.nodes.at(nid).has("params") { return true; }
    let pv = ck.nodes.at(nid).get("params");
    let np = pv.items.len;
    let nargs = e.get("args").items.len;
    let mut has_named = false;
    let mut n_pos = 0 as i64;
    for i in 0..nargs {
        if e.get("args").items.at(i).node.at(0).kind == "NamedArg" { has_named = true; } else { n_pos += 1; }
    }
    let mut any_default = false;
    for i in 0..np { if param_has_default(pv.items.at(i).node.at(0)) { any_default = true; } }
    if !has_named && (n_pos >= np || !any_default) { return true; }
    let off = flag(e, "method_recv") ? 1 : 0;
    let fname = format("function `{ck.syms.at(sid).name}`");
    let sname = String.from(ck.syms.at(sid).name);
    let mut pnames: List<String> = List.new();
    for i in 0..np { pnames.push(String.from(pv.items.at(i).node.at(0).str_of("name"))); }
    // slots: index into the written args (or -1), plus defaults cloned later
    let mut slots: List<i64> = List.new();
    for i in 0..np { slots.push(-1); }
    let mut extra: List<i64> = List.new();
    let mut ok = true;
    let mut seen_named = false;
    let mut pos_seen = 0 as i64;
    for ai in 0..nargs {
        let a = e.get("args").items.at(ai).node.at(0);
        if a.kind == "NamedArg" {
            seen_named = true;
            let an = String.from(a.str_of("name"));
            let mut idx = -1 as i64;
            for q in 0..np { if *pnames.at(q) == an && idx < 0 { idx = q; } }
            let bad = idx < 0 || idx < off || flag(pv.items.at(idx).node.at(0), "self_param");
            if bad {
                let mut rest: List<String> = List.new();
                for q in off..np { rest.push(String.from(*pnames.at(q))); }
                let sg = diag.suggest_list(an, &rest);
                let mut joined = String.empty();
                for q in 0..rest.len { if q > 0 { joined.append(", "); } joined.append(*rest.at(q)); }
                let help = sg.len > 0 ? format("did you mean `{sg}`?") : (rest.len > 0 ? format("parameters: {joined}") : String.empty());
                here(ck, a.get("name_span").span, format("{fname} has no parameter named `{an}`"), "no such parameter", help);
                check(ck, a.node_of("expr"), -1, false);
                ok = false;
                continue;
            }
            if *slots.at(idx) >= 0 {
                here(ck, a.get("name_span").span, format("the argument `{an}` is given twice"), "already supplied", "");
                check(ck, a.node_of("expr"), -1, false);
                ok = false;
                continue;
            }
            *slots.at(idx) = ai;
        } else {
            if seen_named {
                here(ck, a.span, "a positional argument cannot follow a named argument", "", "put the `name = value` arguments last");
                check(ck, a, -1, false);
                ok = false;
                continue;
            }
            let pos = pos_seen;
            pos_seen += 1;
            if pos < np { *slots.at(pos) = ai; } else { extra.push(ai); }
        }
    }
    if !ok {
        for i in 0..np {
            if *slots.at(i) >= 0 {
                let a = e.get("args").items.at(*slots.at(i)).node.at(0);
                let x = a.kind == "NamedArg" ? a.node_of("expr") : a;
                if !x.has("ty") { check(ck, x, -1, false); }
            }
        }
        for i in 0..extra.len {
            let a = e.get("args").items.at(*extra.at(i)).node.at(0);
            if !a.has("ty") { check(ck, a, -1, false); }
        }
        return false;
    }
    let mut missing: List<String> = List.new();
    let mut defaults: List<ast.Node> = List.new();
    let mut default_for: List<i64> = List.new();
    for i in 0..np {
        if *slots.at(i) >= 0 { continue; }
        let p = pv.items.at(i).node.at(0);
        if !param_has_default(p) { missing.push(String.from(*pnames.at(i))); continue; }
        let d = p.node_of("default");
        if !default_ok(d) {
            if !flag(d, "_reported") {
                set_flag(d, "_reported", true);
                here(ck, d.span, "a default value must be a literal", "not a literal", "use a number, string, `true` / `false` or `null`");
            }
            return false;
        }
        defaults.push(ast.clone_node(d));
        default_for.push(i);
    }
    if missing.len > 0 {
        let plural = missing.len > 1 ? "s" : "";
        let mut ms = String.empty();
        for i in 0..missing.len { if i > 0 { ms.append(", "); } ms.append(format("`{*missing.at(i)}`")); }
        let mut sig = format("signature: fn {sname}(");
        for i in off..np {
            if i > off { sig.append(", "); }
            sig.append(*pnames.at(i));
            if param_has_default(pv.items.at(i).node.at(0)) { sig.append("=.."); }
        }
        sig.push(')');
        here_n(ck, e.span, format("{fname} is missing the argument{plural} {ms}"), format("missing argument{plural}"), "", sig);
        for i in 0..np {
            if *slots.at(i) >= 0 {
                let a = e.get("args").items.at(*slots.at(i)).node.at(0);
                check(ck, a.kind == "NamedArg" ? a.node_of("expr") : a, -1, false);
            }
        }
        for i in 0..extra.len { check(ck, e.get("args").items.at(*extra.at(i)).node.at(0), -1, false); }
        return false;
    }
    // rebuild `args` as a plain positional list
    let mut out: List<ast.Val> = List.new();
    let mut di = 0 as i64;
    for i in 0..np {
        if *slots.at(i) >= 0 {
            let a = e.get("args").items.at(*slots.at(i)).node.at(0);
            if a.kind == "NamedArg" { out.push(ast.v_node(ast.clone_node(a.node_of("expr")))); }
            else { out.push(ast.clone_val(e.get("args").items.at(*slots.at(i)))); }
        } else {
            out.push(ast.v_node(ast.clone_node(defaults.at(di))));
            di += 1;
        }
    }
    for i in 0..extra.len { out.push(ast.clone_val(e.get("args").items.at(*extra.at(i)))); }
    e.set("args", ast.v_list(out));
    return true;
}

pub fn vararg(ck: *Checker, a: *ast.Node) {
    let t = check(ck, a, -1, false);
    set_nil(a, "conv");
    let k = tk(ck, t);
    if t == types.POISON || types.is_numeric(t) || t == types.BOOL || k == types.K_PTR || k == types.K_ENUM || k == types.K_FN { return; }
    let ts = ty_str(ck, t);
    here(ck, a.span, format("cannot pass a value of type `{ts}` to a C variadic parameter"), "",
         "pass `cstr(s)` for a C string, or an integer, float, bool or pointer");
}

pub fn check_args(ck: *Checker, e: *ast.Node, params: *List<i64>, name: str, sig: str, variadic: bool) {
    let n = params.len;
    let na = e.get("args").items.len;
    let bad = na < n || (na > n && !variadic);
    if bad {
        let off = flag(e, "method_recv") ? 1 : 0;
        let want = n - off;
        let got = na - off;
        let plural = want != 1 ? "s" : "";
        let atl = variadic ? "at least " : "";
        let was = got == 1 ? "was" : "were";
        here_n(ck, e.span, format("{name} takes {atl}{want} argument{plural} but {got} {was} supplied"), "wrong number of arguments", "",
               sig.len > 0 ? format("signature: {sig}") : String.empty());
    }
    for i in 0..na {
        let a = e.get("args").items.at(i).node.at(0);
        if i < n { expect(ck, a, *params.at(i), false); }
        else if variadic && !bad { vararg(ck, a); }
        else { check(ck, a, -1, false); }
    }
}

pub fn check_all_args(ck: *Checker, e: *ast.Node) {
    for i in 0..e.get("args").items.len { check(ck, e.get("args").items.at(i).node.at(0), -1, false); }
}

pub fn indirect_call(ck: *Checker, e: *ast.Node) -> i64 {
    let c = e.node_of("callee");
    let t = check(ck, c, -1, false);
    if t == types.POISON {
        check_all_args(ck, e);
        return types.POISON;
    }
    if tk(ck, t) != types.K_FN && tk(ck, t) != types.K_CLO {
        let ts = ty_str(ck, t);
        here(ck, c.span, format("cannot call a value of type `{ts}`"), "not a function",
             "only functions, function pointers (`fn(A) -> R`) and closures (`|A| -> R`) can be called");
        check_all_args(ck, e);
        return types.POISON;
    }
    if tk(ck, t) == types.K_CLO { e.set("indirect", ast.v_str("clo")); } else { e.set("indirect", ast.v_bool(true)); }
    let mut ps = copy_ids(&ck.types.tys.at(t).params);
    let ts = ty_str(ck, t);
    check_args(ck, e, &ps, "this function pointer", ts, false);
    return ck.types.tys.at(t).inner;
}

pub fn ex_call(ck: *Checker, e: *ast.Node, exp: i64) -> i64 {
    let r = ex_call_inner(ck, e, exp);
    if e.has("orig_args") {
        let off = flag(e, "method_recv") ? 1 : 0;
        let mut oa: List<ast.Val> = List.new();
        for i in off..e.get("args").items.len { oa.push(ast.clone_val(e.get("args").items.at(i))); }
        e.set("orig_args", ast.v_list(oa));
    }
    return r;
}

pub fn ex_call_inner(ck: *Checker, e: *ast.Node, exp: i64) -> i64 {
    let c = e.node_of("callee");
    let mi = ck.cur_mod;
    if c.kind == "Ident" && is_builtin_name(c.str_of("name")) && lookup_local(ck, c.str_of("name")) < 0 {
        return builtin(ck, e, String.from(c.str_of("name")));
    }
    let mut ent = Ent { kind: 0, idx: -1 };
    if c.kind == "Ident" || c.kind == "Field" { ent = entity(ck, c); }
    if ent.kind == 3 {
        check_all_args(ck, e);
        return types.POISON;
    }
    let mut was_method = false;
    let mut wrapped = false;
    if c.kind == "Field" && (ent.kind == 0 || (ent.kind == 2 && ck.syms.at(ent.idx).kind != "fn")) {
        if !e.has("orig_args") { e.set("orig_args", ast.clone_val(e.get("args"))); }
        e.set("args", ast.clone_val(e.get("orig_args")));
        set_flag(e, "method_recv", false);
        ck.recv_wrap = false;
        let hit = find_method(ck, e);
        wrapped = ck.recv_wrap;
        if hit == -2 { return types.POISON; }
        if hit == -3 { return opt_method(ck, e); }
        if hit >= 0 {
            ent = Ent { kind: 2, idx: hit };
            was_method = true;
        }
    }
    if ent.kind != 2 || ck.syms.at(ent.idx).kind != "fn" {
        if callee_is_value(ck, c, ent) { return indirect_call(ck, e); }
        if c.kind == "Ident" && lookup_local(ck, c.str_of("name")) < 0 && lookup_sym(ck, mi, c.str_of("name")) < 0
            && import_of(ck, mi, c.str_of("name")) < 0 {
            let cn = String.from(c.str_of("name"));
            let mut cands: List<String> = List.new();
            let cm = ck.cmods.at(mi);
            for q in 0..cm.order.len {
                let s = ck.syms.at(*cm.order.at(q));
                if s.kind == "fn" { cands.push(String.from(s.name)); }
            }
            let mut bn: List<String> = List.new();
            let all = ["print", "println", "format", "panic", "assert", "alloc", "free", "exit", "to_str", "string_new", "string_from",
                       "string_clear", "cstr", "from_cstr", "slice_of", "size_of", "drop", "drop_at", "write_at", "read_at", "gc_collect",
                       "gc_bytes", "gc_collections", "alloc_in", "gc_collect_gen", "gc_gen_bytes", "gc_gen_collections"];
            for i in 0..27 { bn.push(String.from(all[i])); }
            let sbn = sorted_names(&bn);
            for i in 0..sbn.len { cands.push(String.from(*sbn.at(i))); }
            let sg = diag.suggest_list(cn, &cands);
            here(ck, c.span, format("cannot find function `{cn}` in this scope"), "not found",
                 sg.len > 0 ? format("a similar function exists: `{sg}`") : String.empty());
        } else if c.kind == "Field" && c.node_of("obj").kind == "Ident" && ent.kind == 0 && lookup_local(ck, c.node_of("obj").str_of("name")) < 0
            && lookup_sym(ck, mi, c.node_of("obj").str_of("name")) < 0 && import_of(ck, mi, c.node_of("obj").str_of("name")) < 0 {
            let on = String.from(c.node_of("obj").str_of("name"));
            here(ck, c.node_of("obj").span, format("cannot find module or value `{on}` in this scope"), "",
                 format("add `import {on};` if it is a module"));
        } else if ent.kind == 2 && ck.syms.at(ent.idx).kind == "struct" {
            let sn = String.from(ck.syms.at(ent.idx).name);
            here(ck, c.span, format("`{sn}` is a struct, not a function"), "", format("construct it with `{sn} {{ field: value }}`"));
        } else {
            here(ck, c.span, "this expression is not callable", "", "only functions and function pointers can be called");
        }
        check_all_args(ck, e);
        return types.POISON;
    }
    let mut sid = ent.idx;
    if !normalize_args(ck, e, sid) { return types.POISON; }
    if ck.syms.at(sid).tparams.len > 0 {
        sid = instantiate_call(ck, e, sid, exp);
        if sid < 0 { return types.POISON; }
    } else if e.has("targs") && e.get("targs").items.len > 0 {
        let sn = String.from(ck.syms.at(sid).name);
        here(ck, e.span, format("function `{sn}` is not generic and takes no type arguments"), "", "");
    }
    e.set("sym", ast.v_tag(11, sid));
    let sn = String.from(ck.syms.at(sid).name);
    let mut sig = format("fn {sn}(");
    let nid = ck.syms.at(sid).node;
    for i in 0..ck.syms.at(sid).params.len {
        if i > 0 { sig.append(", "); }
        let pn = String.from(ck.nodes.at(nid).get("params").items.at(i).node.at(0).str_of("name"));
        let pt = ty_str(ck, *ck.syms.at(sid).params.at(i));
        sig.append(format("{pn}: {pt}"));
    }
    if ck.syms.at(sid).variadic { sig.append(", ..."); }
    sig.push(')');
    if ck.syms.at(sid).ret != types.VOID { sig.append(format(" -> {ty_str(ck, ck.syms.at(sid).ret)}")); }
    let mut ps = copy_ids(&ck.syms.at(sid).params);
    check_args(ck, e, &ps, format("function `{sn}`"), sig, ck.syms.at(sid).variadic);
    if was_method && flag(e, "method_recv") { sync_receiver(ck, e, wrapped); }
    return ck.syms.at(sid).ret;
}

// ---- generic calls -----------------------------------------------------------------------------------------------------------

pub fn b_has(b: *List<NameTy>, n: str) -> bool {
    for i in 0..b.len { if b.at(i).name == n { return true; } }
    return false;
}

pub fn b_get(b: *List<NameTy>, n: str) -> i64 {
    for i in 0..b.len { if b.at(i).name == n { return b.at(i).ty; } }
    return -1;
}

pub fn is_tparam(ck: *Checker, sid: i64, name: str) -> bool {
    for i in 0..ck.syms.at(sid).tparams.len { if *ck.syms.at(sid).tparams.at(i) == name { return true; } }
    return false;
}

// binds type parameters of `sid` by matching the type AST `tn` against the concrete type `ty`
pub fn unify(ck: *Checker, tn: *ast.Node, ty: i64, sid: i64, b: *List<NameTy>) {
    if ty < 0 || ty == types.POISON { return; }
    let k: str = tn.kind;
    let tkd = tk(ck, ty);
    if k == "TName" {
        let np = tn.get("path").items.len;
        let na = tn.get("args").items.len;
        if np == 1 && is_tparam(ck, sid, tn.get("path").items.at(0).s) && na == 0 {
            let pn = String.from(tn.get("path").items.at(0).s);
            if !b_has(b, pn) { b.push(NameTy { name: pn, ty: ty }); }
        } else if na > 0 && tkd == types.K_STRUCT {
            let ss = ck.types.tys.at(ty).sym;
            let base = ck.syms.at(ss).base;
            if base >= 0 && ck.syms.at(base).name == tn.get("path").items.at(np - 1).s {
                let mut n = na;
                if ck.syms.at(ss).targs.len < n { n = ck.syms.at(ss).targs.len; }
                for i in 0..n { unify(ck, tn.get("args").items.at(i).node.at(0), *ck.syms.at(ss).targs.at(i), sid, b); }
            }
        }
    } else if (k == "TPtr" && tkd == types.K_PTR) || (k == "TSlice" && tkd == types.K_SLICE) || (k == "TArray" && tkd == types.K_ARR)
        || (k == "TErrUnion" && tkd == types.K_EU) {
        unify(ck, tn.node_of("inner"), ck.types.tys.at(ty).inner, sid, b);
    } else if (k == "TFn" && tkd == types.K_FN) || (k == "TClo" && tkd == types.K_CLO) {
        if tn.get("params").items.len == ck.types.tys.at(ty).params.len {
            for i in 0..tn.get("params").items.len {
                unify(ck, tn.get("params").items.at(i).node.at(0), *ck.types.tys.at(ty).params.at(i), sid, b);
            }
            if !tn.is_none("ret") { unify(ck, tn.node_of("ret"), ck.types.tys.at(ty).inner, sid, b); }
        }
    }
}

pub fn tn_known(ck: *Checker, x: *ast.Node, sid: i64, b: *List<NameTy>) -> bool {
    if x.kind == "TName" {
        if x.get("path").items.len == 1 && is_tparam(ck, sid, x.get("path").items.at(0).s) && !b_has(b, x.get("path").items.at(0).s)
            && x.get("args").items.len == 0 { return false; }
        for i in 0..x.get("args").items.len { if !tn_known(ck, x.get("args").items.at(i).node.at(0), sid, b) { return false; } }
        return true;
    }
    if x.has("inner") && !x.is_none("inner") { return tn_known(ck, x.node_of("inner"), sid, b); }
    return true;
}

// the closure type a closure argument is checked against: the parameter types known so far (the rest unknown)
pub fn clo_hint(ck: *Checker, tn: *ast.Node, sid: i64, b: *List<NameTy>) -> i64 {
    let smi = ck.syms.at(sid).mod_idx;
    let saved_mod = ck.cur_mod;
    let mut env: List<NameTy> = List.new();
    for i in 0..b.len { env.push(NameTy { name: String.from(b.at(i).name), ty: b.at(i).ty }); }
    for i in 0..ck.tenv.len { if !b_has(b, ck.tenv.at(i).name) { env.push(NameTy { name: String.from(ck.tenv.at(i).name), ty: ck.tenv.at(i).ty }); } }
    let saved_env = tenv_replace(ck, env);
    ck.cur_mod = smi;
    let mut ps: List<i64> = List.new();
    for i in 0..tn.get("params").items.len {
        let x = tn.get("params").items.at(i).node.at(0);
        ps.push(tn_known(ck, x, sid, b) ? resolve_type(ck, x, smi, false) : types.POISON);
    }
    let mut ret = types.VOID;
    if !tn.is_none("ret") {
        let r = tn.node_of("ret");
        ret = tn_known(ck, r, sid, b) ? resolve_type(ck, r, smi, true) : types.POISON;
    }
    ck.cur_mod = saved_mod;
    tenv_replace(ck, saved_env);
    return types.clo(&ck.types, &ps, ret);
}

pub fn is_bare_param(ck: *Checker, tn: *ast.Node, sid: i64, b: *List<NameTy>) -> bool {
    return tn.kind == "TName" && tn.get("path").items.len == 1 && is_tparam(ck, sid, tn.get("path").items.at(0).s)
        && b_has(b, tn.get("path").items.at(0).s);
}

pub fn report_uninferred(ck: *Checker, sp: ast.Span, sid: i64, b: *List<NameTy>, is_fn: bool) {
    let mut names = String.empty();
    let mut all = String.empty();
    let mut n = 0;
    for i in 0..ck.syms.at(sid).tparams.len {
        let tp = String.from(*ck.syms.at(sid).tparams.at(i));
        if i > 0 { all.append(", "); }
        all.append(tp);
        if !b_has(b, tp) {
            if n > 0 { names.append(", "); }
            names.append(format("`{tp}`"));
            n += 1;
        }
    }
    let sn = String.from(ck.syms.at(sid).name);
    let s = n > 1 ? "s" : "";
    here(ck, sp, format("cannot infer type parameter{s} {names} of `{sn}`"), "type annotations needed",
         is_fn ? format("specify explicitly, e.g. `{sn}<{all}>(...)`") : String.from("annotate the variable or give the fields concrete values"));
}

// checks an argument only to learn its type: the moves it makes are undone, since the real check comes later
pub fn probe(ck: *Checker, a: *ast.Node) -> i64 {
    let saved = copy_moved(&ck.moved);
    let t = check(ck, a, -1, false);
    ck.moved = saved;
    return t;
}

// returns the instance symbol, or -1
pub fn instantiate_call(ck: *Checker, e: *ast.Node, sid: i64, exp: i64) -> i64 {
    let nid = ck.syms.at(sid).node;
    let ntp = ck.syms.at(sid).tparams.len;
    let nparams = ck.nodes.at(nid).get("params").items.len;
    let nargs = e.get("args").items.len;
    let sn = String.from(ck.syms.at(sid).name);
    if nargs != nparams {
        let off = flag(e, "method_recv") ? 1 : 0;
        let want = nparams - off;
        let got = nargs - off;
        let pl = want != 1 ? "s" : "";
        let wv = got == 1 ? "was" : "were";
        here(ck, e.span, format("function `{sn}` takes {want} argument{pl} but {got} {wv} supplied"),
             "wrong number of arguments", "");
        check_all_args(ck, e);
        return -1;
    }
    let mut b: List<NameTy> = List.new();
    let nt = e.has("targs") ? e.get("targs").items.len : 0;
    if nt > 0 {
        if nt != ntp {
            let pl = ntp != 1 ? "s" : "";
            let wv = nt == 1 ? "was" : "were";
            here(ck, e.span, format("`{sn}` takes {ntp} type argument{pl} but {nt} {wv} supplied"), "", "");
            return -1;
        }
        for i in 0..ntp {
            let ty = resolve_type(ck, e.get("targs").items.at(i).node.at(0), ck.cur_mod, false);
            if ty == types.POISON { return -1; }
            b.push(NameTy { name: String.from(*ck.syms.at(sid).tparams.at(i)), ty: ty });
        }
    } else {
        for i in 0..nargs {
            let a = e.get("args").items.at(i).node.at(0);
            let ptn = ck.nodes.at(nid).get("params").items.at(i).node.at(0).node_of("tyn");
            if !untyped(ck, a) && a.kind != "Closure" { unify(ck, ptn, probe(ck, a), sid, &b); }
        }
        for i in 0..nargs {
            let a = e.get("args").items.at(i).node.at(0);
            let ptn = ck.nodes.at(nid).get("params").items.at(i).node.at(0).node_of("tyn");
            if untyped(ck, a) && a.kind != "Closure" && !is_bare_param(ck, ptn, sid, &b) { unify(ck, ptn, probe(ck, a), sid, &b); }
        }
        for i in 0..nargs {
            let a = e.get("args").items.at(i).node.at(0);
            let ptn = ck.nodes.at(nid).get("params").items.at(i).node.at(0).node_of("tyn");
            if a.kind == "Closure" && ptn.kind == "TClo" {
                let h = clo_hint(ck, ptn, sid, &b);
                unify(ck, ptn, check(ck, a, h, false), sid, &b);
            } else if a.kind == "Closure" { check(ck, a, -1, false); }
        }
        if exp >= 0 && exp != types.POISON && !ck.nodes.at(nid).is_none("ret") {
            let mut r = ck.nodes.at(nid).node_of("ret");
            let mut ex = exp;
            let mut go = true;
            if r.kind == "TErrUnion" {
                r = r.node_of("inner");
                if tk(ck, exp) == types.K_EU { ex = ck.types.tys.at(exp).inner; } else { go = false; }
            }
            if go { unify(ck, r, ex, sid, &b); }
        }
    }
    let mut missing = false;
    for i in 0..ntp { if !b_has(&b, *ck.syms.at(sid).tparams.at(i)) { missing = true; } }
    if missing {
        let mut poisoned = false;
        for i in 0..nargs {
            let a = e.get("args").items.at(i).node.at(0);
            if a.has("ty") && a.get("ty").i == types.POISON { poisoned = true; }
        }
        if !poisoned { report_uninferred(ck, e.span, sid, &b, true); }
        check_all_args(ck, e);
        return -1;
    }
    let mut targs: List<i64> = List.new();
    for i in 0..ntp { targs.push(b_get(&b, *ck.syms.at(sid).tparams.at(i))); }
    return inst_fn(ck, sid, &targs, ck.cur_mod, e.span);
}

// the receiver node is shared between `callee.obj` and the first argument in the Python tree: copy the checked one back
pub fn sync_receiver(ck: *Checker, e: *ast.Node, wrapped: bool) {
    let first = e.get("args").items.at(0).node.at(0);
    let orig = e.node_of("callee").node_of("obj");
    let mut recv = ast.clone_node(first);
    if wrapped { recv = ast.clone_node(first.node_of("expr")); }
    let c = e.node_of("callee");
    c.set("obj", ast.v_node(recv));
    let mut oa: List<ast.Val> = List.new();
    for i in 1..e.get("args").items.len { oa.push(ast.clone_val(e.get("args").items.at(i))); }
    e.set("orig_args", ast.v_list(oa));
}

// ---- statements ----------------------------------------------------------------------------------------------------------------

pub fn check_block(ck: *Checker, b: *ast.Node, scope: bool) {
    if scope { push_scope(ck); }
    let mut warned = false;
    let mut dead = false;
    let n = b.get("stmts").items.len;
    for i in 0..n {
        let s = b.get("stmts").items.at(i).node.at(0);
        if dead && !warned {
            warn_here(ck, s.span, "unreachable statement", "this code is never executed", "");
            warned = true;
        }
        check_stmt(ck, s);
        if !dead && terminates(ck, s) { dead = true; }
    }
    if scope { pop_scope(ck); }
}

pub fn check_stmt(ck: *Checker, s: *ast.Node) {
    let k: str = s.kind;
    if k == "Block" { check_block(ck, s, true); }
    else if k == "Let" { st_let(ck, s); }
    else if k == "If" { st_if(ck, s); }
    else if k == "While" { in_loop(ck, s, true); }
    else if k == "Loop" { in_loop(ck, s, false); }
    else if k == "Return" { st_return(ck, s); }
    else if k == "Break" { st_break(ck, s, true); }
    else if k == "Continue" { st_break(ck, s, false); }
    else if k == "ExprStmt" { st_exprstmt(ck, s); }
    else if k == "Assign" { st_assign(ck, s); }
    else if k == "For" { st_for(ck, s); }
    else if k == "Region" { st_region(ck, s); }
    else if k == "Match" { st_match(ck, s); }
    else if k == "Throw" { st_throw(ck, s); }
    else if k == "TryBlock" { st_tryblock(ck, s); }
    else { here(ck, s.span, format("UNIMPLEMENTED in the Crumbs checker: statement {k}"), "", ""); }
}

pub fn st_let(ck: *Checker, s: *ast.Node) {
    let has_ann = !s.is_none("tyn");
    let ann = has_ann ? resolve_type(ck, s.node_of("tyn"), ck.cur_mod, false) : -1;
    let init = s.node_of("init");
    let mut t = check(ck, init, ann, false);
    let is_alloc = init.kind == "Call" && init.has("builtin") && init.str_of("builtin") == "alloc" && t != types.POISON;
    set_flag(s, "afree", is_alloc && !has_glue(ck, init.get("elem").i));
    if has_ann && ann == types.STR && t == types.STRING {
        set_flag(init, "coerce", true);
        t = types.STR;
    }
    set_nil(init, "conv");
    let mut ty = types.POISON;
    if has_ann {
        if tk(ck, ann) == types.K_OPT && !types.same(&ck.types, t, ann) { coerce(ck, init, t, ann); }
        else if types.is_numeric(ann) && types.is_numeric(t) && t != ann { apply_conv(ck, init, t, ann); }
        else if ro_violation(ck, init, t, ann) { }
        else if ptr_ok(ck, ann, t) { }
        else if !types.same(&ck.types, t, ann) { mismatch(ck, init, ann, t, "mismatched types"); }
        else { consume(ck, init); }
        ty = ann;
    } else {
        ty = t;
        consume(ck, init);
    }
    if ty == types.VOID {
        here(ck, init.span, "cannot bind a `void` value to a variable", "this expression produces no value", "");
        ty = types.POISON;
    }
    if ty != types.POISON && !sized(ck, ty, ck.cur_mod, init.span) { ty = types.POISON; }
    let name = String.from(s.str_of("name"));
    if name == "_" {
        set_nil(s, "local");
        set_flag(s, "drop_temp", ty != types.POISON && has_glue(ck, ty));
        return;
    }
    let loc = declare_local(ck, name, ty, flag(s, "mut"), s.get("name_span").span, false);
    s.set("local", ast.v_tag(12, loc));
    if ty != types.POISON && holds_ptr(ck, ty) { ck.locals.at(loc).taint = taint(ck, s.node_of("init")); }
}

pub fn cond(ck: *Checker, c: *ast.Node) {
    let t = check(ck, c, types.BOOL, false);
    if !types.same(&ck.types, t, types.BOOL) { mismatch(ck, c, types.BOOL, t, "condition must be a `bool`"); }
}

pub fn st_if(ck: *Checker, s: *ast.Node) {
    cond(ck, s.node_of("cond"));
    let mut m0 = copy_moved(&ck.moved);
    check_block(ck, s.node_of("then"), true);
    let mut states: List<List<MovedEnt>> = List.new();
    if !terminates(ck, s.node_of("then")) { states.push(copy_moved(&ck.moved)); }
    ck.moved = copy_moved(&m0);
    if !s.is_none("els") {
        let els = s.node_of("els");
        if els.kind == "If" { st_if(ck, els); } else { check_block(ck, els, true); }
        if !terminates(ck, els) { states.push(copy_moved(&ck.moved)); }
    } else {
        states.push(copy_moved(&ck.moved));
    }
    ck.moved = merge_moved(&m0, &states);
}

pub fn loop_body(ck: *Checker, s: *ast.Node, mode: i64, vt: i64) {
    if mode == 1 { cond(ck, s.node_of("cond")); }
    if mode == 2 {
        push_scope(ck);
        let var = String.from(s.str_of("var"));
        if var != "_" {
            let loc = declare_local(ck, var, vt, false, s.get("var_span").span, false);
            ck.locals.at(loc).used = true;
            s.set("local", ast.v_tag(12, loc));
        } else { set_nil(s, "local"); }
        check_block(ck, s.node_of("body"), true);
        pop_scope(ck);
        return;
    }
    check_block(ck, s.node_of("body"), true);
}

// checks a loop body (twice if it moves an outer variable) and computes the moved-set after the loop
pub fn in_loop(ck: *Checker, s: *ast.Node, is_while: bool) { in_loop_m(ck, s, is_while ? 1 : 0, is_while, -1); }

pub fn in_loop_m(ck: *Checker, s: *ast.Node, mode: i64, is_while: bool, vt: i64) {
    let mut m0 = copy_moved(&ck.moved);
    let start_id = ck.locals.len;
    ck.loop_stack.push(LoopFrame { breaks: List.new(), conts: List.new() });
    ck.fn_loops += 1;
    loop_body(ck, s, mode, vt);
    let body = s.node_of("body");
    let mut carry: List<List<MovedEnt>> = List.new();
    if !terminates(ck, body) { carry.push(copy_moved(&ck.moved)); }
    let top = ck.loop_stack.len - 1;
    for i in 0..ck.loop_stack.at(top).conts.len { carry.push(copy_moved(ck.loop_stack.at(top).conts.at(i))); }
    let mut outer: List<MovedEnt> = List.new();
    for si in 0..carry.len {
        for i in 0..carry.at(si).len {
            let l = carry.at(si).at(i).local;
            if moved_at(&m0, l) < 0 && l < start_id { set_moved(&outer, l, carry.at(si).at(i).line); }
        }
    }
    if outer.len > 0 {
        *ck.loop_stack.at(top) = LoopFrame { breaks: List.new(), conts: List.new() };
        let mut nm = copy_moved(&m0);
        for i in 0..outer.len { set_moved(&nm, outer.at(i).local, outer.at(i).line); }
        ck.moved = nm;
        loop_body(ck, s, mode, vt);
        carry = List.new();
        if !terminates(ck, body) { carry.push(copy_moved(&ck.moved)); }
        for i in 0..ck.loop_stack.at(top).conts.len { carry.push(copy_moved(ck.loop_stack.at(top).conts.at(i))); }
    }
    ck.fn_loops -= 1;
    let frame = ck.loop_stack.pop() catch { panic("loop stack underflow"); };
    let mut exits: List<List<MovedEnt>> = List.new();
    for i in 0..frame.breaks.len { exits.push(copy_moved(frame.breaks.at(i))); }
    if is_while { exits.push(carry.len > 0 ? merge_moved(&m0, &carry) : copy_moved(&m0)); }
    let merged = exits.len > 0 ? merge_moved(&m0, &exits) : copy_moved(&m0);
    let mut keep: List<MovedEnt> = List.new();
    for i in 0..merged.len { if merged.at(i).local < start_id { keep.push(MovedEnt { local: merged.at(i).local, line: merged.at(i).line }); } }
    ck.moved = keep;
}

// how `for x in e` iterates a value of type `ot`: 1 = `next` (it is an iterator), 2 = it has `iter()`, 0 = neither
pub fn iter_protocol(ck: *Checker, ot: i64) -> i64 {
    if ot == types.POISON || tk(ck, ot) != types.K_STRUCT { return 0; }
    let key = type_key(ck, ot);
    let nx = meth_find(ck, key, "next");
    if nx >= 0 && ck.syms.at(nx).has_self { return 1; }
    let it = meth_find(ck, key, "iter");
    if it >= 0 && ck.syms.at(it).has_self { return 2; }
    return 0;
}

pub fn mk_ident(sp: ast.Span, name: str) -> ast.Node {
    let mut n = ast.new_node("Ident", sp);
    n.set("name", ast.v_str(name));
    return n;
}

pub fn mk_mcall(sp: ast.Span, obj: ast.Node, name: str) -> ast.Node {
    let mut f = ast.new_node("Field", sp);
    f.set("obj", ast.v_node(obj));
    f.set("name", ast.v_str(name));
    f.set("name_span", ast.v_span(sp));
    let mut c = new_call_node(sp, f);
    c.set("targs", ast.v_none());
    return c;
}

pub fn mk_let(sp: ast.Span, name: str, is_mut: bool, init: ast.Node, nsp: ast.Span) -> ast.Node {
    let mut n = ast.new_node("Let", sp);
    n.set("name", ast.v_str(name));
    n.set("mut", ast.v_bool(is_mut));
    n.set("tyn", ast.v_none());
    n.set("init", ast.v_node(init));
    n.set("name_span", ast.v_span(nsp));
    return n;
}

pub fn mk_block(sp: ast.Span, stmts: List<ast.Node>) -> ast.Node {
    let mut b = ast.new_node("Block", sp);
    b.set("stmts", ast.v_list(ast.vals_of(stmts)));
    b.set("end_span", ast.v_span(sp));
    return b;
}

pub fn desugar_for(ck: *Checker, s: *ast.Node, proto: i64) {
    let sp = s.span;
    let it = ast.clone_node(s.node_of("iter"));
    let src = proto == 1 ? it : mk_mcall(sp, it, "iter");
    let mut var = String.from(s.str_of("var"));
    if var == "_" { var = String.from("cb_x"); }
    let mut brk: List<ast.Node> = List.new();
    brk.push(ast.new_node("Break", sp));
    let mut iff = ast.new_node("If", sp);
    iff.set("cond", ast.v_node(mk_mcall(sp, mk_ident(sp, "cb_o"), "is_none")));
    iff.set("then", ast.v_node(mk_block(sp, brk)));
    iff.set("els", ast.v_none());
    let mut bs: List<ast.Node> = List.new();
    bs.push(mk_let(sp, "cb_o", false, mk_mcall(sp, mk_ident(sp, "cb_it"), "next"), sp));
    bs.push(iff);
    bs.push(mk_let(sp, var, false, mk_mcall(sp, mk_ident(sp, "cb_o"), "unwrap"), s.get("var_span").span));
    bs.push(ast.clone_node(s.node_of("body")));
    let body = mk_block(sp, bs);
    let mut lp = ast.new_node("Loop", sp);
    lp.set("body", ast.v_node(body));
    let mut os: List<ast.Node> = List.new();
    os.push(mk_let(sp, "cb_it", true, src, sp));
    os.push(lp);
    let mut outer = mk_block(sp, os);
    check_block(ck, &outer, true);
    // the user's body is shared between the loop and the desugared form
    let checked = ast.clone_node(outer.get("stmts").items.at(1).node.at(0).node_of("body").get("stmts").items.at(3).node.at(0));
    s.set("body", ast.v_node(checked));
    let init0 = outer.get("stmts").items.at(0).node.at(0).node_of("init");
    if proto == 1 { s.set("iter", ast.v_node(ast.clone_node(init0))); }
    else { s.set("iter", ast.v_node(ast.clone_node(init0.node_of("callee").node_of("obj")))); }
    s.set("desugared", ast.v_node(outer));
}

pub fn st_for(ck: *Checker, s: *ast.Node) {
    let it = s.node_of("iter");
    let mut vt = types.POISON;
    if it.kind == "Range" {
        let lo = it.node_of("lo");
        let hi = it.node_of("hi");
        let mut lt = types.POISON;
        let mut ht = types.POISON;
        if untyped(ck, lo) && !untyped(ck, hi) {
            ht = check(ck, hi, -1, false);
            lt = check(ck, lo, ht, false);
        } else {
            lt = check(ck, lo, -1, false);
            ht = check(ck, hi, lt, false);
        }
        if lt != types.POISON && ht != types.POISON {
            if !types.is_int(lt) {
                here(ck, lo.span, format("range bounds must be integers, found `{ty_str(ck, lt)}`"), "", "");
                lt = types.POISON;
            } else if lt != ht {
                set_nil(lo, "conv");
                set_nil(hi, "conv");
                if types.is_int(ht) {
                    let ct = common_type(lt, ht);
                    if ct < 0 || !(apply_conv(ck, lo, lt, ct) && apply_conv(ck, hi, ht, ct)) {
                        if ct < 0 {
                            here(ck, it.span, format("cannot mix `{ty_str(ck, lt)}` and `{ty_str(ck, ht)}` as range bounds"), "", "cast one bound explicitly");
                        }
                        lt = types.POISON;
                    } else { lt = ct; }
                } else {
                    mismatch(ck, hi, lt, ht, "range bounds must have the same type");
                }
            }
        }
        vt = lt;
        s.set("range_ty", ast.v_tag(10, lt));
        s.set("mode", ast.v_str("range"));
    } else {
        let ot = check(ck, it, -1, false);
        let proto = iter_protocol(ck, ot);
        if proto != 0 { desugar_for(ck, s, proto); return; }
        if ot == types.POISON { vt = types.POISON; }
        else if tk(ck, ot) == types.K_ARR || tk(ck, ot) == types.K_SLICE {
            vt = ck.types.tys.at(ot).inner;
            if has_glue(ck, vt) {
                here(ck, it.span, format("cannot iterate over `{ty_str(ck, ot)}` by value: `{ty_str(ck, vt)}` has a destructor"), "",
                     "iterate over indices (`for i in 0..xs.len`) and borrow with `&xs[i]`");
                vt = types.POISON;
            }
        } else if ot == types.STR || ot == types.STRING { vt = types.U8; }
        else {
            here(ck, it.span, format("cannot iterate over a value of type `{ty_str(ck, ot)}`"), "",
                 "iterate over arrays, slices, strings or a range like `0..n`");
            vt = types.POISON;
        }
        s.set("mode", ast.v_str("seq"));
    }
    in_loop_m(ck, s, 2, true, vt);
}

// ---- error handling, optionals, match ----------------------------------------------------------------------------------------

// inside `try { }` a failing call needs no `try`: its error goes to the block's handler
pub fn auto_try(ck: *Checker, e: *ast.Node, t: i64) -> i64 {
    set_flag(e, "auto_try", true);
    set_tyn(e, "eu_ty", t);
    let top = ck.try_stack.len - 1;
    ck.try_stack.at(top).push(copy_moved(&ck.moved));
    let inner = ck.types.tys.at(t).inner;
    set_ty(e, inner);
    return inner;
}

pub fn fn_ret_str(ck: *Checker) -> String { return ty_str(ck, ck.fn_ret); }

pub fn ex_try(ck: *Checker, e: *ast.Node) -> i64 {
    let t = check(ck, e.node_of("expr"), -1, true);
    if t == types.POISON { return types.POISON; }
    if tk(ck, t) != types.K_EU {
        let ts = ty_str(ck, t);
        here(ck, e.span, format("`try` needs an expression that can fail, found `{ts}`"), "this cannot produce an error",
             "`try` applies to calls to functions returning `T!`");
        return t;
    }
    if ck.try_stack.len > 0 {
        let top = ck.try_stack.len - 1;
        ck.try_stack.at(top).push(copy_moved(&ck.moved));
    } else if tk(ck, ck.fn_ret) != types.K_EU {
        let rs = fn_ret_str(ck);
        here(ck, e.span, "`try` can only be used in a function that returns an error union", format("enclosing function returns `{rs}`"),
             format("change the return type to `{rs}!`, or handle the error with `catch`"));
    }
    return ck.types.tys.at(t).inner;
}

pub fn bind_err(ck: *Checker, e: *ast.Node) {
    if !e.is_none("binder") {
        let loc = declare_local(ck, e.str_of("binder"), types.ERR, false, e.get("binder_span").span, false);
        ck.locals.at(loc).used = true;
        e.set("binder_local", ast.v_tag(12, loc));
    } else { set_nil(e, "binder_local"); }
}

pub fn check_handler_loosely(ck: *Checker, e: *ast.Node) {
    let h = e.node_of("handler");
    if h.kind == "Block" {
        push_scope(ck);
        bind_err(ck, e);
        check_block(ck, h, true);
        pop_scope(ck);
    } else { check(ck, h, -1, false); }
}

pub fn ex_catch(ck: *Checker, e: *ast.Node) -> i64 {
    let t = check(ck, e.node_of("expr"), -1, true);
    let h = e.node_of("handler");
    if t == types.POISON {
        check_handler_loosely(ck, e);
        return types.POISON;
    }
    if tk(ck, t) != types.K_EU {
        let ts = ty_str(ck, t);
        here(ck, e.span, format("`catch` needs an expression that can fail, found `{ts}`"), "this cannot produce an error", "");
        check_handler_loosely(ck, e);
        return t;
    }
    let tt = ck.types.tys.at(t).inner;
    if h.kind == "Block" {
        push_scope(ck);
        bind_err(ck, e);
        let saved = copy_moved(&ck.moved);
        check_block(ck, h, true);
        if terminates(ck, h) { ck.moved = saved; }
        pop_scope(ck);
        if tt != types.VOID && !terminates(ck, h) {
            let ts = ty_str(ck, tt);
            here(ck, h.span, format("`catch` block must not fall through: the call yields `{ts}`"), "block can complete normally",
                 "end the block with `return`, `throw`, `break`, `continue` or `panic(...)`, or use `catch <default value>`");
        }
    } else {
        set_nil(e, "binder_local");
        push_scope(ck);
        bind_err(ck, e);
        if tt == types.VOID {
            here(ck, h.span, "a default value makes no sense here: the call yields no value", "",
                 "use `catch { ... }` or `catch |e| { ... }`");
            check(ck, h, -1, false);
        } else { expect(ck, h, tt, false); }
        pop_scope(ck);
    }
    return tt;
}

pub fn st_throw(ck: *Checker, s: *ast.Node) {
    if ck.try_stack.len > 0 {
        let top = ck.try_stack.len - 1;
        ck.try_stack.at(top).push(copy_moved(&ck.moved));
    } else if tk(ck, ck.fn_ret) != types.K_EU && ck.fn_ret != types.POISON {
        let rs = fn_ret_str(ck);
        here(ck, s.span, "`throw` can only be used in a function that returns an error union", format("enclosing function returns `{rs}`"),
             format("change the return type to `{rs}!`"));
    }
    let ex = s.node_of("expr");
    let t = check(ck, ex, types.ERR, false);
    if !types.same(&ck.types, t, types.ERR) {
        let ts = ty_str(ck, t);
        here(ck, ex.span, format("`throw` needs an error value, found `{ts}`"), "", "declare errors with `error Name;` and throw them by name");
    }
}

pub fn st_tryblock(ck: *Checker, s: *ast.Node) {
    let fr0: List<List<MovedEnt>> = List.new();
    ck.try_stack.push(fr0);
    let mut m0 = copy_moved(&ck.moved);
    check_block(ck, s.node_of("body"), true);
    let mut frame = ck.try_stack.pop() catch { panic("try stack underflow"); };
    let body_term = terminates(ck, s.node_of("body"));
    let m_body = copy_moved(&ck.moved);
    if frame.len == 0 {
        warn_here(ck, s.span, "this `try` block contains nothing that can fail", "",
                  "calls to functions returning `T!` and `throw` send control to the `catch` handler");
    }
    ck.moved = frame.len > 0 ? merge_moved(&m0, &frame) : copy_moved(&m0);
    push_scope(ck);
    bind_err(ck, s);
    check_block(ck, s.node_of("handler"), true);
    pop_scope(ck);
    let h_term = terminates(ck, s.node_of("handler"));
    let m_handler = copy_moved(&ck.moved);
    let mut states: List<List<MovedEnt>> = List.new();
    if !body_term { states.push(m_body); }
    if !h_term { states.push(m_handler); }
    ck.moved = merge_moved(&m0, &states);
}

pub fn ex_coalesce(ck: *Checker, e: *ast.Node, exp: i64) -> i64 {
    let l = e.node_of("l");
    let r = e.node_of("r");
    let lt = check(ck, l, -1, false);
    if lt == types.POISON {
        check(ck, r, -1, false);
        return types.POISON;
    }
    let mut tt = types.POISON;
    if tk(ck, lt) == types.K_OPT { tt = ck.types.tys.at(lt).inner; e.set("cmode", ast.v_str("opt")); }
    else if tk(ck, lt) == types.K_PTR { tt = lt; e.set("cmode", ast.v_str("ptr")); }
    else {
        let ts = ty_str(ck, lt);
        here(ck, l.span, format("the left side of `??` must be optional or a pointer, found `{ts}`"), "this can never be empty",
             "declare it as `T?`, e.g. `let name: str? = null;`");
        check(ck, r, -1, false);
        return types.POISON;
    }
    set_nil(l, "conv");
    let rt = check(ck, r, tt, false);
    if e.str_of("cmode") == "opt" && tk(ck, rt) == types.K_OPT && types.same(&ck.types, ck.types.tys.at(rt).inner, tt) {
        set_nil(r, "conv");
        set_flag(e, "chain", true);
        return rt;
    }
    set_flag(e, "chain", false);
    if coerce(ck, r, rt, tt) == types.POISON { return types.POISON; }
    consume(ck, l);
    return tt;
}

pub fn ex_optchain(ck: *Checker, e: *ast.Node) -> i64 {
    let obj = e.node_of("obj");
    let ot = check(ck, obj, -1, false);
    let has_args = !e.is_none("args");
    if ot == types.POISON {
        if has_args { for i in 0..e.get("args").items.len { check(ck, e.get("args").items.at(i).node.at(0), -1, false); } }
        return types.POISON;
    }
    let mut pt = types.POISON;
    if tk(ck, ot) == types.K_OPT { pt = ck.types.tys.at(ot).inner; e.set("cmode", ast.v_str("opt")); }
    else if tk(ck, ot) == types.K_PTR && ck.types.tys.at(ot).inner != types.VOID { pt = ot; e.set("cmode", ast.v_str("ptr")); }
    else {
        let ts = ty_str(ck, ot);
        here(ck, obj.span, format("`?.` needs an optional value or a pointer, found `{ts}`"), "this is never empty", "use `.` for values that are always present");
        if has_args { for i in 0..e.get("args").items.len { check(ck, e.get("args").items.at(i).node.at(0), -1, false); } }
        return types.POISON;
    }
    push_scope(ck);
    let loc = declare_local(ck, "$opt", pt, true, e.span, false);
    ck.locals.at(loc).used = true;
    e.set("payload_local", ast.v_tag(12, loc));
    let base = mk_ident(e.span, "$opt");
    let mut node = ast.new_node("Field", e.span);
    node.set("obj", ast.v_node(base));
    node.set("name", ast.v_str(e.str_of("name")));
    node.set("name_span", ast.v_span(e.get("name_span").span));
    if has_args {
        let mut c = new_call_node(e.span, node);
        let mut al: List<ast.Val> = List.new();
        for i in 0..e.get("args").items.len { al.push(ast.clone_val(e.get("args").items.at(i))); }
        c.set("args", ast.v_list(al));
        c.set("targs", ast.v_none());
        node = c;
    }
    let it = check(ck, &node, -1, false);
    // the argument nodes are shared with the original: pull the checked ones back
    if has_args && e.get("args").items.len > 0 {
        let no = e.get("args").items.len;
        let nn = node.get("args").items.len;
        let mut al: List<ast.Val> = List.new();
        for i in 0..no { al.push(ast.clone_val(node.get("args").items.at(nn - no + i))); }
        e.set("args", ast.v_list(al));
    }
    e.set("inner", ast.v_node(node));
    pop_scope(ck);
    if it == types.POISON { return types.POISON; }
    if it == types.VOID {
        here(ck, e.span, "`?.` needs a result: this call returns nothing", "", "use `if x != null { x.f(); }` instead");
        return types.POISON;
    }
    let flat = tk(ck, it) == types.K_OPT;
    set_flag(e, "flat", flat);
    return flat ? it : types.opt(&ck.types, it);
}

pub fn has_i64(l: *List<i64>, k: i64) -> bool {
    for i in 0..l.len { if *l.at(i) == k { return true; } }
    return false;
}

pub fn st_match(ck: *Checker, s: *ast.Node) {
    let scrut = s.node_of("scrut");
    let mut st = check(ck, scrut, -1, false);
    let ok_t = st == types.POISON || types.is_int(st) || st == types.BOOL || tk(ck, st) == types.K_ENUM;
    if !ok_t {
        let ts = ty_str(ck, st);
        here(ck, scrut.span, format("cannot match on a value of type `{ts}`"), "", "match works on integers, `bool` and enums; use `if` otherwise");
        st = types.POISON;
    }
    let mut seen: List<i64> = List.new();
    let mut has_wild = false;
    let mut m0 = copy_moved(&ck.moved);
    let mut arm_states: List<List<MovedEnt>> = List.new();
    let mut any_arm = false;
    for ai in 0..s.get("arms").items.len {
        let arm = s.get("arms").items.at(ai).node.at(0);
        any_arm = true;
        ck.moved = copy_moved(&m0);
        if flag(arm, "wild") { has_wild = true; }
        for pi in 0..arm.get("pats").items.len {
            let p = arm.get("pats").items.at(pi).node.at(0);
            let pt = check(ck, p, st != types.POISON ? st : -1, false);
            if st == types.POISON || pt == types.POISON { continue; }
            if !types.same(&ck.types, pt, st) {
                mismatch(ck, p, st, pt, "pattern type does not match the matched value");
                continue;
            }
            let mut have_key = false;
            let mut key = 0 as i64;
            let mut is_bool = false;
            if p.kind == "Field" && p.has("mode") && p.get("mode").tag == 3 && p.str_of("mode") == "variant" {
                key = p.get("vidx").i;
                have_key = true;
            } else if p.kind == "Int" || p.kind == "Bool" || (p.kind == "Unary" && p.node_of("expr").kind == "Int") {
                let v = const_eval(ck, p, ck.cur_mod);
                if ck.nc { ck.nc = false; }
                else { key = v.i; have_key = true; is_bool = v.kind == 2; }
            } else if p.kind == "Ident" || p.kind == "Field" {
                let v = const_eval(ck, p, ck.cur_mod);
                if ck.nc {
                    ck.nc = false;
                    here(ck, p.span, "match patterns must be constants", "", "");
                    continue;
                }
                key = v.i; have_key = true; is_bool = v.kind == 2;
            } else {
                here(ck, p.span, "match patterns must be literals, constants or enum variants", "", "");
                continue;
            }
            if have_key { p.set("cval", is_bool ? ast.v_bool(key != 0) : ast.v_int(key)); } else { set_nil(p, "cval"); }
            if have_key {
                if has_i64(&seen, key) { warn_here(ck, p.span, "unreachable pattern: this value is already matched above", "", ""); }
                else { seen.push(key); }
            }
        }
        check_block(ck, arm.node_of("body"), true);
        if !terminates(ck, arm.node_of("body")) { arm_states.push(copy_moved(&ck.moved)); }
    }
    ck.moved = any_arm ? merge_moved(&m0, &arm_states) : copy_moved(&m0);
    let mut exhaustive = has_wild;
    if !has_wild && st != types.POISON {
        if tk(ck, st) == types.K_ENUM {
            let sy = ck.types.tys.at(st).sym;
            let mut missing = String.empty();
            let mut nm = 0;
            for i in 0..ck.syms.at(sy).variants.len {
                if !has_i64(&seen, i) {
                    if nm > 0 { missing.append(", "); }
                    missing.append(format("{ck.syms.at(sy).name}.{*ck.syms.at(sy).variants.at(i)}"));
                    nm += 1;
                }
            }
            if nm > 0 {
                here(ck, s.span, "non-exhaustive match", format("missing: {missing}"), "add the missing variants, or a catch-all arm `_ => { ... }`");
            } else { exhaustive = true; }
        } else if st == types.BOOL {
            if has_i64(&seen, 1) && has_i64(&seen, 0) { exhaustive = true; }
            else { here(ck, s.span, "non-exhaustive match", "`true` and `false` must both be covered", "add the missing case or a `_` arm"); }
        } else {
            here(ck, s.span, "non-exhaustive match on an integer", "not all values are covered", "add a catch-all arm `_ => { ... }`");
        }
    }
    set_flag(s, "exhaustive", exhaustive);
    set_tyn(s, "scrut_ty", st);
}

pub fn raw_val(s: str) -> ast.Val { let mut v = ast.v_tag(14, 0); v.s = String.from(s); return v; }

pub fn ex_closure(ck: *Checker, e: *ast.Node, exp: i64) -> i64 {
    if e.has("clo_type") && !e.is_none("clo_type") { return e.get("clo_type").i; }
    let np = e.get("params").items.len;
    let has_hint = exp >= 0 && tk(ck, exp) == types.K_CLO && ck.types.tys.at(exp).params.len == np;
    let ci = ck.clos.len;
    ck.clos.push(CloInfo { is_move: flag(e, "move"), span: e.span, outer: List.new(), proxy: List.new(), sym: -1, body: ast.new_node("Block", e.span) });
    let mut ptys: List<i64> = List.new();
    for i in 0..np {
        let p = e.get("params").items.at(i).node.at(0);
        let mut t = types.POISON;
        if !p.is_none("tyn") { t = resolve_type(ck, p.node_of("tyn"), ck.cur_mod, false); }
        else if has_hint && *ck.types.tys.at(exp).params.at(i) != types.POISON { t = *ck.types.tys.at(exp).params.at(i); }
        else {
            let pn = String.from(p.str_of("name"));
            here(ck, p.span, format("cannot infer the type of the closure parameter `{pn}`"), "type annotations needed", format("write `|{pn}: <type>|`"));
        }
        ptys.push(t);
    }
    let mut rt = -1 as i64;
    if !e.is_none("ret") { rt = resolve_type(ck, e.node_of("ret"), ck.cur_mod, true); }
    else if has_hint && ck.types.tys.at(exp).inner != types.POISON { rt = ck.types.tys.at(exp).inner; }
    ck.n_inst += 1;
    let mut sym = new_sym(ck, "fn", "closure", ck.cur_mod, -1, false);
    let cpre: str = ck.ld.mods.at(ck.cur_mod).cprefix;
    sym.cname = format("{cpre}__clo{ck.n_inst}");
    for i in 0..ptys.len { sym.params.push(*ptys.at(i)); }
    sym.clo = ci;
    let sid = ck.syms.len;
    ck.syms.push(sym);
    ck.clos.at(ci).sym = sid;
    // enter the closure: a fresh function state, the outer scopes stay visible through the closure scope
    let s_has_fn = ck.has_fn;
    let s_fn_sym = ck.fn_sym;
    let s_fn_ret = ck.fn_ret;
    let mut s_names: List<String> = List.new();
    while ck.fn_names.len > 0 { s_names.push(ck.fn_names.pop() catch { panic("unreachable"); }); }
    let s_loops = ck.fn_loops;
    let s_rdepth = ck.fn_rdepth;
    let mut s_lstack: List<LoopFrame> = List.new();
    while ck.loop_stack.len > 0 { s_lstack.push(ck.loop_stack.pop() catch { panic("unreachable"); }); }
    let mut s_tstack: List<List<List<MovedEnt>>> = List.new();
    while ck.try_stack.len > 0 { s_tstack.push(ck.try_stack.pop() catch { panic("unreachable"); }); }
    let s_moved = copy_moved(&ck.moved);
    let s_rl = ck.reinit_line;
    let s_rc = ck.reinit_col;
    ck.scopes.push(Scope { names: List.new(), ids: List.new(), clo: ci });
    ck.moved = List.new();
    ck.reinit_line = 0;
    ck.reinit_col = 0;
    ck.syms.at(sid).ret = rt >= 0 ? rt : types.VOID;
    ck.has_fn = true;
    ck.fn_sym = sid;
    ck.fn_ret = ck.syms.at(sid).ret;
    ck.fn_loops = 0;
    ck.fn_rdepth = 0;
    for i in 0..np {
        let p = e.get("params").items.at(i).node.at(0);
        let loc = declare_local(ck, p.str_of("name"), *ptys.at(i), false, p.get("name_span").span, true);
        ck.syms.at(sid).param_locals.push(loc);
    }
    let mut body: ast.Node = ast.new_node("Block", e.span);
    let expr_body = flag(e, "expr_body");
    if expr_body {
        let eb = e.node_of("body");
        if rt < 0 {
            let t = check(ck, eb, -1, false);
            rt = t == types.POISON ? types.POISON : t;
            ck.syms.at(sid).ret = rt;
            ck.fn_ret = rt;
        }
        let mut st = ast.new_node(rt == types.VOID ? "ExprStmt" : "Return", eb.span);
        st.set("expr", ast.v_node(ast.clone_node(eb)));
        let mut sl: List<ast.Node> = List.new();
        sl.push(st);
        body = mk_block(eb.span, sl);
        body.set("end_span", ast.v_span(eb.span));
    } else {
        body = ast.clone_node(e.node_of("body"));
    }
    let nnode = ck.nodes.len;
    let mut fnn = ast.new_node("Fn", e.span);
    fnn.set("name", ast.v_str("closure"));
    fnn.set("params", ast.clone_val(e.get("params")));
    fnn.set("ret", ast.clone_val(e.get("ret")));
    fnn.set("body", ast.v_node(ast.clone_node(&body)));
    fnn.set("pub", ast.v_bool(false));
    ck.nodes.push(fnn);
    ck.syms.at(sid).node = nnode;
    let n_err = ck.d.error_count();
    check_block(ck, &body, true);
    pop_scope(ck);
    if ck.d.error_count() == n_err {
        let mut ps: List<i64> = List.new();
        for i in 0..ck.syms.at(sid).param_locals.len { ps.push(*ck.syms.at(sid).param_locals.at(i)); }
        ck.bck.push(BckEnt { sym: sid, body: ast.clone_node(&body), params: ps, context: String.from(ck.d.context) });
    }
    let rts = ck.syms.at(sid).ret;
    if tk(ck, rts) != types.K_EU && rts != types.VOID && rts != types.POISON && !terminates(ck, &body) {
        let rs = ty_str(ck, rts);
        here(ck, e.span, "this closure does not return a value on every path", format("expected `{rs}` to be returned"),
             "add a `return` at the end, or make every branch return");
    }
    ck.has_fn = s_has_fn;
    ck.fn_sym = s_fn_sym;
    ck.fn_ret = s_fn_ret;
    while ck.fn_names.len > 0 { ck.fn_names.pop() catch { panic("unreachable"); }; }
    while s_names.len > 0 { ck.fn_names.push(s_names.pop() catch { panic("unreachable"); }); }
    ck.fn_loops = s_loops;
    ck.fn_rdepth = s_rdepth;
    while ck.loop_stack.len > 0 { ck.loop_stack.pop() catch { panic("unreachable"); }; }
    while s_lstack.len > 0 { ck.loop_stack.push(s_lstack.pop() catch { panic("unreachable"); }); }
    while ck.try_stack.len > 0 { ck.try_stack.pop() catch { panic("unreachable"); }; }
    while s_tstack.len > 0 { ck.try_stack.push(s_tstack.pop() catch { panic("unreachable"); }); }
    ck.moved = s_moved;
    ck.reinit_line = s_rl;
    ck.reinit_col = s_rc;
    // the captures, seen from the enclosing function
    let mut caps: List<ast.Val> = List.new();
    for k in 0..ck.clos.at(ci).outer.len {
        let outer = *ck.clos.at(ci).outer.at(k);
        let proxy = *ck.clos.at(ci).proxy.at(k);
        let on = String.from(ck.locals.at(outer).name);
        let mi = moved_at(&ck.moved, outer);
        if mi >= 0 {
            let ml = ck.moved.at(mi).line;
            here_n(ck, e.span, format("the closure uses `{on}`, which was moved earlier"), "value used after it was moved", "",
                   format("`{on}` was moved at line {ml}"));
        }
        if ck.clos.at(ci).is_move && ck.locals.at(outer).glue { set_moved(&ck.moved, outer, e.span.line); }
        let mut pr: List<ast.Val> = List.new();
        pr.push(ast.v_tag(12, outer));
        pr.push(ast.v_tag(12, proxy));
        caps.push(ast.v_list(pr));
    }
    ck.syms.at(sid).mod_idx = ck.cur_mod;
    ck.fns.push(sid);
    e.set("sym", ast.v_tag(11, sid));
    e.set("info", raw_val("?ClosureInfo"));
    e.set("captures", ast.v_list(caps));
    if expr_body { e.set("body", ast.v_node(ast.clone_node(body.get("stmts").items.at(0).node.at(0).node_of("expr")))); }
    else { e.set("body", ast.v_node(ast.clone_node(&body))); }
    ck.clos.at(ci).body = ast.clone_node(&body);
    e.set("local_body", ast.v_node(body));
    if ck.syms.at(sid).ret == types.POISON { return types.POISON; }
    for i in 0..ptys.len { if *ptys.at(i) == types.POISON { return types.POISON; } }
    let ct = types.clo(&ck.types, &ptys, ck.syms.at(sid).ret);
    e.set("clo_type", ast.v_tag(10, ct));
    return ct;
}

// ---- regions (lifetimes) -----------------------------------------------------------------------------------------------------

pub fn st_region(ck: *Checker, s: *ast.Node) {
    ck.fn_rdepth += 1;
    push_scope(ck);
    let loc = declare_local(ck, s.str_of("name"), types.REGION, false, s.get("name_span").span, false);
    ck.locals.at(loc).region_handle = true;
    ck.locals.at(loc).used = true;
    ck.locals.at(loc).glue = false;
    ck.locals.at(loc).rd = ck.fn_rdepth;
    s.set("local", ast.v_tag(12, loc));
    check_block(ck, s.node_of("body"), true);
    pop_scope(ck);
    ck.fn_rdepth -= 1;
}

// can a value of type `t` contain a pointer into region memory?
pub fn holds_ptr(ck: *Checker, t: i64) -> bool {
    let k = tk(ck, t);
    if k == types.K_PRIM { return false; }
    if k == types.K_ENUM || k == types.K_ERR || k == types.K_POISON { return false; }
    if k == types.K_ARR || k == types.K_OPT || k == types.K_EU { return holds_ptr(ck, ck.types.tys.at(t).inner); }
    if k == types.K_STRUCT {
        let sy = ck.types.tys.at(t).sym;
        for i in 0..ck.syms.at(sy).fields.len { if holds_ptr(ck, ck.syms.at(sy).fields.at(i).ty) { return true; } }
        return false;
    }
    return true;
}

pub fn ty_of(e: *ast.Node) -> i64 {
    if e.has("ty") && e.get("ty").tag == 10 { return e.get("ty").i; }
    return -1;
}

// the innermost region whose memory the value of `e` may refer to (a handle local), or -1
pub fn taint(ck: *Checker, e: *ast.Node) -> i64 {
    let t = ty_of(e);
    if t < 0 || t == types.POISON || !holds_ptr(ck, t) { return -1; }
    if e.kind == "Call" && e.has("builtin") && !e.is_none("builtin") && e.str_of("builtin") == "alloc_in" { return e.get("region_local").i; }
    if e.kind == "Ident" {
        if e.has("local") && e.get("local").tag == 12 { return ck.locals.at(e.get("local").i).taint; }
        return -1;
    }
    if e.kind == "Unary" && e.str_of("op") == "&" { return place_taint(ck, e.node_of("expr")); }
    let mut best = -1 as i64;
    for ai in 0..e.attrs.len {
        let an: str = e.attrs.at(ai).name;
        if an == "span" || an == "ty" || an == "local" || an == "sym" || an == "handler" { continue; }
        let v = &e.attrs.at(ai).v;
        if v.tag == 4 {
            let c = v.node.at(0);
            if c.kind != "Block" && c.has("ty") {
                let tc = taint(ck, c);
                if tc >= 0 && (best < 0 || ck.locals.at(tc).rd > ck.locals.at(best).rd) { best = tc; }
            }
        } else if v.tag == 5 {
            for q in 0..v.items.len {
                if v.items.at(q).tag != 4 { continue; }
                let c = v.items.at(q).node.at(0);
                if c.kind != "Block" && c.has("ty") {
                    let tc = taint(ck, c);
                    if tc >= 0 && (best < 0 || ck.locals.at(tc).rd > ck.locals.at(best).rd) { best = tc; }
                }
            }
        }
    }
    return best;
}

pub fn is_view(ck: *Checker, t: i64) -> bool {
    return tk(ck, t) == types.K_PTR || tk(ck, t) == types.K_SLICE || t == types.STR || t == types.STRING;
}

pub fn place_taint(ck: *Checker, t0: *ast.Node) -> i64 {
    let mut t = t0;
    while t.kind == "Field" || t.kind == "Index" {
        let bt = ty_of(t.node_of("obj"));
        if bt >= 0 && is_view(ck, bt) { return taint(ck, t.node_of("obj")); }
        t = t.node_of("obj");
    }
    if t.kind == "Unary" && t.str_of("op") == "*" { return taint(ck, t.node_of("expr")); }
    return -1;
}

// region nesting depth of the storage that assignment target `t0` lives in (0 = outside every region)
pub fn place_depth(ck: *Checker, t0: *ast.Node) -> i64 {
    let mut t = t0;
    while true {
        let k: str = t.kind;
        if k == "Ident" {
            if t.has("local") && t.get("local").tag == 12 { return ck.locals.at(t.get("local").i).rdepth; }
            return 0;
        }
        if k == "Field" || k == "Index" {
            let base = t.node_of("obj");
            let bt = ty_of(base);
            if bt >= 0 && is_view(ck, bt) {
                let tb = taint(ck, base);
                return tb >= 0 ? ck.locals.at(tb).rd : 0;
            }
            t = base;
            continue;
        }
        if k == "Unary" && t.str_of("op") == "*" {
            let tb = taint(ck, t.node_of("expr"));
            return tb >= 0 ? ck.locals.at(tb).rd : 0;
        }
        return 0;
    }
    return 0;
}

pub fn escape_error(ck: *Checker, sp: ast.Span, region: i64, what: str) {
    let rn = String.from(ck.locals.at(region).name);
    here(ck, sp, format("memory from region `{rn}` {what}"), format("allocated with `alloc_in(.., {rn})`, which is freed when the region ends"),
         "copy what you need out of the region before it ends, or allocate it outside with `alloc`");
}

pub fn check_escape_store(ck: *Checker, target: *ast.Node, value: *ast.Node) {
    let tv = taint(ck, value);
    if tv < 0 { return; }
    if ck.locals.at(tv).rd > place_depth(ck, target) { escape_error(ck, value.span, tv, "would outlive the region if stored here"); }
    let mut root = target;
    while root.kind == "Field" || root.kind == "Index" { root = root.node_of("obj"); }
    if root.kind == "Ident" && root.has("local") && root.get("local").tag == 12 {
        let rl = root.get("local").i;
        if holds_ptr(ck, ck.locals.at(rl).ty) {
            if ck.locals.at(rl).taint < 0 || ck.locals.at(tv).rd > ck.locals.at(ck.locals.at(rl).taint).rd { ck.locals.at(rl).taint = tv; }
        }
    }
}

pub fn st_break(ck: *Checker, s: *ast.Node, is_break: bool) {
    if ck.fn_loops == 0 {
        here(ck, s.span, is_break ? "`break` outside of a loop" : "`continue` outside of a loop", "", "");
    } else if ck.loop_stack.len > 0 {
        let top = ck.loop_stack.len - 1;
        if is_break { ck.loop_stack.at(top).breaks.push(copy_moved(&ck.moved)); }
        else { ck.loop_stack.at(top).conts.push(copy_moved(&ck.moved)); }
    }
}

pub fn st_return(ck: *Checker, s: *ast.Node) {
    let ret = ck.fn_ret;
    let tt = tk(ck, ret) == types.K_EU ? ck.types.tys.at(ret).inner : ret;
    if s.is_none("expr") {
        if tt != types.VOID && tt != types.POISON {
            let ts = ty_str(ck, tt);
            here(ck, s.span, format("`return` needs a value of type `{ts}`"), "", format("write `return <{ts} value>;`"));
        }
        return;
    }
    let x = s.node_of("expr");
    if tt == types.VOID {
        check(ck, x, -1, false);
        here(ck, x.span, "unexpected return value: the function returns nothing", "",
             "remove the value, or give the function a return type with `-> T`");
        return;
    }
    expect(ck, x, tt, false);
    let tx = taint(ck, x);
    if tx >= 0 { escape_error(ck, x.span, tx, "cannot be returned"); }
    if tt == types.STR && x.kind == "Ident" && flag(x, "coerce") && x.has("local") && x.get("local").tag == 12
        && ck.locals.at(x.get("local").i).glue {
        let nm = String.from(x.str_of("name"));
        here(ck, x.span, format("cannot return a view of the local `String` `{nm}`: it is destroyed when the function returns"),
             "this `str` would dangle", "return the `String` itself (change the return type to `String`)");
    }
}

pub fn st_exprstmt(ck: *Checker, s: *ast.Node) {
    let e = s.node_of("expr");
    let mut t = check(ck, e, -1, e.kind == "Call");
    if e.kind == "Call" && tk(ck, t) == types.K_EU && ck.try_stack.len > 0 { t = auto_try(ck, e, t); }
    if e.kind == "Call" && tk(ck, t) == types.K_EU {
        let ts = ty_str(ck, t);
        here(ck, e.span, format("unused error from call returning `{ts}`"), "this call can fail",
             "prefix with `try`, or handle it: `f() catch |e| { ... };`");
        return;
    }
    if e.kind != "Call" && e.kind != "Try" && e.kind != "Catch" && e.kind != "IncDec" {
        here(ck, e.span, "expression statement has no effect", "", "assign it to a variable or remove it");
    } else if t != types.POISON && t != types.VOID && has_glue(ck, t) {
        set_flag(s, "drop_temp", true);
        set_flag(e, "owned", true);
    }
}

pub fn st_assign(ck: *Checker, s: *ast.Node) {
    let t = s.node_of("target");
    let op = String.from(s.str_of("op"));
    let mut was_used = false;
    let mut have_used = false;
    if t.kind == "Ident" {
        let loc = lookup_local(ck, t.str_of("name"));
        if loc >= 0 { was_used = ck.locals.at(loc).used; have_used = true; }
        if op == "=" { ck.reinit_line = t.span.line; ck.reinit_col = t.span.col; }
    }
    let tt = check(ck, t, -1, false);
    ck.reinit_line = 0;
    ck.reinit_col = 0;
    if have_used && op == "=" && t.has("local") && t.get("local").tag == 12 { ck.locals.at(t.get("local").i).used = was_used; }
    set_tyn(s, "opty", tt);
    let v = s.node_of("value");
    if tt == types.POISON {
        check(ck, v, -1, false);
        return;
    }
    if !is_place(t) {
        here(ck, t.span, "invalid left-hand side of assignment", "cannot assign to this expression", "");
        check(ck, v, -1, false);
        return;
    }
    let mut label = String.empty();
    let mut help = String.empty();
    if place_mut(ck, t, &label, &help) { here(ck, t.span, "cannot assign to an immutable place", label, help); }
    if op == "=" {
        expect(ck, v, tt, false);
        check_escape_store(ck, t, v);
        if t.kind == "Ident" && t.has("local") && t.get("local").tag == 12 {
            let at = moved_at(&ck.moved, t.get("local").i);
            if at >= 0 {
                let mut keep: List<MovedEnt> = List.new();
                for i in 0..ck.moved.len { if i != at { keep.push(MovedEnt { local: ck.moved.at(i).local, line: ck.moved.at(i).line }); } }
                ck.moved = keep;
            }
        }
        return;
    }
    let bop = String.from(op[0..op.len - 1]);
    s.set("bop", ast.v_str(bop));
    let opsp = s.get("op_span").span;
    let mut vt = check(ck, v, is_shift(bop) ? -1 : tt, false);
    if vt == types.POISON { return; }
    let tts = ty_str(ck, tt);
    if is_shift(bop) {
        if !(types.is_int(tt) && types.is_int(vt)) {
            let vs = ty_str(ck, vt);
            here(ck, opsp, format("cannot apply `{op}` to `{tts}` and `{vs}`"), "", "");
        }
        return;
    }
    if bop == "+" && (tt == types.STR || tt == types.STRING) && (vt == types.STR || vt == types.STRING || (tt == types.STRING && vt == types.U8)) { return; }
    set_nil(v, "conv");
    if types.is_numeric(tt) && types.is_numeric(vt) && vt != tt {
        if !apply_conv(ck, v, vt, tt) { return; }
        vt = tt;
    }
    if !types.same(&ck.types, vt, tt) {
        mismatch(ck, v, tt, vt, "mismatched types");
        return;
    }
    let mut ok = types.is_int(tt);
    if is_arith(bop) { ok = (types.is_numeric(tt) && !(bop == "%" && types.is_float(tt))) || (bop == "+" && tt == types.STR); }
    if !ok { here(ck, opsp, format("cannot apply `{op}` to type `{tts}`"), "", ""); }
    if (bop == "/" || bop == "%") && types.is_int(tt) && int_is_zero(v) { here(ck, v.span, "division by zero", "", ""); }
}

// ---- function bodies and the driver ------------------------------------------------------------------------------------------

pub fn check_fn_body(ck: *Checker, sid: i64) {
    let nid = ck.syms.at(sid).node;
    if ck.nodes.at(nid).is_none("body") { return; }
    let mi = ck.syms.at(sid).mod_idx;
    let saved_mod = ck.cur_mod;
    let saved_ctx = String.from(ck.d.context);
    let saved_env = tenv_replace(ck, copy_tenv(&ck.syms.at(sid).tenv));
    ck.cur_mod = mi;
    let fname = String.from(ck.nodes.at(nid).str_of("name"));
    if ck.nodes.at(nid).has("default_of") && ck.nodes.at(nid).get("default_of").tag != 0 {
        let tr = String.from(ck.nodes.at(nid).str_of("default_of"));
        ck.d.context = format("while checking the default method `{fname}` of trait `{tr}` for this `impl`");
    }
    if ck.syms.at(sid).base >= 0 {
        let mut binds = String.empty();
        for i in 0..ck.syms.at(sid).tenv.len {
            if i > 0 { binds.append(", "); }
            let tn = String.from(ck.syms.at(sid).tenv.at(i).name);
            let ts = ty_str(ck, ck.syms.at(sid).tenv.at(i).ty);
            binds.append(format("{tn} = {ts}"));
        }
        let bn = String.from(ck.syms.at(ck.syms.at(sid).base).name);
        ck.d.context = format("while checking `{bn}` instantiated with {binds}");
    }
    let saved_fn = ck.has_fn;
    let saved_sym = ck.fn_sym;
    let saved_ret = ck.fn_ret;
    ck.has_fn = true;
    ck.fn_sym = sid;
    ck.fn_ret = ck.syms.at(sid).ret;
    ck.fn_names = List.new();
    ck.fn_loops = 0;
    ck.fn_rdepth = 0;
    ck.loop_stack = List.new();
    ck.try_stack = List.new();
    ck.scopes = List.new();
    push_scope(ck);
    ck.moved = List.new();
    ck.syms.at(sid).param_locals = List.new();
    let np = ck.nodes.at(nid).get("params").items.len;
    for i in 0..np {
        if i >= ck.syms.at(sid).params.len { break; }
        let p = ck.nodes.at(nid).get("params").items.at(i).node.at(0);
        let pl = declare_local(ck, p.str_of("name"), *ck.syms.at(sid).params.at(i), flag(p, "mut"), p.get("name_span").span, true);
        ck.syms.at(sid).param_locals.push(pl);
    }
    let body = ck.nodes.at(nid).node_of("body");
    let n_err = ck.d.error_count();
    check_block(ck, body, true);
    pop_scope(ck);
    if ck.d.error_count() == n_err {
        let mut ps: List<i64> = List.new();
        for i in 0..ck.syms.at(sid).param_locals.len { ps.push(*ck.syms.at(sid).param_locals.at(i)); }
        ck.bck.push(BckEnt { sym: sid, body: ast.clone_node(body), params: ps, context: String.from(ck.d.context) });
    }
    let rt = ck.syms.at(sid).ret;
    if tk(ck, rt) != types.K_EU && rt != types.VOID && rt != types.POISON && !terminates(ck, body) {
        let ts = ty_str(ck, rt);
        here(ck, ck.nodes.at(nid).span, format("function `{ck.syms.at(sid).name}` does not return a value on every path"),
             format("expected `{ts}` to be returned"), "add a `return` at the end, or make every branch return");
    }
    ck.cur_mod = saved_mod;
    tenv_replace(ck, saved_env);
    ck.d.context = saved_ctx;
    ck.has_fn = saved_fn;
    ck.fn_sym = saved_sym;
    ck.fn_ret = saved_ret;
}

pub fn copy_tenv(l: *List<NameTy>) -> List<NameTy> {
    let mut o: List<NameTy> = List.new();
    for i in 0..l.len { o.push(NameTy { name: String.from(l.at(i).name), ty: l.at(i).ty }); }
    return o;
}

pub fn check_bodies(ck: *Checker, mi: i64) {
    let mut todo: List<i64> = List.new();
    for q in 0..ck.fns.len {
        let sid = *ck.fns.at(q);
        if ck.syms.at(sid).mod_idx == mi && ck.syms.at(sid).base < 0 { todo.push(sid); }
    }
    for q in 0..todo.len { check_fn_body(ck, *todo.at(q)); }
}

pub fn check_consts(ck: *Checker, mi: i64) {
    ck.cur_mod = mi;
    let mut todo: List<i64> = List.new();
    for q in 0..ck.consts.len { if ck.syms.at(*ck.consts.at(q)).mod_idx == mi { todo.push(*ck.consts.at(q)); } }
    for q in 0..todo.len {
        let sid = *todo.at(q);
        let nid = ck.syms.at(sid).node;
        if ck.syms.at(sid).is_extern { continue; }
        ck.has_fn = true;
        ck.fn_sym = -1;
        ck.fn_ret = types.VOID;
        ck.fn_names = List.new();
        ck.fn_loops = 0;
        ck.fn_rdepth = 0;
        ck.loop_stack = List.new();
        ck.try_stack = List.new();
        ck.scopes = List.new();
        push_scope(ck);
        ck.moved = List.new();
        let n0 = ck.d.error_count();
        let cty = ck.syms.at(sid).ty;
        let init = ck.nodes.at(nid).node_of("init");
        let t = check(ck, init, cty != types.POISON ? cty : -1, false);
        if cty == types.POISON || ck.d.error_count() > n0 {
            ck.syms.at(sid).evaluated = true;
            ck.syms.at(sid).cv = cv_int(0);
            continue;
        }
        if !types.same(&ck.types, t, cty) {
            mismatch(ck, init, cty, t, "mismatched types");
            ck.syms.at(sid).evaluated = true;
            ck.syms.at(sid).cv = cv_int(0);
            continue;
        }
        let v = const_value(ck, sid);
        if ck.nc {
            ck.nc = false;
            here(ck, ck.nc_span, ck.nc_msg, "", "constants may only use literals, other constants and operators");
            ck.syms.at(sid).evaluated = true;
            ck.syms.at(sid).cv = cv_int(0);
            continue;
        }
        if types.is_int(cty) {
            let sn = String.from(ck.syms.at(sid).name);
            let ts = ty_str(ck, cty);
            if v.kind != 0 {
                here(ck, init.span, format("constant `{sn}` is out of range for `{ts}`"), format("evaluates to {v.i}"), "");
                ck.syms.at(sid).cv = cv_int(0);
            } else {
                let big = cty == types.U64 && v.i < 0;     // above i64::MAX: the bits are kept in an i64
                let neg = v.i < 0 && !big;
                let uv = v.i as u64;
                let mut mag = format("{v.i}");
                if big { mag = format("{uv}"); }
                else if neg && v.i == -9223372036854775807 - 1 { mag = String.from("9223372036854775808"); }
                else if neg { mag = format("{0 - v.i}"); }
                if !in_range(neg, mag, cty) {
                    here(ck, init.span, format("constant `{sn}` is out of range for `{ts}`"), format("evaluates to {v.i}"), "");
                    ck.syms.at(sid).cv = cv_int(0);
                }
            }
        }
    }
}

pub fn check_main(ck: *Checker) {
    let mi = ck.entry_mod;
    let nm = String.from(ck.entry_name);
    if ck.ld.order.len == 0 || nm.len == 0 { return; }
    let s = lookup_sym(ck, mi, nm);
    if s < 0 || ck.syms.at(s).kind != "fn" {
        err(ck, mi, ast.span(1, 1, 1), format("module `{ck.ld.mods.at(mi).name}` has no `{nm}` function"), "",
            format("add `fn {nm}() {{ ... }}`, choose another entry point with `--entry=NAME`, or use `--entry=` to build without one"), "");
        return;
    }
    ck.main_sym = s;
    let nsp = ck.nodes.at(ck.syms.at(s).node).span;
    if ck.syms.at(s).tparams.len > 0 { err(ck, mi, nsp, format("`{nm}` cannot be generic"), "", "", ""); }
    if ck.syms.at(s).params.len > 0 { err(ck, mi, nsp, format("`{nm}` cannot take parameters"), "", "", ""); }
    let rt = ck.syms.at(s).ret;
    let ri = tk(ck, rt) == types.K_EU ? ck.types.tys.at(rt).inner : -1;
    let ok = rt == types.POISON || rt == types.VOID || rt == types.I32 || (tk(ck, rt) == types.K_EU && (ri == types.VOID || ri == types.I32));
    if !ok {
        let ts = ty_str(ck, rt);
        err(ck, mi, nsp, format("`{nm}` must return `void`, `i32`, `void!` or `i32!`, not `{ts}`"), "", "", "");
    }
}

// the rest of `Checker._run`: constants, function bodies, instantiated bodies, cycles, unused imports, the entry point
pub fn run_bodies(ck: *Checker) {
    for oi in 0..ck.ld.order.len { check_consts(ck, *ck.ld.order.at(oi)); }
    for oi in 0..ck.ld.order.len { check_bodies(ck, *ck.ld.order.at(oi)); }
    while ck.pending.len > 0 {
        let sid = *ck.pending.at(0);
        let mut rest: List<i64> = List.new();
        for i in 1..ck.pending.len { rest.push(*ck.pending.at(i)); }
        ck.pending = rest;
        check_fn_body(ck, sid);
    }
    if ck.bck.len > 0 && ck.d.error_count() == 0 { run_borrowck(ck); }
    check_struct_cycles(ck);
    for oi in 0..ck.ld.order.len {
        let mi = *ck.ld.order.at(oi);
        for i in 0..ck.cmods.at(mi).imports.len {
            if !ck.cmods.at(mi).imports.at(i).used {
                let alias = String.from(ck.cmods.at(mi).imports.at(i).alias);
                let sp = ast.span(ck.cmods.at(mi).imports.at(i).node_line, ck.cmods.at(mi).imports.at(i).node_col, ck.cmods.at(mi).imports.at(i).node_len);
                warn(ck, mi, sp, format("unused import `{alias}`"), "", "remove it, or use `_`-free names from it", "");
            }
        }
    }
    check_main(ck);
}

// ---- indexing, aggregates, ternary ------------------------------------------------------------------------------------------

pub fn check_index_value(ck: *Checker, x: *ast.Node) -> i64 {
    let t = check(ck, x, -1, false);
    if t != types.POISON && !types.is_int(t) {
        let ts = ty_str(ck, t);
        here(ck, x.span, format("indices must be integers, found `{ts}`"), "", types.is_float(t) ? "convert with `as i64`" : "");
        return -1;
    }
    return t;
}

pub fn ex_index(ck: *Checker, e: *ast.Node) -> i64 {
    let ot = check(ck, e.node_of("obj"), -1, false);
    let idx = e.node_of("idx");
    check_index_value(ck, idx);
    if ot == types.POISON { return types.POISON; }
    let k = tk(ck, ot);
    if k == types.K_ARR {
        let n = ck.types.tys.at(ot).n;
        if idx.kind == "Int" && idx.get("value").s.len == 0 && idx.get("value").i >= n {
            here(ck, idx.span, "index out of bounds", format("the length is {n} but the index is {int_text(idx)}"), "");
        }
        return ck.types.tys.at(ot).inner;
    }
    if k == types.K_SLICE { return ck.types.tys.at(ot).inner; }
    if ot == types.STR || ot == types.STRING { return types.U8; }
    let ts = ty_str(ck, ot);
    here(ck, e.span, format("cannot index into a value of type `{ts}`"), "", "");
    return types.POISON;
}

pub fn ex_slice(ck: *Checker, e: *ast.Node) -> i64 {
    let obj = e.node_of("obj");
    let ot = check(ck, obj, -1, false);
    if !e.is_none("lo") { check_index_value(ck, e.node_of("lo")); }
    if !e.is_none("hi") { check_index_value(ck, e.node_of("hi")); }
    if ot == types.POISON { return types.POISON; }
    let k = tk(ck, ot);
    if k == types.K_ARR {
        if !is_place(obj) {
            here(ck, obj.span, "cannot slice a temporary array", "", "store it in a variable first");
            return types.POISON;
        }
        return types.slc(&ck.types, ck.types.tys.at(ot).inner);
    }
    if k == types.K_SLICE || ot == types.STR { return ot; }
    if ot == types.STRING { return types.STR; }
    let ts = ty_str(ck, ot);
    here(ck, e.span, format("cannot slice a value of type `{ts}`"), "", "");
    return types.POISON;
}

pub fn field_names_joined(ck: *Checker, sid: i64) -> String {
    let mut all = String.empty();
    for i in 0..ck.syms.at(sid).fields.len {
        if i > 0 { all.append(", "); }
        all.append(ck.syms.at(sid).fields.at(i).name);
    }
    return all;
}

pub fn field_names(ck: *Checker, sid: i64) -> List<String> {
    let mut o: List<String> = List.new();
    for i in 0..ck.syms.at(sid).fields.len { o.push(String.from(ck.syms.at(sid).fields.at(i).name)); }
    return o;
}

pub fn check_lit_fields(ck: *Checker, e: *ast.Node) {
    for i in 0..e.get("fields").items.len { check(ck, e.get("fields").items.at(i).items.at(2).node.at(0), -1, false); }
}

pub fn ex_structlit(ck: *Checker, e: *ast.Node, exp: i64) -> i64 {
    let path = e.node_of("path");
    let ent = entity(ck, path);
    if ent.kind != 2 || ck.syms.at(ent.idx).kind != "struct" {
        if ent.kind != 3 {
            let nm = String.from(path.str_of("name"));
            here(ck, path.span, format("`{nm}` is not a struct"), "", "struct literals look like `Name { field: value }`");
        }
        check_lit_fields(ck, e);
        return types.POISON;
    }
    let mut sid = ent.idx;
    let sn0 = String.from(ck.syms.at(sid).name);
    if ck.syms.at(sid).opaque {
        here(ck, e.span, format("`{sn0}` is an opaque C type and cannot be constructed"), "", format("obtain a `*{sn0}` from a C function"));
        check_lit_fields(ck, e);
        return types.POISON;
    }
    if ck.syms.at(sid).tparams.len > 0 {
        let nid = ck.syms.at(sid).node;
        let ntp = ck.syms.at(sid).tparams.len;
        let mut b: List<NameTy> = List.new();
        if exp >= 0 && tk(ck, exp) == types.K_STRUCT && ck.syms.at(ck.types.tys.at(exp).sym).base == sid {
            let es = ck.types.tys.at(exp).sym;
            for i in 0..ntp {
                if i < ck.syms.at(es).targs.len { b.push(NameTy { name: String.from(*ck.syms.at(sid).tparams.at(i)), ty: *ck.syms.at(es).targs.at(i) }); }
            }
        } else {
            let nfl = e.get("fields").items.len;
            for pass in 0..2 {
                for i in 0..nfl {
                    let fe = e.get("fields").items.at(i);
                    let v = fe.items.at(2).node.at(0);
                    let mut fnode = -1 as i64;
                    for q in 0..ck.nodes.at(nid).get("fields").items.len {
                        if ck.nodes.at(nid).get("fields").items.at(q).node.at(0).str_of("name") == fe.items.at(0).s { fnode = q; }
                    }
                    if fnode < 0 { continue; }
                    let ftn = ck.nodes.at(nid).get("fields").items.at(fnode).node.at(0).node_of("tyn");
                    if pass == 0 && !untyped(ck, v) { unify(ck, ftn, check(ck, v, -1, false), sid, &b); }
                    if pass == 1 && untyped(ck, v) && !is_bare_param(ck, ftn, sid, &b) { unify(ck, ftn, check(ck, v, -1, false), sid, &b); }
                }
            }
        }
        let mut missing = false;
        for i in 0..ntp { if !b_has(&b, *ck.syms.at(sid).tparams.at(i)) { missing = true; } }
        if missing {
            report_uninferred(ck, e.span, sid, &b, false);
            check_lit_fields(ck, e);
            return types.POISON;
        }
        let mut targs: List<i64> = List.new();
        for i in 0..ntp { targs.push(b_get(&b, *ck.syms.at(sid).tparams.at(i))); }
        let ty = inst_struct(ck, sid, &targs, ck.cur_mod, e.span, true);
        if ty == types.POISON { return types.POISON; }
        sid = ck.types.tys.at(ty).sym;
    }
    e.set("sym", ast.v_tag(11, sid));
    let sn = String.from(ck.syms.at(sid).name);
    let mut seen: List<String> = List.new();
    let nf = e.get("fields").items.len;
    for i in 0..nf {
        let f = e.get("fields").items.at(i);
        let nm = String.from(f.items.at(0).s);
        let nsp = f.items.at(1).span;
        let v = f.items.at(2).node.at(0);
        let fi = find_field(ck, sid, nm);
        if fi < 0 {
            let mut names = field_names(ck, sid);
            let sg = diag.suggest_list(nm, &names);
            here(ck, nsp, format("struct `{sn}` has no field `{nm}`"), "",
                 sg.len > 0 ? format("did you mean `{sg}`?") : format("fields: {field_names_joined(ck, sid)}"));
            check(ck, v, -1, false);
            continue;
        }
        if has_name(&seen, nm) { here(ck, nsp, format("field `{nm}` is specified more than once"), "", ""); }
        seen.push(String.from(nm));
        expect(ck, v, ck.syms.at(sid).fields.at(fi).ty, false);
    }
    let mut missing: List<String> = List.new();
    for i in 0..ck.syms.at(sid).fields.len {
        let fnm = String.from(ck.syms.at(sid).fields.at(i).name);
        if !has_name(&seen, fnm) { missing.push(fnm); }
    }
    if missing.len > 0 {
        let mut ms = String.empty();
        for i in 0..missing.len { if i > 0 { ms.append(", "); } ms.append(format("`{*missing.at(i)}`")); }
        let pl = missing.len > 1 ? "s" : "";
        here(ck, e.span, format("missing field{pl} in initializer of `{sn}`"), format("missing {ms}"), "");
    }
    return ck.syms.at(sid).ty;
}

pub fn ex_arraylit(ck: *Checker, e: *ast.Node, exp: i64) -> i64 {
    let elem_exp = (exp >= 0 && tk(ck, exp) == types.K_ARR) ? ck.types.tys.at(exp).inner : -1;
    let n = e.get("elems").items.len;
    if n == 0 {
        if exp >= 0 && exp == types.POISON { return types.POISON; }
        if elem_exp < 0 {
            here(ck, e.span, "cannot infer the type of an empty array", "", "annotate the variable, e.g. `let a: [3]i32 = ...`");
            return types.POISON;
        }
        return exp;
    }
    let first = check(ck, child(e.get("elems"), 0), elem_exp, false);
    for i in 1..n {
        let x = child(e.get("elems"), i);
        let t = check(ck, x, first != types.POISON ? first : elem_exp, false);
        if !types.same(&ck.types, t, first) { mismatch(ck, x, first, t, "array elements must all have the same type"); }
    }
    for i in 0..n { consume(ck, child(e.get("elems"), i)); }
    if first == types.POISON { return types.POISON; }
    return types.arr(&ck.types, first, n);
}

pub fn ex_arrayrepeat(ck: *Checker, e: *ast.Node, exp: i64) -> i64 {
    let elem_exp = (exp >= 0 && tk(ck, exp) == types.K_ARR) ? ck.types.tys.at(exp).inner : -1;
    let t = check(ck, e.node_of("elem"), elem_exp, false);
    let cnt = e.node_of("count");
    let v = const_eval(ck, cnt, ck.cur_mod);
    if ck.nc {
        ck.nc = false;
        here(ck, ck.nc_span, ck.nc_msg, "", "the repeat count must be a compile-time constant");
        return types.POISON;
    }
    if v.kind != 0 || v.i <= 0 {
        here(ck, cnt.span, "array length must be a positive integer constant", "", "");
        return types.POISON;
    }
    e.set("n", ast.v_int(v.i));
    if t != types.POISON && has_glue(ck, t) {
        let ts = ty_str(ck, t);
        here(ck, e.span, format("cannot repeat a value of type `{ts}`: it has a destructor and cannot be copied"), "",
             "write the elements out one by one, e.g. `[make(), make()]`");
        return types.POISON;
    }
    if t == types.POISON { return types.POISON; }
    return types.arr(&ck.types, t, v.i);
}

pub fn ternary_arms(ck: *Checker, e: *ast.Node, exp: i64) -> i64 {
    let a = e.node_of("a");
    let b = e.node_of("b");
    if exp >= 0 && tk(ck, exp) == types.K_OPT {
        expect(ck, a, exp, false);
        expect(ck, b, exp, false);
        return exp;
    }
    if untyped(ck, a) && !untyped(ck, b) {
        let tb = check(ck, b, exp, false);
        if tb == types.POISON {
            check(ck, a, -1, false);
            return types.POISON;
        }
        expect(ck, a, tb, false);
        set_nil(b, "conv");
        return tb;
    }
    let ta = check(ck, a, exp, false);
    if ta == types.POISON {
        check(ck, b, -1, false);
        return types.POISON;
    }
    set_nil(a, "conv");
    if expect(ck, b, ta, false) == types.POISON { return types.POISON; }
    return ta;
}

pub fn ex_ternary(ck: *Checker, e: *ast.Node, exp: i64) -> i64 {
    expect(ck, e.node_of("cond"), types.BOOL, false);
    let r = ternary_arms(ck, e, exp);
    if r != types.POISON {
        consume(ck, e.node_of("a"));
        consume(ck, e.node_of("b"));
    }
    return r;
}

// ---- methods ------------------------------------------------------------------------------------------------------------------

pub fn meth_find(ck: *Checker, key: str, name: str) -> i64 {
    for i in 0..ck.methods.len {
        if ck.methods.at(i).key == key {
            for q in 0..ck.methods.at(i).entries.len { if ck.methods.at(i).entries.at(q).name == name { return ck.methods.at(i).entries.at(q).sym; } }
        }
    }
    return -1;
}

pub fn meth_names(ck: *Checker, key: str, only_self: bool) -> List<String> {
    let mut o: List<String> = List.new();
    for i in 0..ck.methods.len {
        if ck.methods.at(i).key == key {
            for q in 0..ck.methods.at(i).entries.len {
                let s = ck.methods.at(i).entries.at(q).sym;
                if !only_self || ck.syms.at(s).has_self { o.push(String.from(ck.methods.at(i).entries.at(q).name)); }
            }
        }
    }
    return sorted_names(&o);
}

pub fn method_visible(ck: *Checker, meth: i64, c: *ast.Node) -> bool {
    if ck.syms.at(meth).is_pub || ck.syms.at(meth).mod_idx == ck.cur_mod { return true; }
    let mn = String.from(ck.syms.at(meth).method_name);
    let md = String.from(ck.ld.mods.at(ck.syms.at(meth).mod_idx).name);
    here(ck, c.get("name_span").span, format("method `{mn}` is private to module `{md}`"), "private item", "mark it `pub` in its `impl` block");
    return false;
}

pub fn is_opt_method(n: str) -> bool { return n == "is_some" || n == "is_none" || n == "unwrap" || n == "unwrap_or"; }

pub fn unary_node(sp: ast.Span, op: str, inner: *ast.Node) -> ast.Node {
    let mut n = ast.new_node("Unary", sp);
    n.set("op", ast.v_str(op));
    n.set("expr", ast.v_node(ast.clone_node(inner)));
    return n;
}

// adapts the receiver expression to the method's first parameter (auto-borrow / auto-deref); false after an error
pub fn receiver_arg(ck: *Checker, obj: *ast.Node, ot: i64, cand: i64, meth: i64, base: i64, out: *ast.Node) -> bool {
    let nid = ck.syms.at(meth).node;
    let p0 = ck.nodes.at(nid).get("params").items.at(0).node.at(0);
    let by_ptr = p0.node_of("tyn").kind == "TPtr";
    let mn = String.from(ck.syms.at(meth).method_name);
    let smut = ck.syms.at(meth).self_mut;
    ck.recv_wrap = false;
    if by_ptr {
        if tk(ck, ot) == types.K_PTR {
            set_flag(obj, "recv_ok", true);
            if smut && ck.types.tys.at(ot).ro {
                here(ck, obj.span, format("cannot call `{mn}`, which takes `mut self`, through a `*const` pointer"),
                     "this pointer is read-only", "take a `*T` (without `const`) instead");
            }
            if smut && readonly_self(ck, obj) {
                here(ck, obj.span, format("cannot call `{mn}`, which takes `mut self`, on the read-only `self`"),
                     "this method was declared with plain `self`", "declare the calling method with `mut self` too");
            }
            *out = ast.clone_node(obj);
            return true;
        }
        if cand != base {
            *out = ast.clone_node(obj);
            return true;
        }
        let mut node = unary_node(obj.span, "&", obj);
        set_flag(&node, "auto_ref", !smut);
        set_flag(&node, "recv_ok", !smut);
        ck.recv_wrap = true;
        *out = node;
        return true;
    }
    if tk(ck, ot) == types.K_PTR {
        ck.recv_wrap = true;
        *out = unary_node(obj.span, "*", obj);
        return true;
    }
    *out = ast.clone_node(obj);
    return true;
}

// `Type.f(args)` / `value.f(args)`: -1 not a method call, -2 error reported, -3 optional method, else the method symbol
pub fn find_method(ck: *Checker, e: *ast.Node) -> i64 {
    let c = e.node_of("callee");
    let mut obj = c.node_of("obj");
    let name = String.from(c.str_of("name"));
    let mut tent = Ent { kind: 0, idx: -1 };
    if obj.kind == "Ident" || obj.kind == "Field" { tent = entity(ck, obj); }
    if tent.kind == 3 { return -2; }
    let mut key = String.empty();
    let mut have_key = false;
    if tent.kind != 0 {
        if tent.kind == 2 && (ck.syms.at(tent.idx).kind == "struct" || ck.syms.at(tent.idx).kind == "enum") {
            key = String.from(ck.syms.at(tent.idx).full);
            have_key = true;
        } else { return -1; }
    } else if obj.kind == "Ident" && is_prim_name(obj.str_of("name")) && lookup_local(ck, obj.str_of("name")) < 0 && obj.str_of("name") != "void" {
        key = String.from(obj.str_of("name"));
        have_key = true;
    }
    if have_key {
        let meth = meth_find(ck, key, name);
        if meth < 0 {
            let tn = String.from(obj.str_of("name"));
            let mut avail = meth_names(ck, key, false);
            let sg = avail.len > 0 ? diag.suggest_list(name, &avail) : String.empty();
            here(ck, c.get("name_span").span, format("type `{tn}` has no function `{name}`"), "", sg.len > 0 ? format("did you mean `{sg}`?") : String.empty());
            check_all_args(ck, e);
            return -2;
        }
        if !method_visible(ck, meth, c) { return -2; }
        return meth;
    }
    if obj.kind == "Ident" && lookup_local(ck, obj.str_of("name")) < 0 { return -1; }
    let mut ot = check(ck, obj, -1, false);
    if ot == types.POISON {
        check_all_args(ck, e);
        return -2;
    }
    while tk(ck, ot) == types.K_PTR && tk(ck, ck.types.tys.at(ot).inner) == types.K_PTR {
        let w = unary_node(obj.span, "*", obj);
        c.set("obj", ast.v_node(w));
        obj = c.node_of("obj");
        ot = check(ck, obj, -1, false);
    }
    if tk(ck, ot) == types.K_OPT && is_opt_method(name) { return -3; }
    let base = (tk(ck, ot) == types.K_PTR && ck.types.tys.at(ot).inner != types.VOID) ? ck.types.tys.at(ot).inner : ot;
    if tk(ck, base) == types.K_STRUCT && find_field(ck, ck.types.tys.at(base).sym, name) >= 0 { return -1; }
    let mut chain: List<i64> = List.new();
    chain.push(base);
    if base == types.STRING { chain.push(types.STR); }
    for ci in 0..chain.len {
        let cand = *chain.at(ci);
        let k = type_key(ck, cand);
        let meth = k.len > 0 ? meth_find(ck, k, name) : -1;
        if meth < 0 || !ck.syms.at(meth).has_self { continue; }
        if !method_visible(ck, meth, c) { return -2; }
        let mut arg = ast.new_node("Unary", obj.span);
        if !receiver_arg(ck, obj, ot, cand, meth, base, &arg) {
            check_all_args(ck, e);
            return -2;
        }
        let mut items: List<ast.Val> = List.new();
        items.push(ast.v_node(arg));
        for i in 0..e.get("args").items.len { items.push(ast.clone_val(e.get("args").items.at(i))); }
        e.set("args", ast.v_list(items));
        set_flag(e, "method_recv", true);
        return meth;
    }
    let bk = type_key(ck, base);
    let mut avail: List<String> = List.new();
    if bk.len > 0 {
        for ci in 0..chain.len {
            let names = meth_names(ck, type_key(ck, *chain.at(ci)), true);
            for q in 0..names.len { if !has_name(&avail, *names.at(q)) { avail.push(String.from(*names.at(q))); } }
        }
        avail = sorted_names(&avail);
    }
    let sg = avail.len > 0 ? diag.suggest_list(name, &avail) : String.empty();
    let bkd = tk(ck, base);
    if bkd == types.K_STRUCT || bkd == types.K_ENUM || bkd == types.K_PRIM || tk(ck, ot) == types.K_PTR {
        let bs = ty_str(ck, base);
        here(ck, c.get("name_span").span, format("type `{bs}` has no method `{name}`"), "", sg.len > 0 ? format("did you mean `{sg}`?") : String.empty());
        check_all_args(ck, e);
        return -2;
    }
    return -1;
}

pub fn opt_method(ck: *Checker, e: *ast.Node) -> i64 {
    let c = e.node_of("callee");
    let t = ck.types.tys.at(ety(c.node_of("obj"))).inner;
    let n = String.from(c.str_of("name"));
    let want = n == "unwrap_or" ? 1 : 0;
    let got = e.get("args").items.len;
    if got != want {
        let pl = want != 1 ? "s" : "";
        here(ck, e.span, format("`{n}` takes {want} argument{pl} but {got} were supplied"), "", "");
        check_all_args(ck, e);
        return types.POISON;
    }
    e.set("opt_method", ast.v_str(n));
    if n == "is_some" || n == "is_none" { return types.BOOL; }
    if (n == "unwrap" || n == "unwrap_or") && has_glue(ck, t) {
        let ob = c.node_of("obj");
        consume(ck, ob);
        ck.opt_consumed.push(ob.span.line * 1048576 + ob.span.col);
    }
    if n == "unwrap_or" { expect(ck, child(e.get("args"), 0), t, false); }
    return t;
}

// the method bodies are shared between the `impl` item and the method nodes in the Python tree: copy the checked bodies back
pub fn finalize_impls(ck: *Checker) {
    for r in 0..ck.impl_recs.len {
        let item = ck.impl_recs.at(r).item;
        let nf = ck.nodes.at(item).get("fns").items.len;
        for q in 0..ck.impl_recs.at(r).fn_nodes.len {
            let k = *ck.impl_recs.at(r).fn_idx.at(q);
            if k >= nf { continue; }
            let body = ast.clone_node(ck.nodes.at(*ck.impl_recs.at(r).fn_nodes.at(q)).node_of("body"));
            let orig = ck.nodes.at(item).get("fns").items.at(k).node.at(0);
            orig.set("body", ast.v_node(body));
        }
    }
}

// ---- builtins and format strings --------------------------------------------------------------------------------------------------

pub fn display_help(ck: *Checker, t: i64) -> String {
    let k = tk(ck, t);
    if k == types.K_OPT { return String.from("unwrap it first (`x ?? default`, `x.unwrap()`), or show it with `{x:?}`"); }
    if k == types.K_STRUCT || k == types.K_ENUM || k == types.K_ARR || k == types.K_SLICE {
        return String.from("implement `Display` for it (`impl Display for T { fn to_string(self) -> String { .. } }`), or use `{x:?}` for the automatic representation");
    }
    return String.empty();
}

// can the automatic `{:?}` representation show a value of type `t`? Returns the offending type (-1 for none)
pub fn debuggable(ck: *Checker, t: i64, seen: *List<String>) -> i64 {
    let k = tk(ck, t);
    if t == types.POISON || types.is_numeric(t) || t == types.BOOL || t == types.STR || t == types.STRING || t == types.ERR
        || k == types.K_ENUM || k == types.K_PTR || k == types.K_FN { return -1; }
    if k == types.K_ARR || k == types.K_SLICE || k == types.K_OPT { return debuggable(ck, ck.types.tys.at(t).inner, seen); }
    if k == types.K_STRUCT {
        let sid = ck.types.tys.at(t).sym;
        let full = String.from(ck.syms.at(sid).full);
        if has_name(seen, full) { return -1; }
        seen.push(full);
        for i in 0..ck.syms.at(sid).fields.len {
            let bad = debuggable(ck, ck.syms.at(sid).fields.at(i).ty, seen);
            if bad >= 0 { return bad; }
        }
        return -1;
    }
    return t;
}

// the `to_string` method of `impl Display for T` (-1 if none)
pub fn display_impl(ck: *Checker, t: i64) -> i64 {
    let tr = lookup_named(&ck.prelude_traits, "Display");
    let k = tk(ck, t);
    if tr < 0 || (k != types.K_STRUCT && k != types.K_ENUM) { return -1; }
    let key = type_key(ck, t);
    if find_timpl(ck, ck.syms.at(tr).full, key) < 0 { return -1; }
    return meth_find(ck, key, "to_string");
}

pub fn new_call_node(sp: ast.Span, callee: ast.Node) -> ast.Node {
    let mut c = ast.new_node("Call", sp);
    c.set("callee", ast.v_node(callee));
    c.set("args", ast.v_list(List.new()));
    c.set("targ", ast.v_none());
    c.set("targs", ast.v_list(List.new()));
    return c;
}

// `e.to_string()` as a checked call node when the type of `e` implements Display
pub fn display_call(ck: *Checker, e: *ast.Node, t: i64, out: *ast.Node) -> bool {
    if display_impl(ck, t) < 0 { return false; }
    let mut f = ast.new_node("Field", e.span);
    f.set("obj", ast.v_node(ast.clone_node(e)));
    f.set("name", ast.v_str("to_string"));
    f.set("name_span", ast.v_span(e.span));
    let mut call = new_call_node(e.span, f);
    call.set("disp_src", ast.v_node(ast.clone_node(e)));
    let ty = check(ck, &call, -1, false);
    if ty == types.POISON { return false; }
    *out = call;
    return true;
}

pub fn is_simple_arg(k: str) -> bool { return k == "Ident" || k == "Int" || k == "Float" || k == "Str" || k == "Bool" || k == "Field"; }

pub fn fix_spans_val(v: *ast.Val, sp: ast.Span) {
    if v.tag == 4 { fix_spans(v.node.at(0), sp); }
    else if v.tag == 5 || v.tag == 9 { for i in 0..v.items.len { fix_spans_val(v.items.at(i), sp); } }
}

pub fn fix_spans(n: *ast.Node, sp: ast.Span) {
    n.span = sp;
    for i in 0..n.attrs.len {
        let nm: str = n.attrs.at(i).name;
        if nm.ends_with("span") { n.attrs.at(i).v = ast.v_span(sp); }
        else { fix_spans_val(&n.attrs.at(i).v, sp); }
    }
}

// parses the expression written inside `{...}`; false after an error
pub fn parse_fmt_expr(ck: *Checker, text: str, at: *ast.Node, out: *ast.Node) -> bool {
    let mut ex = ast.new_node("tmp", at.span);
    let mut msg = String.empty();
    if !parser.parse_expr_text(text, &ex, &msg) {
        here(ck, at.span, format("`{{{text}}}` is not a valid placeholder"), "in this format string",
             format("the expression did not parse ({msg}); placeholders hold nothing, a number, or an expression: `{{}}`, `{{0}}`, `{{a + b}}`"));
        return false;
    }
    fix_spans(&ex, at.span);
    *out = ex;
    return true;
}

pub fn arg_expr(a: *ast.Node) -> *ast.Node { return a.kind == "NamedArg" ? a.node_of("expr") : a; }

// the template literal becomes an FStr node; false after an error
pub fn fmt_args(ck: *Checker, e: *ast.Node, name: str) -> bool {
    let tidx = name == "assert" ? 1 : 0;
    let nargs = e.get("args").items.len;
    if nargs <= tidx { return true; }
    let t = child(e.get("args"), tidx);
    if t.kind == "FStr" { return true; }
    if t.kind != "Str" {
        if name == "format" {
            here(ck, t.span, "the first argument of `format` must be a string literal", "expected a literal",
                 "the literal is the template: `format(\"{} of {}\", a, b)`");
            return false;
        }
        return true;
    }
    let tv: str = t.get("value").s;
    if name != "format" && !tv.contains("{") && !tv.contains("}") { return true; }
    let mut items: List<fmtspec.Piece> = List.new();
    let mut se = fmtspec.SpecError { msg: String.empty(), help: String.empty(), has_help: false };
    let mut bad = false;
    try {
        try fmtspec.parse_template(tv, &items, &se);
    } catch {
        bad = true;
    }
    if bad {
        here(ck, t.span, se.msg, "in this format string", se_help(&se));
        return false;
    }
    let mut pos: List<i64> = List.new();          // indices into e.args
    let mut named_names: List<String> = List.new();
    let mut named_idx: List<i64> = List.new();
    let mut ok = true;
    let mut seen_named = false;
    for ai in tidx + 1..nargs {
        let a = child(e.get("args"), ai);
        if a.kind == "NamedArg" {
            seen_named = true;
            let an = String.from(a.str_of("name"));
            let mut at = -1 as i64;
            for q in 0..named_names.len { if *named_names.at(q) == an { at = q; } }
            if at >= 0 {
                here(ck, a.get("name_span").span, format("the argument `{an}` is given twice"), "", "");
                ok = false;
                *named_idx.at(at) = ai;
            } else {
                named_names.push(an);
                named_idx.push(ai);
            }
        } else if seen_named {
            here(ck, a.span, "a positional argument cannot follow a named argument", "", "put the `name = value` arguments last");
            ok = false;
        } else {
            pos.push(ai);
        }
    }
    if !ok { return false; }
    let mut pos_uses: List<i64> = List.new();
    for i in 0..pos.len { pos_uses.push(0); }
    let mut named_uses: List<i64> = List.new();
    for i in 0..named_names.len { named_uses.push(0); }
    let mut parts: List<ast.Val> = List.new();
    let mut nxt = 0 as i64;
    for q in 0..items.len {
        let it = items.at(q);
        if !it.is_arg {
            let mut p = ast.new_node("FPart", t.span);
            p.set("lit", ast.v_bytes(it.lit));
            p.set("expr", ast.v_none());
            p.set("spec", ast.v_str(""));
            p.set("spec_span", ast.v_none());
            parts.push(ast.v_node(p));
            continue;
        }
        let mut ex = ast.new_node("tmp", t.span);
        let mut rk = it.ref_kind;
        let mut ri = it.ref_int;
        if rk == 0 { rk = 1; ri = nxt; nxt += 1; }
        if rk == 1 {
            if ri >= pos.len {
                let np = pos.len;
                let was = np == 1 ? "was" : "were";
                here(ck, t.span, format("the format string uses argument {ri} but only {np} {was} given"), "in this format string",
                     np == 0 ? "add the value after the string, or name it: `{total}` with `total = ...`" : "");
                return false;
            }
            ex = ast.clone_node(child(e.get("args"), *pos.at(ri)));
            *pos_uses.at(ri) = *pos_uses.at(ri) + 1;
        } else if rk == 3 {
            if !parse_fmt_expr(ck, it.ref_text, t, &ex) { return false; }
        } else {
            let mut ni = -1 as i64;
            for z in 0..named_names.len { if *named_names.at(z) == it.ref_text { ni = z; } }
            if ni >= 0 {
                ex = ast.clone_node(child(e.get("args"), *named_idx.at(ni)).node_of("expr"));
                *named_uses.at(ni) = *named_uses.at(ni) + 1;
            } else {
                let segs = split_dots(it.ref_text);
                let mut cur = ast.new_node("Ident", t.span);
                cur.set("name", ast.v_str(*segs.at(0)));
                for z in 1..segs.len {
                    let mut f = ast.new_node("Field", t.span);
                    f.set("obj", ast.v_node(cur));
                    f.set("name", ast.v_str(*segs.at(z)));
                    f.set("name_span", ast.v_span(t.span));
                    cur = f;
                }
                ex = cur;
            }
        }
        let mut part = ast.new_node("FPart", t.span);
        part.set("lit", ast.v_none());
        part.set("expr", ast.v_node(ex));
        part.set("spec", ast.v_str(it.spec));
        part.set("spec_span", ast.v_span(t.span));
        parts.push(ast.v_node(part));
    }
    for i in 0..pos.len {
        let a = child(e.get("args"), *pos.at(i));
        if *pos_uses.at(i) == 0 {
            here(ck, a.span, "this argument is never used by the format string", "unused argument", "add a `{}` for it");
            ok = false;
        } else if *pos_uses.at(i) > 1 && !is_simple_arg(a.kind) {
            here(ck, a.span, "an argument used more than once must be a simple value", "", "bind it to a variable first, then use `{name}`");
            ok = false;
        }
    }
    for i in 0..named_names.len {
        let a = child(e.get("args"), *named_idx.at(i));
        let an = String.from(*named_names.at(i));
        if *named_uses.at(i) == 0 {
            here(ck, a.get("name_span").span, format("the argument `{an}` is never used by the format string"), "unused argument",
                 format("add `{{{an}}}` to the string"));
            ok = false;
        } else if *named_uses.at(i) > 1 && !is_simple_arg(a.node_of("expr").kind) {
            here(ck, a.node_of("expr").span, "an argument used more than once must be a simple value", "", "bind it to a variable first, then use `{name}`");
            ok = false;
        }
    }
    if !ok { return false; }
    let mut fs = ast.new_node("FStr", t.span);
    fs.set("parts", ast.v_list(parts));
    let mut out: List<ast.Val> = List.new();
    for i in 0..tidx { out.push(ast.clone_val(e.get("args").items.at(i))); }
    out.push(ast.v_node(fs));
    e.set("args", ast.v_list(out));
    return true;
}

pub fn split_dots(s: str) -> List<String> {
    let mut o: List<String> = List.new();
    let mut cur = String.empty();
    for i in 0..s.len {
        if s[i] == '.' { o.push(cur); cur = String.empty(); } else { cur.push(s[i]); }
    }
    o.push(cur);
    return o;
}

pub fn se_help(se: *fmtspec.SpecError) -> String { return se.has_help ? String.from(se.help) : String.empty(); }
pub fn ck_help(c: *fmtspec.Checked) -> String { return c.has_help ? String.from(c.help) : String.empty(); }

pub fn spec_text(s: *fmtspec.Spec) -> String {
    let alt = s.alt ? 1 : 0;
    let zero = s.zero ? 1 : 0;
    return format("Spec({s.fill},{s.align},{s.sign},{alt},{zero},{s.width},{s.group},{s.prec},{s.ty})");
}

pub fn ann_raw(s: String) -> ast.Val { let mut v = ast.v_str(""); v.tag = 14; v.s = s; return v; }

pub fn fpart(ck: *Checker, part: *ast.Node) {
    set_nil(part, "pspec");
    set_nil(part, "mode");
    let expr = part.node_of("expr");
    let mut spec = fmtspec.new_spec();
    let mut have_spec = false;
    let stext = String.from(part.str_of("spec"));
    let sp_span = (part.has("spec_span") && part.get("spec_span").tag == 6) ? part.get("spec_span").span : part.span;
    if stext.len > 0 {
        let mut se = fmtspec.SpecError { msg: String.empty(), help: String.empty(), has_help: false };
        let mut bad = false;
        try {
            spec = try fmtspec.parse_spec(stext, &se);
        } catch {
            bad = true;
        }
        if bad { here(ck, sp_span, se.msg, "in this format spec", se_help(&se)); }
        else { have_spec = true; }
    }
    let t = check(ck, expr, -1, false);
    if t == types.POISON { return; }
    if tk(ck, t) == types.K_EU {
        let ts = ty_str(ck, t);
        here(ck, expr.span, format("cannot interpolate a value of type `{ts}`"), "has a possible error", "handle the error first with `try` or `catch`");
        return;
    }
    if !have_spec { spec = fmtspec.new_spec(); }
    let mut psv = ann_raw(spec_text(&spec));
    psv.items.push(ast.v_str(spec.fill));
    psv.items.push(ast.v_str(spec.align));
    psv.items.push(ast.v_str(spec.sign));
    psv.items.push(ast.v_int(spec.alt ? 1 : 0));
    psv.items.push(ast.v_int(spec.zero ? 1 : 0));
    psv.items.push(ast.v_int(spec.width));
    psv.items.push(ast.v_str(spec.group));
    psv.items.push(ast.v_int(spec.prec));
    psv.items.push(ast.v_str(spec.ty));
    part.set("pspec", psv);
    let debug = spec.ty == "?";
    let mut kind = "other";
    let mut mode = "";
    if debug {
        let mut seen: List<String> = List.new();
        let bad = debuggable(ck, t, &seen);
        if bad >= 0 {
            let bs = ty_str(ck, bad);
            here(ck, expr.span, format("cannot show a value of type `{bs}` with `:?`"), "",
                 "the automatic representation covers numbers, text, enums, pointers, arrays, slices and structs of those");
            return;
        }
        mode = "debug";
    } else {
        let mut shown = ast.new_node("tmp", expr.span);
        let tk0 = tk(ck, t);
        if display_call(ck, expr, t, &shown) {
            part.set("src", ast.v_node(ast.clone_node(shown.node_of("callee").node_of("obj"))));
            part.set("expr", ast.v_node(shown));
            mode = "text";
            kind = "text";
            part.set("mode", ast.v_str(mode));
            let mut msg = fmtspec.check_for(&spec, kind);
            if !msg.ok { here(ck, sp_span, msg.msg, "in this format spec", ck_help(&msg)); }
            return;
        }
        if types.is_int(t) { mode = "int"; kind = "int"; }
        else if types.is_float(t) { mode = "float"; kind = "float"; }
        else if t == types.BOOL { mode = "bool"; kind = "bool"; }
        else if t == types.STR || t == types.STRING || t == types.ERR { mode = "text"; kind = "text"; }
        else if tk0 == types.K_ENUM { mode = "enum"; kind = "enum"; }
        else if tk0 == types.K_PTR || tk0 == types.K_FN { mode = "ptr"; kind = "ptr"; }
        else {
            let ts = ty_str(ck, t);
            here(ck, expr.span, format("cannot interpolate a value of type `{ts}`"), "no text representation", display_help(ck, t));
            return;
        }
    }
    part.set("mode", ast.v_str(mode));
    part.set("src", ast.v_node(ast.clone_node(part.node_of("expr"))));
    if !debug {
        let mut msg = fmtspec.check_for(&spec, kind);
        if !msg.ok { here(ck, sp_span, msg.msg, "in this format spec", ck_help(&msg)); }
    }
}

pub fn ex_fstr(ck: *Checker, e: *ast.Node) -> i64 {
    if ck.nostd { need_std(ck, ck.cur_mod, e.span, "string interpolation"); }
    let n = e.get("parts").items.len;
    for i in 0..n {
        let part = child(e.get("parts"), i);
        if part.get("expr").tag == 0 { continue; }
        if part.has("src") { part.set("expr", ast.v_node(ast.clone_node(part.node_of("src")))); }
        fpart(ck, part);
        if !part.has("src") { part.set("src", ast.v_node(ast.clone_node(part.node_of("expr")))); }
    }
    return types.STR;
}

pub fn replace_arg(e: *ast.Node, i: i64, n: ast.Node) { *e.get("args").items.at(i) = ast.v_node(n); }

pub fn arity(ck: *Checker, e: *ast.Node, name: str, nmin: i64, nmax: i64) -> bool {
    let n = e.get("args").items.len;
    if n < nmin || n > nmax {
        let want = nmin == nmax ? format("{nmin}") : format("{nmin} to {nmax}");
        here(ck, e.span, format("`{name}` takes {want} argument(s) but {n} were supplied"), "", "");
        check_all_args(ck, e);
        return false;
    }
    return true;
}

pub fn is_printable(ck: *Checker, t: i64) -> bool {
    let k = tk(ck, t);
    return types.is_numeric(t) || t == types.BOOL || t == types.STR || t == types.STRING || t == types.ERR
        || k == types.K_ENUM || k == types.K_PTR || k == types.K_FN;
}

pub fn nostd_banned(n: str) -> bool {
    let names = ["print", "println", "alloc", "free", "exit", "to_str", "string_new", "string_from", "string_clear", "cstr", "format",
                 "gc_collect", "gc_bytes", "gc_collections", "alloc_in", "gc_collect_gen", "gc_gen_bytes", "gc_gen_collections"];
    for i in 0..18 { if names[i] == n { return true; } }
    return false;
}

pub fn builtin(ck: *Checker, e: *ast.Node, name: String) -> i64 {
    e.set("builtin", ast.v_str(name));
    let mi = ck.cur_mod;
    if ck.nostd && nostd_banned(name) {
        need_std(ck, mi, e.span, format("`{name}`"));
        check_all_args(ck, e);
        return types.POISON;
    }
    if name == "gc_collect_gen" && ck.gc_mode != "manual" {
        let why = ck.gc_mode == "off" ? String.from("the collector is off (`--no-gc`)") : format("this build uses `--gc-mode={ck.gc_mode}`");
        here_n(ck, e.span, "`gc_collect_gen` needs the manual collector mode", "not available in this build",
               "build with `--gc-mode=manual` (cookie: `gc_mode = \"manual\"`) to decide yourself when each generation is collected; `gc_collect()` works in every mode", why);
        check_all_args(ck, e);
        return types.POISON;
    }
    if name == "print" || name == "println" || name == "format" || name == "panic" || name == "assert" {
        if !fmt_args(ck, e, name) {
            for i in 0..e.get("args").items.len { check(ck, arg_expr(child(e.get("args"), i)), -1, false); }
            return types.POISON;
        }
    }
    let na = e.get("args").items.len;
    if name == "format" {
        if na == 0 {
            here(ck, e.span, "`format` takes a format string: `format(\"{} items\", n)`", "", "");
            return types.POISON;
        }
        check(ck, child(e.get("args"), 0), -1, false);
        return types.STRING;
    }
    if name == "print" || name == "println" {
        for i in 0..na {
            let a = child(e.get("args"), i);
            let t = check(ck, a, -1, false);
            if t == types.POISON { continue; }
            let mut shown = ast.new_node("tmp", a.span);
            if display_call(ck, a, t, &shown) { replace_arg(e, i, shown); continue; }
            if !is_printable(ck, t) {
                let ts = ty_str(ck, t);
                here(ck, a.span, format("cannot print a value of type `{ts}`"), "", display_help(ck, t));
            }
        }
        return types.VOID;
    }
    if name == "string_new" { arity(ck, e, name, 0, 0); return types.STRING; }
    if name == "string_from" {
        if arity(ck, e, name, 1, 1) { expect(ck, child(e.get("args"), 0), types.STR, false); }
        return types.STRING;
    }
    if name == "string_clear" {
        if arity(ck, e, name, 1, 1) {
            let a = child(e.get("args"), 0);
            let t = check(ck, a, -1, false);
            if t != types.POISON && !types.eq(&ck.types, t, types.ptr(&ck.types, types.STRING, false)) {
                let ts = ty_str(ck, t);
                here(ck, a.span, format("`string_clear` expects `*String`, found `{ts}`"), "", "pass `&s` (declared `let mut`)");
            }
        }
        return types.VOID;
    }
    if name == "to_str" {
        if arity(ck, e, name, 1, 1) {
            let a = child(e.get("args"), 0);
            let t = check(ck, a, -1, false);
            let mut shown = ast.new_node("tmp", a.span);
            let got = t != types.POISON && display_call(ck, a, t, &shown);
            if got {
                set_flag(&shown, "owned", true);
                replace_arg(e, 0, shown);
            } else if t != types.POISON && !(types.is_numeric(t) || t == types.BOOL || t == types.STR || t == types.STRING || t == types.ERR || tk(ck, t) == types.K_ENUM) {
                let ts = ty_str(ck, t);
                here(ck, a.span, format("cannot convert a value of type `{ts}` to `str`"), "", display_help(ck, t));
            }
        }
        return types.STR;
    }
    if name == "panic" {
        if arity(ck, e, name, 1, 1) { expect(ck, child(e.get("args"), 0), types.STR, false); }
        return types.VOID;
    }
    if name == "assert" {
        if arity(ck, e, name, 1, 2) {
            expect(ck, child(e.get("args"), 0), types.BOOL, false);
            if e.get("args").items.len == 2 { expect(ck, child(e.get("args"), 1), types.STR, false); }
        }
        return types.VOID;
    }
    if name == "exit" {
        if arity(ck, e, name, 1, 1) { expect(ck, child(e.get("args"), 0), types.I32, false); }
        return types.VOID;
    }
    if name == "alloc" {
        let t = resolve_type(ck, e.node_of("targ"), mi, false);
        if na != 1 {
            here(ck, e.span, "`alloc` takes a type and a count: `alloc(T, n)`", "", "");
            check_all_args(ck, e);
            return types.POISON;
        }
        let a0 = child(e.get("args"), 0);
        let nt = check(ck, a0, untyped(ck, a0) ? types.I64 : -1, false);
        if nt != types.POISON && !types.is_int(nt) {
            let ns = ty_str(ck, nt);
            here(ck, a0.span, format("allocation count must be an integer, found `{ns}`"), "", "");
        }
        set_tyn(e, "elem", t);
        return t == types.POISON ? types.POISON : types.slc(&ck.types, t);
    }
    if name == "alloc_in" {
        let t = resolve_type(ck, e.node_of("targ"), mi, false);
        if na != 2 {
            here(ck, e.span, "`alloc_in` takes a type, a count and a region: `alloc_in(T, n, r)`", "", "");
            for i in 0..na {
                let a = child(e.get("args"), i);
                let mut skip = false;
                if a.kind == "Ident" {
                    let l = lookup_local(ck, a.str_of("name"));
                    if l >= 0 && ck.locals.at(l).region_handle { skip = true; }
                }
                if !skip { check(ck, a, -1, false); }
            }
            return types.POISON;
        }
        let a0 = child(e.get("args"), 0);
        let nt = check(ck, a0, untyped(ck, a0) ? types.I64 : -1, false);
        if nt != types.POISON && !types.is_int(nt) {
            let ns = ty_str(ck, nt);
            here(ck, a0.span, format("allocation count must be an integer, found `{ns}`"), "", "");
        }
        let r = child(e.get("args"), 1);
        let mut loc = -1 as i64;
        if r.kind == "Ident" { loc = lookup_local(ck, r.str_of("name")); }
        if loc < 0 || !ck.locals.at(loc).region_handle {
            let n0 = ck.d.error_count();
            check(ck, r, -1, false);
            if ck.d.error_count() == n0 {
                here(ck, r.span, "the last argument of `alloc_in` must be a region", "", "declare one with `region r { ... }` and allocate inside the block");
            }
            return types.POISON;
        }
        ck.locals.at(loc).used = true;
        r.set("local", ast.v_tag(12, loc));
        e.set("region_local", ast.v_tag(12, loc));
        set_tyn(e, "elem", t);
        return t == types.POISON ? types.POISON : types.slc(&ck.types, t);
    }
    if name == "gc_collections" || name == "gc_bytes" { arity(ck, e, name, 0, 0); return types.I64; }
    if name == "gc_collect" { arity(ck, e, name, 0, 0); return types.VOID; }
    if name == "gc_collect_gen" || name == "gc_gen_bytes" || name == "gc_gen_collections" {
        if arity(ck, e, name, 1, 1) { expect(ck, child(e.get("args"), 0), types.I64, false); }
        return name == "gc_collect_gen" ? types.VOID : types.I64;
    }
    if name == "cstr" {
        if arity(ck, e, name, 1, 1) {
            let a = child(e.get("args"), 0);
            let t = check(ck, a, -1, false);
            if t != types.POISON && t != types.STR && t != types.STRING {
                let ts = ty_str(ck, t);
                here(ck, a.span, format("`cstr` expects a `str` or `String`, found `{ts}`"), "", "");
            }
        }
        return types.ptr(&ck.types, types.U8, false);
    }
    if name == "from_cstr" {
        if arity(ck, e, name, 1, 1) {
            let a = child(e.get("args"), 0);
            let t = check(ck, a, -1, false);
            if t != types.POISON && !(tk(ck, t) == types.K_PTR && (ck.types.tys.at(t).inner == types.U8 || ck.types.tys.at(t).inner == types.I8)) {
                let ts = ty_str(ck, t);
                here(ck, a.span, format("`from_cstr` expects a `*u8` (a NUL-terminated C string), found `{ts}`"), "", "cast other pointers first: `p as *u8`");
            }
        }
        return types.STR;
    }
    if name == "slice_of" {
        if arity(ck, e, name, 2, 2) {
            let a0 = child(e.get("args"), 0);
            let a1 = child(e.get("args"), 1);
            let pt = check(ck, a0, -1, false);
            let nt = check(ck, a1, untyped(ck, a1) ? types.I64 : -1, false);
            if nt != types.POISON && !types.is_int(nt) {
                let ns = ty_str(ck, nt);
                here(ck, a1.span, format("a slice length must be an integer, found `{ns}`"), "", "");
            }
            if pt == types.POISON { return types.POISON; }
            if tk(ck, pt) != types.K_PTR || ck.types.tys.at(pt).inner == types.VOID {
                let ps = ty_str(ck, pt);
                here(ck, a0.span, format("`slice_of` expects a typed pointer, found `{ps}`"), "", "cast a `*void` first: `p as *T`");
                return types.POISON;
            }
            return types.slc(&ck.types, ck.types.tys.at(pt).inner);
        }
        return types.POISON;
    }
    if name == "size_of" {
        let t = resolve_type(ck, e.node_of("targ"), mi, false);
        if t != types.POISON && !sized(ck, t, mi, e.node_of("targ").span) { return types.I64; }
        set_tyn(e, "elem", t);
        return types.I64;
    }
    if name == "drop" {
        if arity(ck, e, name, 1, 1) {
            let a = child(e.get("args"), 0);
            check(ck, a, -1, false);
            consume(ck, a);
        }
        return types.VOID;
    }
    if name == "drop_at" {
        if arity(ck, e, name, 1, 1) {
            let a = child(e.get("args"), 0);
            let t = check(ck, a, -1, false);
            if t != types.POISON && (tk(ck, t) != types.K_PTR || ck.types.tys.at(t).inner == types.VOID) {
                let ts = ty_str(ck, t);
                here(ck, a.span, format("`drop_at` expects a typed pointer, found `{ts}`"), "", "");
            }
        }
        return types.VOID;
    }
    if name == "write_at" {
        if arity(ck, e, name, 2, 2) {
            let a0 = child(e.get("args"), 0);
            let a1 = child(e.get("args"), 1);
            let pt = check(ck, a0, -1, false);
            if pt != types.POISON && (tk(ck, pt) != types.K_PTR || ck.types.tys.at(pt).inner == types.VOID) {
                let ps = ty_str(ck, pt);
                here(ck, a0.span, format("`write_at` expects a typed pointer, found `{ps}`"), "", "");
                check(ck, a1, -1, false);
            } else if pt == types.POISON {
                check(ck, a1, -1, false);
            } else {
                expect(ck, a1, ck.types.tys.at(pt).inner, false);
            }
        }
        return types.VOID;
    }
    if name == "read_at" {
        if arity(ck, e, name, 1, 1) {
            let a = child(e.get("args"), 0);
            let t = check(ck, a, -1, false);
            if t == types.POISON { return types.POISON; }
            if tk(ck, t) != types.K_PTR || ck.types.tys.at(t).inner == types.VOID {
                let ts = ty_str(ck, t);
                here(ck, a.span, format("`read_at` expects a typed pointer, found `{ts}`"), "", "");
                return types.POISON;
            }
            return ck.types.tys.at(t).inner;
        }
        return types.POISON;
    }
    // free
    if arity(ck, e, name, 1, 1) {
        let a = child(e.get("args"), 0);
        let t = check(ck, a, -1, false);
        if t != types.POISON && tk(ck, t) != types.K_SLICE && t != types.STRING {
            let ts = ty_str(ck, t);
            here(ck, a.span, format("`free` expects a slice or a `String`, found `{ts}`"), "", "");
        } else if t == types.STRING {
            consume(ck, a);
        }
        let tr = taint(ck, a);
        if tr >= 0 {
            let rn = String.from(ck.locals.at(tr).name);
            here(ck, a.span, format("memory from region `{rn}` is freed when the region ends"), "", "remove the `free`");
        }
    }
    return types.VOID;
}

// ---- borrow checker ----------------------------------------------------------------------------------------------------------
// A port of src/crumbsc/borrowck.py. Owners of loans are local indices (>= 0) or, for what a parameter's referent stands for,
// -(index + 1). Loan kinds: 0 borrow, 1 into, 2 through.

pub struct Loan { owner: i64, path: List<String>, excl: bool, span: ast.Span, via_own: bool, closure: bool, kind: i64 }
pub struct Root { ok: bool, loc: i64, path: List<String> }
pub struct UseEnt { tick: i64, span: ast.Span }

pub struct Bck {
    report: bool,
    phase: i64,
    tick: i64,
    addr: i64,
    summary: List<SumEnt>,
    last: List<i64>,          // per local: last tick of use (-1: none)
    decl: List<i64>,          // per local: tick of its declaration (-1: none)
    uses: List<List<UseEnt>>,
    loop_s: List<i64>,
    loop_e: List<i64>,
    touched: List<i64>,
    tmark: List<bool>,
    hix: List<i64>,           // per local: position in h_keys (-1: none)
    h_keys: List<i64>,
    h_vals: List<List<Loan>>,
    moved: List<bool>,
    pnames: List<String>,
}

pub fn clone_loan(l: *Loan) -> Loan {
    let mut p: List<String> = List.new();
    for i in 0..l.path.len { p.push(String.from(*l.path.at(i))); }
    return Loan { owner: l.owner, path: p, excl: l.excl, span: l.span, via_own: l.via_own, closure: l.closure, kind: l.kind };
}

pub fn extend_loans(dst: *List<Loan>, src: *List<Loan>) { for i in 0..src.len { dst.push(clone_loan(src.at(i))); } }

pub fn copy_loans(src: *List<Loan>) -> List<Loan> {
    let mut o: List<Loan> = List.new();
    extend_loans(&o, src);
    return o;
}

pub fn b_touch(b: *Bck, loc: i64) {
    if !*b.tmark.at(loc) { *b.tmark.at(loc) = true; b.touched.push(loc); }
}

pub fn b_prepare(ck: *Checker, b: *Bck) {
    while b.last.len < ck.locals.len {
        b.last.push(-1);
        b.decl.push(-1);
        let ul: List<UseEnt> = List.new();
        b.uses.push(ul);
        b.tmark.push(false);
        b.hix.push(-1);
        b.moved.push(false);
    }
}

pub fn b_reset(b: *Bck) {
    for i in 0..b.touched.len {
        let l = *b.touched.at(i);
        *b.last.at(l) = -1;
        *b.decl.at(l) = -1;
        b.uses.at(l).clear();
        *b.tmark.at(l) = false;
        *b.hix.at(l) = -1;
        *b.moved.at(l) = false;
    }
    b.touched.clear();
    b.h_keys.clear();
    b.h_vals.clear();
    b.loop_s.clear();
    b.loop_e.clear();
}

pub fn b_last0(b: *Bck, l: i64) -> i64 { let v = *b.last.at(l); return v < 0 ? 0 : v; }
pub fn b_decl0(b: *Bck, l: i64) -> i64 { let v = *b.decl.at(l); return v < 0 ? 0 : v; }
pub fn b_set_decl(b: *Bck, l: i64, v: i64) { b_touch(b, l); *b.decl.at(l) = v; }
pub fn b_decl_default(b: *Bck, l: i64, v: i64) { b_touch(b, l); if *b.decl.at(l) < 0 { *b.decl.at(l) = v; } }
pub fn b_last_default(b: *Bck, l: i64, v: i64) { b_touch(b, l); if *b.last.at(l) < 0 { *b.last.at(l) = v; } }

pub fn mark_use(b: *Bck, loc: i64, sp: ast.Span) {
    b_touch(b, loc);
    *b.last.at(loc) = b.tick;
    b.uses.at(loc).push(UseEnt { tick: b.tick, span: sp });
}

pub fn live_after(b: *Bck, h: i64) -> bool { return b_last0(b, h) > b.tick; }

pub fn holds_get(b: *Bck, l: i64) -> List<Loan> {
    let ix = *b.hix.at(l);
    if ix < 0 { let mut e: List<Loan> = List.new(); return e; }
    return copy_loans(b.h_vals.at(ix));
}

pub fn holds_set(b: *Bck, l: i64, v: List<Loan>) {
    b_touch(b, l);
    let ix = *b.hix.at(l);
    if ix >= 0 { *b.h_vals.at(ix) = v; return; }
    *b.hix.at(l) = b.h_keys.len;
    b.h_keys.push(l);
    b.h_vals.push(v);
}

pub fn holds_extend(b: *Bck, l: i64, v: *List<Loan>) {
    b_touch(b, l);
    let ix = *b.hix.at(l);
    if ix < 0 {
        *b.hix.at(l) = b.h_keys.len;
        b.h_keys.push(l);
        b.h_vals.push(copy_loans(v));
        return;
    }
    extend_loans(b.h_vals.at(ix), v);
}

pub fn owner_name(ck: *Checker, b: *Bck, o: i64) -> String {
    if o >= 0 { return String.from(ck.locals.at(o).name); }
    return String.from(*b.pnames.at(-o - 1));
}

pub fn overlap(a: *List<String>, c: *List<String>) -> bool {
    let n = a.len < c.len ? a.len : c.len;
    for i in 0..n { if *a.at(i) != *c.at(i) { return false; } }
    return true;
}

pub fn b_err(ck: *Checker, b: *Bck, sp: ast.Span, msg: str, label: str, help: str) {
    if b.report { here(ck, sp, msg, label, help); }
}

pub fn truthy(e: *ast.Node, name: str) -> bool {
    if !e.has(name) { return false; }
    let v = e.get(name);
    if v.tag == 0 { return false; }
    if v.tag == 1 { return v.i != 0; }
    return true;
}

pub fn b_holds_ptr(ck: *Checker, t: i64) -> bool { return t >= 0 && t != types.POISON && holds_ptr(ck, t); }

pub fn next_use(b: *Bck, loc: i64) -> i32 {
    for i in 0..b.uses.at(loc).len { if b.uses.at(loc).at(i).tick > b.tick { return i as i32; } }
    return -1;
}

pub fn b_kids(n: *ast.Node) -> List<*ast.Node> {
    let mut out: List<*ast.Node> = List.new();
    for ai in 0..n.attrs.len {
        let an: str = n.attrs.at(ai).name;
        if an == "span" || an == "ty" || an == "local" || an == "sym" || an == "handler" || an == "orig_args" || an == "eu_ty" || an == "opty"
            || an == "elem" || an == "region_local" || an == "name_span" || an == "tyn" || an == "targ" || an == "targs" { continue; }
        let v = &n.attrs.at(ai).v;
        if v.tag == 4 { out.push(v.node.at(0)); }
        else if v.tag == 5 {
            for q in 0..v.items.len {
                let it = v.items.at(q);
                if it.tag == 4 { out.push(it.node.at(0)); }
                else if it.tag == 5 {
                    for r in 0..it.items.len { if it.items.at(r).tag == 4 { out.push(it.items.at(r).node.at(0)); } }
                }
            }
        }
    }
    return out;
}

pub fn place_root(ck: *Checker, e0: *ast.Node) -> Root {
    let mut path: List<String> = List.new();
    let mut e = e0;
    while true {
        let k: str = e.kind;
        if k == "Ident" {
            if e.has("local") && e.get("local").tag == 12 {
                let loc = e.get("local").i;
                if ck.locals.at(loc).region_handle || ck.locals.at(loc).captured { return Root { ok: false, loc: -1, path: List.new() }; }
                path.reverse();
                return Root { ok: true, loc: loc, path: path };
            }
            return Root { ok: false, loc: -1, path: List.new() };
        }
        if k == "Field" {
            if !(e.has("mode") && e.get("mode").tag == 3 && e.str_of("mode") == "field") { return Root { ok: false, loc: -1, path: List.new() }; }
            path.push(String.from(e.str_of("name")));
            e = e.node_of("obj");
            continue;
        }
        if k == "Index" {
            let bt = ty_of(e.node_of("obj"));
            if bt < 0 || tk(ck, bt) != types.K_ARR { return Root { ok: false, loc: -1, path: List.new() }; }
            path.push(String.from("[]"));
            e = e.node_of("obj");
            continue;
        }
        return Root { ok: false, loc: -1, path: List.new() };
    }
    return Root { ok: false, loc: -1, path: List.new() };
}

pub fn is_own_ty(ck: *Checker, t: i64) -> bool {
    if t < 0 || tk(ck, t) != types.K_STRUCT { return false; }
    let sy = ck.types.tys.at(t).sym;
    return ck.syms.at(sy).name.starts_with("Own") && ck.syms.at(sy).full.contains("own");
}

pub fn is_checked_ty(ck: *Checker, t: i64) -> bool {
    if t < 0 || tk(ck, t) != types.K_STRUCT { return false; }
    let sy = ck.types.tys.at(t).sym;
    return (ck.syms.at(sy).name.starts_with("Ref") || ck.syms.at(sy).name.starts_with("Weak")) && ck.syms.at(sy).full.contains("own");
}

pub fn b_access(ck: *Checker, b: *Bck, loc: i64, path: *List<String>, kind: str, sp: ast.Span) {
    if b.phase != 2 { return; }
    for hi in 0..b.h_keys.len {
        let h = *b.h_keys.at(hi);
        if h == loc || !live_after(b, h) { continue; }
        for li in 0..b.h_vals.at(hi).len {
            let ln = b.h_vals.at(hi).at(li);
            if ln.owner != loc || !overlap(&ln.path, path) { continue; }
            if (kind == "read" || kind == "shared") && !ln.excl { continue; }
            if kind == "move" && ln.via_own { continue; }
            b_conflict(ck, b, loc, kind, ln, h, sp);
            return;
        }
    }
}

pub fn b_conflict(ck: *Checker, b: *Bck, loc: i64, kind: str, ln: *Loan, holder: i64, sp: ast.Span) {
    let ln_name = String.from(ck.locals.at(loc).name);
    let hn = String.from(ck.locals.at(holder).name);
    let what = kind == "read" ? "use" : (kind == "write" ? "assign to" : (kind == "move" ? "move out of" : (kind == "excl" ? "borrow mutably" : "borrow")));
    let state = ln.excl ? "mutably borrowed" : "borrowed";
    let how = ln.excl ? "mutable" : "shared";
    let lab = kind == "read" ? format("`{ln_name}` is read here")
        : (kind == "write" ? format("`{ln_name}` is assigned here")
        : (kind == "move" ? format("`{ln_name}` is moved here")
        : (kind == "excl" ? format("`{ln_name}` is borrowed mutably here") : format("`{ln_name}` is borrowed here"))));
    let n0 = ck.d.items.len;
    b_err(ck, b, sp, format("cannot {what} `{ln_name}` because it is {state}"), format("{lab} while the {how} borrow is alive"),
          format("finish using `{hn}` before this, or make a copy of what you need"));
    if b.report && ck.d.items.len > n0 {
        let how2 = ln.closure ? String.from(", held by the closure") : format(", and is kept in `{hn}`");
        ck.d.add_extra(ln.span.line, ln.span.col, ln.span.len, format("{how} borrow of `{ln_name}` starts here{how2}"));
        let nu = next_use(b, holder);
        if nu >= 0 {
            let us = b.uses.at(holder).at(nu as i64).span;
            ck.d.add_extra(us.line, us.col, us.len, format("`{hn}` is used here, so the borrow is still alive"));
        }
    }
}

pub fn walk_index_parts(ck: *Checker, b: *Bck, e0: *ast.Node) {
    let mut e = e0;
    while e.kind == "Field" || e.kind == "Index" {
        if e.kind == "Index" { walk(ck, b, e.node_of("idx")); }
        e = e.node_of("obj");
    }
}

pub fn read_through(ck: *Checker, b: *Bck, loans: *List<Loan>) -> List<Loan> {
    let mut out: List<Loan> = List.new();
    for i in 0..loans.len {
        let ln = loans.at(i);
        if ln.owner < 0 {
            out.push(Loan { owner: ln.owner, path: List.new(), excl: false, span: ln.span, via_own: false, closure: false, kind: 2 });
        } else if ln.kind == 0 {
            let mut h = holds_get(b, ln.owner);
            extend_loans(&out, &h);
        }
    }
    return out;
}

pub fn place_loans(ck: *Checker, b: *Bck, e: *ast.Node) -> List<Loan> {
    if e.kind == "Field" || e.kind == "Index" {
        if e.kind == "Index" { walk(ck, b, e.node_of("idx")); }
        return place_loans(ck, b, e.node_of("obj"));
    }
    if e.kind == "Unary" && e.str_of("op") == "*" { return walk(ck, b, e.node_of("expr")); }
    return walk(ck, b, e);
}

pub fn walk_kids(ck: *Checker, b: *Bck, n: *ast.Node) -> List<Loan> {
    let mut carried: List<Loan> = List.new();
    let mut ks = b_kids(n);
    for i in 0..ks.len {
        let mut c = walk(ck, b, *ks.at(i));
        extend_loans(&carried, &c);
    }
    return carried;
}

pub fn walk(ck: *Checker, b: *Bck, n: *ast.Node) -> List<Loan> {
    let k: str = n.kind;
    if k == "Ident" { return w_ident(ck, b, n); }
    if k == "Field" || k == "Index" { return w_place_read(ck, b, n); }
    if k == "Unary" { return w_unary(ck, b, n); }
    if k == "Call" { return w_call(ck, b, n); }
    if k == "Assign" { return w_assign(ck, b, n); }
    if k == "IncDec" { return w_incdec(ck, b, n); }
    if k == "Let" { return w_let(ck, b, n); }
    if k == "Block" { return w_block(ck, b, n); }
    if k == "Return" { return w_return(ck, b, n); }
    if k == "While" || k == "Loop" { return b_loop(ck, b, n); }
    if k == "For" {
        if truthy(n, "desugared") { return walk(ck, b, n.node_of("desugared")); }
        return b_loop(ck, b, n);
    }
    if k == "Fn" { let mut e: List<Loan> = List.new(); return e; }
    if k == "Closure" { return w_closure(ck, b, n); }
    let mut carried = walk_kids(ck, b, n);
    if b_holds_ptr(ck, ty_of(n)) { return carried; }
    let mut e: List<Loan> = List.new();
    return e;
}

pub fn w_ident(ck: *Checker, b: *Bck, n: *ast.Node) -> List<Loan> {
    let mut out: List<Loan> = List.new();
    if !(n.has("local") && n.get("local").tag == 12) { return out; }
    let loc = n.get("local").i;
    b.tick += 1;
    if b.phase == 1 {
        mark_use(b, loc, n.span);
        b_decl_default(b, loc, b.tick);
        return out;
    }
    let mut none: List<String> = List.new();
    if flag(n, "move") {
        b_access(ck, b, loc, &none, "move", n.span);
        *b.moved.at(loc) = true; b_touch(b, loc);
    } else { b_access(ck, b, loc, &none, "read", n.span); }
    if b_holds_ptr(ck, ck.locals.at(loc).ty) { out = holds_get(b, loc); }
    return out;
}

pub fn w_place_read(ck: *Checker, b: *Bck, n: *ast.Node) -> List<Loan> {
    let mut root = place_root(ck, n);
    if root.ok {
        walk_index_parts(ck, b, n);
        b.tick += 1;
        let mut out: List<Loan> = List.new();
        if b.phase == 1 {
            mark_use(b, root.loc, n.span);
            b_decl_default(b, root.loc, b.tick);
            return out;
        }
        b_access(ck, b, root.loc, &root.path, flag(n, "move") ? "move" : "read", n.span);
        if b_holds_ptr(ck, ty_of(n)) { out = holds_get(b, root.loc); }
        return out;
    }
    let mut carried = walk_kids(ck, b, n);
    let mut e: List<Loan> = List.new();
    if !b_holds_ptr(ck, ty_of(n)) { return e; }
    if b.addr != 0 { return carried; }
    return read_through(ck, b, &carried);
}

pub fn w_unary(ck: *Checker, b: *Bck, n: *ast.Node) -> List<Loan> {
    let op = String.from(n.str_of("op"));
    if op == "&" {
        let mut root = place_root(ck, n.node_of("expr"));
        if root.ok {
            let excl = !flag(n, "auto_ref");
            walk_index_parts(ck, b, n.node_of("expr"));
            b.tick += 1;
            let mut out: List<Loan> = List.new();
            if b.phase == 1 {
                mark_use(b, root.loc, n.span);
                b_decl_default(b, root.loc, b.tick);
                return out;
            }
            b_access(ck, b, root.loc, &root.path, excl ? "excl" : "shared", n.span);
            out.push(Loan { owner: root.loc, path: copy_strs(&root.path), excl: excl, span: n.span, via_own: is_own_ty(ck, ck.locals.at(root.loc).ty), closure: false, kind: 0 });
            return out;
        }
        return place_loans(ck, b, n.node_of("expr"));
    }
    let mut carried = walk_kids(ck, b, n);
    let mut e: List<Loan> = List.new();
    if !b_holds_ptr(ck, ty_of(n)) { return e; }
    if op == "*" { return read_through(ck, b, &carried); }
    return carried;
}

pub fn copy_strs(l: *List<String>) -> List<String> {
    let mut o: List<String> = List.new();
    for i in 0..l.len { o.push(String.from(*l.at(i))); }
    return o;
}

pub fn w_call(ck: *Checker, b: *Bck, n: *ast.Node) -> List<Loan> {
    let c = n.node_of("callee");
    let indirect = truthy(n, "indirect");
    let mut callee_loans: List<Loan> = List.new();
    if indirect { callee_loans = walk(ck, b, c); }
    else if !(flag(n, "method_recv") || c.kind != "Ident" || !(c.has("local") && c.get("local").tag == 12)) { walk(ck, b, c); }
    let mut per_arg: List<List<Loan>> = List.new();
    for i in 0..n.get("args").items.len { per_arg.push(walk(ck, b, n.get("args").items.at(i).node.at(0))); }
    let mut none: List<Loan> = List.new();
    if is_checked_ty(ck, ty_of(n)) { return none; }
    let has_sym = n.has("sym") && n.get("sym").tag == 11;
    let sym = has_sym ? n.get("sym").i : -1;
    let is_ext = has_sym && ck.syms.at(sym).is_extern;
    if b.phase == 2 && !is_ext {
        for i in 0..per_arg.len {
            for j in (i + 1)..per_arg.len {
                for x in 0..per_arg.at(i).len {
                    for y in 0..per_arg.at(j).len {
                        let l1 = per_arg.at(i).at(x);
                        let l2 = per_arg.at(j).at(y);
                        if l1.owner == l2.owner && overlap(&l1.path, &l2.path) && (l1.excl || l2.excl) {
                            let on = owner_name(ck, b, l1.owner);
                            let ln1 = l1.span.line;
                            b_err(ck, b, l2.span, format("cannot borrow `{on}` twice in one call"),
                                  format("`{on}` is also borrowed at line {ln1} in this call"), "borrow it once, or borrow different fields");
                        }
                    }
                }
            }
        }
    }
    if !b_holds_ptr(ck, ty_of(n)) { return none; }
    if is_ext && !indirect { return none; }
    let mut carried = copy_loans(&callee_loans);
    let has_builtin = n.has("builtin") && n.get("builtin").tag == 3 && n.str_of("builtin").len > 0;
    if indirect || !has_sym || !ck.syms.at(sym).has_summary || has_builtin {
        for i in 0..per_arg.len { extend_loans(&carried, per_arg.at(i)); }
        return carried;
    }
    for si in 0..ck.syms.at(sym).summary.len {
        let kind = ck.syms.at(sym).summary.at(si).kind;
        let i = ck.syms.at(sym).summary.at(si).idx;
        if i < per_arg.len {
            if kind == 1 { extend_loans(&carried, per_arg.at(i)); }
            else { let mut r = read_through(ck, b, per_arg.at(i)); extend_loans(&carried, &r); }
        }
    }
    return carried;
}

pub fn w_assign(ck: *Checker, b: *Bck, n: *ast.Node) -> List<Loan> {
    let t = n.node_of("target");
    let mut carried = walk(ck, b, n.node_of("value"));
    let mut root = place_root(ck, t);
    let mut e: List<Loan> = List.new();
    if root.ok {
        walk_index_parts(ck, b, t);
        b.tick += 1;
        if b.phase == 1 {
            mark_use(b, root.loc, t.span);
            b_decl_default(b, root.loc, b.tick);
            return e;
        }
        b_access(ck, b, root.loc, &root.path, "write", t.span);
        if carried.len > 0 && b_holds_ptr(ck, ck.locals.at(root.loc).ty) { holds_extend(b, root.loc, &carried); }
        return e;
    }
    let mut ks = b_kids(t);
    for i in 0..ks.len { walk(ck, b, *ks.at(i)); }
    return e;
}

pub fn w_incdec(ck: *Checker, b: *Bck, n: *ast.Node) -> List<Loan> {
    let x = n.node_of("expr");
    let mut root = place_root(ck, x);
    let mut e: List<Loan> = List.new();
    if root.ok {
        walk_index_parts(ck, b, x);
        b.tick += 1;
        if b.phase == 1 {
            mark_use(b, root.loc, x.span);
            b_decl_default(b, root.loc, b.tick);
            return e;
        }
        b_access(ck, b, root.loc, &root.path, "write", x.span);
        return e;
    }
    walk(ck, b, x);
    return e;
}

pub fn w_let(ck: *Checker, b: *Bck, n: *ast.Node) -> List<Loan> {
    let mut carried = (n.has("init") && !n.is_none("init")) ? walk(ck, b, n.node_of("init")) : List.new();
    let mut e: List<Loan> = List.new();
    if n.has("local") && n.get("local").tag == 12 {
        let loc = n.get("local").i;
        if b.phase == 1 {
            b_set_decl(b, loc, b.tick);
            b_last_default(b, loc, b.tick);
        } else if carried.len > 0 && b_holds_ptr(ck, ck.locals.at(loc).ty) { holds_set(b, loc, copy_loans(&carried)); }
    }
    return e;
}

pub fn w_block(ck: *Checker, b: *Bck, n: *ast.Node) -> List<Loan> {
    let start = b.tick;
    let mut owners: List<i64> = List.new();
    for i in 0..n.get("stmts").items.len {
        let st = n.get("stmts").items.at(i).node.at(0);
        walk(ck, b, st);
        if st.kind == "Let" && st.has("local") && st.get("local").tag == 12 { owners.push(st.get("local").i); }
    }
    if b.phase == 2 {
        for oi in 0..owners.len {
            let x = *owners.at(oi);
            for hi in 0..b.h_keys.len {
                let h = *b.h_keys.at(hi);
                if h == x || b_decl0(b, h) > start || !live_after(b, h) { continue; }
                for li in 0..b.h_vals.at(hi).len {
                    let ln = b.h_vals.at(hi).at(li);
                    if ln.owner == x {
                        let xn = String.from(ck.locals.at(x).name);
                        let hn = String.from(ck.locals.at(h).name);
                        if ln.via_own {
                            b_err(ck, b, ln.span, format("pointer into the owned value `{xn}` would outlive it if stored here"),
                                  format("`{xn}` is freed when its scope ends, so this pointer would dangle"), "move the owner out instead, or keep the borrow inside this scope");
                        } else {
                            b_err(ck, b, ln.span, format("`{xn}` does not live long enough"),
                                  format("`{hn}` borrows `{xn}` here but is used after `{xn}` goes out of scope"), "move the owner out instead, or keep the borrow inside this scope");
                        }
                        break;
                    }
                }
            }
        }
    }
    let mut e: List<Loan> = List.new();
    return e;
}

pub fn sum_add(l: *List<SumEnt>, kind: i64, idx: i64) {
    for i in 0..l.len { if l.at(i).kind == kind && l.at(i).idx == idx { return; } }
    l.push(SumEnt { kind: kind, idx: idx });
}

pub fn w_return(ck: *Checker, b: *Bck, n: *ast.Node) -> List<Loan> {
    let mut e: List<Loan> = List.new();
    if !n.has("expr") || n.is_none("expr") { return e; }
    let mut carried = walk(ck, b, n.node_of("expr"));
    if b.phase == 2 {
        for i in 0..carried.len {
            let ln = carried.at(i);
            if ln.owner < 0 { sum_add(&b.summary, ln.kind, -ln.owner - 1); continue; }
            if *b.moved.at(ln.owner) { continue; }
            let on = String.from(ck.locals.at(ln.owner).name);
            if ln.via_own {
                b_err(ck, b, ln.span, format("pointer into the owned value `{on}` cannot be returned"),
                      format("`{on}` is freed when its scope ends, so this pointer would dangle"),
                      "move the owner out instead (return it or store it), or keep a checked `Ref` with `.ref()`");
            } else if ln.closure {
                b_err(ck, b, ln.span, format("this closure borrows the local `{on}` and cannot be returned"),
                      format("`{on}` is destroyed when the function returns, so the closure would dangle"), "write `move |..| ...` to give the closure its own copy");
            } else {
                b_err(ck, b, ln.span, format("cannot return a reference to the local `{on}`"),
                      format("`{on}` is destroyed when the function returns, so this would dangle"), "return the value itself, or allocate it with `alloc` / `own.new`");
            }
            break;
        }
    }
    return e;
}

pub fn b_loop(ck: *Checker, b: *Bck, n: *ast.Node) -> List<Loan> {
    let start = b.tick;
    if n.has("local") && n.get("local").tag == 12 && b.phase == 1 { b_set_decl(b, n.get("local").i, b.tick); }
    let mut ks = b_kids(n);
    for i in 0..ks.len { walk(ck, b, *ks.at(i)); }
    if b.phase == 1 { b.loop_s.push(start + 1); b.loop_e.push(b.tick); }
    let mut e: List<Loan> = List.new();
    return e;
}

pub fn w_closure(ck: *Checker, b: *Bck, n: *ast.Node) -> List<Loan> {
    let mut carried: List<Loan> = List.new();
    let mut none: List<String> = List.new();
    for i in 0..n.get("captures").items.len {
        let pr = n.get("captures").items.at(i);
        let outer = pr.items.at(0).i;
        let proxy = pr.items.at(1).i;
        b.tick += 1;
        if b.phase == 1 {
            mark_use(b, outer, n.span);
            b_decl_default(b, outer, b.tick);
            continue;
        }
        if ck.locals.at(proxy).byref {
            let w = ck.locals.at(proxy).written;
            b_access(ck, b, outer, &none, w ? "excl" : "shared", n.span);
            if !ck.locals.at(outer).captured {
                carried.push(Loan { owner: outer, path: List.new(), excl: w, span: n.span, via_own: false, closure: true, kind: 0 });
            } else { let mut h = holds_get(b, outer); extend_loans(&carried, &h); }
        } else {
            b_access(ck, b, outer, &none, ck.locals.at(outer).glue ? "move" : "read", n.span);
            if ck.locals.at(outer).glue { *b.moved.at(outer) = true; b_touch(b, outer); }
            if b_holds_ptr(ck, ck.locals.at(outer).ty) { let mut h = holds_get(b, outer); extend_loans(&carried, &h); }
        }
    }
    return carried;
}

pub fn sums_equal(a: *List<SumEnt>, c: *List<SumEnt>) -> bool {
    if a.len != c.len { return false; }
    for i in 0..a.len { let mut f = false; for j in 0..c.len { if a.at(i).kind == c.at(j).kind && a.at(i).idx == c.at(j).idx { f = true; } } if !f { return false; } }
    return true;
}

pub fn b_analyze(ck: *Checker, b: *Bck, ei: i64, report: bool) -> List<SumEnt> {
    b.report = report;
    b.summary = List.new();
    b_prepare(ck, b);
    b_reset(b);
    b.addr = 0;
    let sid = ck.bck.at(ei).sym;
    let np = ck.bck.at(ei).params.len;
    b.pnames = List.new();
    for i in 0..np { b.pnames.push(String.from(ck.locals.at(*ck.bck.at(ei).params.at(i)).name)); b_set_decl(b, *ck.bck.at(ei).params.at(i), 0); }
    b.phase = 1;
    b.tick = 0;
    let mut body = &ck.bck.at(ei).body;
    walk(ck, b, body);
    for ti in 0..b.touched.len {
        let loc = *b.touched.at(ti);
        if *b.last.at(loc) < 0 { continue; }
        let uses = *b.last.at(loc);
        for li in 0..b.loop_s.len {
            let s = *b.loop_s.at(li);
            let e = *b.loop_e.at(li);
            if b_decl0(b, loc) < s && s <= uses && uses <= e {
                if e > *b.last.at(loc) { *b.last.at(loc) = e; }
            }
        }
    }
    b.phase = 2;
    b.tick = 0;
    b.h_keys.clear();
    b.h_vals.clear();
    for i in 0..b.touched.len { *b.hix.at(*b.touched.at(i)) = -1; }
    for i in 0..np {
        let p = *ck.bck.at(ei).params.at(i);
        if b_holds_ptr(ck, ck.locals.at(p).ty) {
            let mut l: List<Loan> = List.new();
            l.push(Loan { owner: -(i as i64) - 1, path: List.new(), excl: false, span: ck.locals.at(p).span, via_own: false, closure: false, kind: 1 });
            holds_set(b, p, l);
        }
    }
    walk(ck, b, body);
    let mut out: List<SumEnt> = List.new();
    let own = ck.syms.at(sid).name == "Own.at" && ck.ld.mods.at(ck.syms.at(sid).mod_idx).name == "std.own";
    for i in 0..b.summary.len {
        let k = b.summary.at(i).kind;
        sum_add(&out, (own && k == 2) ? 1 : k, b.summary.at(i).idx);
    }
    return out;
}

pub fn run_borrowck(ck: *Checker) {
    let mut b = Bck { report: false, phase: 1, tick: 0, addr: 0, summary: List.new(), last: List.new(), decl: List.new(), uses: List.new(),
        loop_s: List.new(), loop_e: List.new(), touched: List.new(), tmark: List.new(), hix: List.new(), h_keys: List.new(), h_vals: List.new(),
        moved: List.new(), pnames: List.new() };
    let n = ck.bck.len;
    for i in 0..n { let s = ck.bck.at(i).sym; ck.syms.at(s).summary = List.new(); ck.syms.at(s).has_summary = true; }
    for round in 0..6 {
        let mut changed = false;
        for i in 0..n {
            let s = ck.bck.at(i).sym;
            let mut got = b_analyze(ck, &b, i, false);
            let mut merged = copy_sums(&ck.syms.at(s).summary);
            for q in 0..got.len { sum_add(&merged, got.at(q).kind, got.at(q).idx); }
            if !sums_equal(&merged, &ck.syms.at(s).summary) { ck.syms.at(s).summary = merged; changed = true; }
        }
        if !changed { break; }
    }
    for i in 0..n {
        ck.d.context = String.from(ck.bck.at(i).context);
        b_analyze(ck, &b, i, true);
    }
    ck.d.context = String.empty();
}

pub fn copy_sums(l: *List<SumEnt>) -> List<SumEnt> {
    let mut o: List<SumEnt> = List.new();
    for i in 0..l.len { o.push(SumEnt { kind: l.at(i).kind, idx: l.at(i).idx }); }
    return o;
}
