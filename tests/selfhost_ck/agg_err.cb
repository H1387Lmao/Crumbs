struct P { x: i64, y: i64 }
struct Op;
impl P {
    fn sum(self) -> i64 { return self.x; }
    fn bump(mut self) { self.x += 1; }
    fn make() -> P { return P { x: 1, y: 2 }; }
}
fn takes_const(p: *const P) { p.bump(); }
fn main() {
    let a = P { x: 1 };
