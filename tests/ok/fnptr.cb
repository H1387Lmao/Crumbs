// Function pointers: values, struct fields, tables, null, *void round trips.
struct Ops { name: str, apply: fn(i32, i32) -> i32, on_done: fn(i32) }

fn add(a: i32, b: i32) -> i32 { return a + b; }
fn mul(a: i32, b: i32) -> i32 { return a * b; }
fn report(x: i32) { println("done: ", x); }

fn run(f: fn(i32, i32) -> i32, a: i32, b: i32) -> i32 { return f(a, b); }

fn pick(flag: bool) -> fn(i32, i32) -> i32 {
    if flag { return add; }
    return mul;
}

fn main() {
    let mut ops = Ops { name: "add", apply: add, on_done: report };
    let r = ops.apply(3, 4);
    ops.on_done(r);
    println(run(mul, 6, 7));
    let table = [add, mul, add];
    for i in 0..table.len { println(table[i](i as i32 + 2, 10)); }
    let mut f = pick(false);
    println(f(5, 5));
    f = add;
    println(f(5, 5));
    println(f == add);
    let p = &ops;
    println(p.apply(1, 1));
    let none: fn(i32) = null;
    println(none == null);
    let raw = add as *void;
    let back = raw as fn(i32, i32) -> i32;
    println(back(20, 22));
}
