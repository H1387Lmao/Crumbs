// Format strings, the way Rust does them: println("text {} {name} {0} {:>8.2}", a, b, name = c).
// `{}` takes the next argument, `{0}` a numbered one, `{name}` a named argument or else the variable of that name.
// The format after the colon is [[fill]align][sign][#][0][width][,|_][.precision][type].
import std.time;

struct Point { x: i32, y: i32 }
enum Color { Red, Green }
enum Mode { Fast, Slow }
struct Shape { corner: Point, label: str, sides: [2]i32, color: Color, solid: bool, weight: f64 }
struct Pair<T> { a: T, b: T }

// your own representation: implement Display
impl Display for Point {
    fn to_string(self) -> String { return format("({}, {})", self.x, self.y); }
}
impl Display for Color {
    fn to_string(self) -> String {
        if *self == Color.Red { return string_from("red!"); }
        return string_from("green!");
    }
}

fn show<T: Display>(v: T) -> String { return format("<{v}>"); }

fn main() {
    let name = "world";
    let n = 255;
    let pi = 3.14159265;
    println("hello {name}! {} {{braces}}", 1 + 2 * 3);
    println("{} + {} = {}", 1, 2, 1 + 2);
    println("{0} {1} {0} {who} {}", n, name, who = "named");

    // integers
    println("{n:x} {n:X} {n:#x} {n:#b} {n:o} {n:#o} {n:08b} {:c}", 65);
    println("[{n:>6}] [{n:<6}] [{n:^6}] [{n:*^7}] [{n:+}] [{m:06}] [{n:+06}] [{n: }]", m = -n);
    println("{:,} {:,} {:#_x} {:_}", 1234567, -1234567, 0xdeadbeefu32, 1000000000000i64);

    // floats
    println("{pi} {pi:.2} {pi:10.3} {pi:<10.1}| {pi:e} {pi:.3e} {:g} {:08.2}", 1500000.0, 0.5);
    println("{:,.2} {:+.1} {n:.1f} {}", 1234567.891, -0.5, 2.0);

    // text and bool
    println("[{name:>8}] [{name:<8}] [{name:^9}] [{name:.3}] [{name:?}] [{}] [{:>7}]", true, false);
    println("{:>7}|{:.2}|", "héllo", "héllo");

    // enums
    println("{:d} {} {:>6}", Mode.Slow, Mode.Fast, Mode.Slow);

    // your own types
    let p = Point { x: 3, y: -4 };
    println(p);
    println("p = {p}, padded [{p:>10}] [{p:*<10}]");
    println("{} / {:?}", Color.Green, Color.Green);
    println("{}{}{}", show(p), show(Color.Red), show(42));
    let text = to_str(p);
    println(text, " has ", to_str(p).len, " bytes");
    println("fields {p.x} and {p.y}");

    // the automatic representation
    let s = Shape { corner: p, label: "a \"quoted\"\tlabel", sides: [1, 2], color: Color.Green, solid: true, weight: 0.5 };
    println("{s:?}");
    println("{p:?} {:?} {name:?} {n:?} {pi:?}", [1, 2, 3]);
    println("{:?}", Pair { a: 1, b: 2 });
    println("[{p:>30?}]");

    // expressions go in the argument list
    let words = ["a", "b"];
    println("{} {} {:>5} {name} {}", words[1], words.len, n * 2 - 1, to_str(n + 1));
    println("{} and {:>10}", format("nested {n:x}"), format("{name:?}"));
    println("{} {}", time.Duration.from_ms(1500), time.Duration.from_secs(125));

    // building strings
    let mut out = string_new();
    for i in 0..3 { out += format("{i:02},"); }
    println(out);
    println(format("done {}", out.len));
    println("{{}}");
}
