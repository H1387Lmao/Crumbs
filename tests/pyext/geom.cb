// geom.cb: a Crumbs module compiled to a Python extension:  crumbs pyext examples/python/geom.cb
// then, from Python:  import geom; geom.dist(Point...)
import std.math;

pub const VERSION: str = "0.1";
pub const MAX_ITEMS: i64 = 1000;

pub struct Point { x: f64, y: f64 }
pub struct Named { name: String, at: Point, tags: List<String> }
pub enum Shape { Circle, Square, Triangle }
error TooBig;
error Negative;

pub fn add(a: i64, b: i64) -> i64 { return a + b; }
pub fn hypot(p: Point) -> f64 { return math.sqrt(p.x * p.x + p.y * p.y); }
pub fn midpoint(a: Point, b: Point) -> Point { return Point { x: (a.x + b.x) / 2.0, y: (a.y + b.y) / 2.0 }; }
pub fn greet(name: str, excited: bool = false) -> String {
    let mut s = String.from("hello, ");
    s.append(name);
    if excited { s.push('!'); }
    return s;
}
pub fn describe(n: Named) -> String {
    let mut s = String.empty();
    s.append(n.name);
    s.append(format(" at ({n.at.x}, {n.at.y}) with {n.tags.len} tags"));
    return s;
}
pub fn squares(n: i64) -> List<i64> {
    let mut l: List<i64> = List.new();
    for i in 0..n { l.push(i * i); }
    return l;
}
pub fn total(xs: List<i64>) -> i64 {
    let mut t = 0 as i64;
    for i in 0..xs.len { t += xs.get(i); }
    return t;
}
pub fn words(s: str) -> List<String> {
    let mut out: List<String> = List.new();
    for w in s.split(" ") { if w.len > 0 { out.push(String.from(*w)); } }
    return out;
}
pub fn first_even(xs: List<i64>) -> i64? {
    for i in 0..xs.len { if xs.get(i) % 2 == 0 { return xs.get(i); } }
    return null;
}
pub fn checked_sqrt_floor(n: i64) -> i64! {
    if n < 0 { throw Negative; }
    if n > MAX_ITEMS * MAX_ITEMS { throw TooBig; }
    let mut r = 0 as i64;
    while (r + 1) * (r + 1) <= n { r += 1; }
    return r;
}
pub fn corners() -> [4]Point {
    return [Point { x: 0.0, y: 0.0 }, Point { x: 1.0, y: 0.0 }, Point { x: 1.0, y: 1.0 }, Point { x: 0.0, y: 1.0 }];
}
pub fn sides(s: Shape) -> i64 {
    if s == Shape.Triangle { return 3; }
    if s == Shape.Square { return 4; }
    return 0;
}
pub fn at(xs: List<i64>, i: i64) -> i64 { return xs.get(i); }     // panics when out of range: Python sees geom.Panic
pub fn fill(n: i64) -> void { }
pub fn take_ptr(p: *i64) -> i64 { return *p; }                       // not exposed: pointers have no Python form
