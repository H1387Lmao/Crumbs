// Format string errors: bad specs, values without a text representation, wrong argument lists.
struct P { x: i32 }
struct Q { x: i32 }
impl Display for Q { } // ERROR: not all required methods of `Display`
fn main() {
    let p = P { x: 1 };
    let n = 5;
    println("{p}"); // ERROR: cannot interpolate a value of type `P`
    println(p); // ERROR: cannot print a value of type `P`
    println("{n:q}"); // ERROR: unexpected `q` in the format spec
    println("{n:.2}"); // ERROR: a precision does not apply to integers
    println("{n:,x}"); // ERROR: `,` grouping only applies to decimal numbers
    println("{:+}", "a"); // ERROR: a sign flag only applies to numbers
    println("{n:#}"); // ERROR: the `#` flag only applies to the types x, X, b and o
    println("{} {}", n); // ERROR: the format string uses argument 1 but only 1 was given
    println("{}", n, n); // ERROR: this argument is never used by the format string
    println("{x}", x = 1, y = 2); // ERROR: the argument `y` is never used
    println("{nope}"); // ERROR: cannot find
    println("{} {0}", n + 1); // ERROR: an argument used more than once must be a simple value
    let s = format(n); // ERROR: the first argument of `format` must be a string literal
}
